// ========================================
// FACULTY GRUNTS - Mining Operation
// ========================================

script LionsarchCity_FacultyGrunt_1 {
    lockall
    msgbox(format("...if this ore shipment is late again the whole schedule slips... phase two can't start without it..."), MSGBOX_AUTOCLOSE)
    waitmessage
    delay(20)
    playse(SE_PIN)
    faceplayer
    applymovement(15, moves(emote_exclamation_mark))
    msgbox(format("Hey - HEY! Who are you?!\pThis is a RESTRICTED Faculty dock! How did you even get in here?!\pLeave. NOW."), MSGBOX_AUTOCLOSE)
    waitmessage
    releaseall
}

script LionsarchCity_FacultyGrunt_2 {
    lockall
    msgbox(format("...processing units load first, shielding on top... boss needs it all at the plant by Thursday..."), MSGBOX_AUTOCLOSE)
    waitmessage
    delay(20)
    playse(SE_PIN)
    faceplayer
    applymovement(16, moves(emote_exclamation_mark))
    msgbox(format("Wh- a KID?! On our dock?!\pDon't touch ANYTHING! These crates need to reach the ship by nightfall!\pGet OUT of here, right now!"), MSGBOX_AUTOCLOSE)
    waitmessage
    releaseall
}

script LionsarchCity_FacultyGrunt_3 {
    lockall
    msgbox(format("...they keep saying the steel can block it... block what exactly... I just load the ships..."), MSGBOX_AUTOCLOSE)
    waitmessage
    delay(20)
    playse(SE_PIN)
    faceplayer
    applymovement(13, moves(emote_exclamation_mark))
    msgbox(format("You've got some NERVE showing up here!\pThis is Faculty property - no civilians, no visitors, NOTHING!\pTake a hike before you see something you'll regret!"))
    waitmessage
    releaseall
}

script LionsarchCity_FacultyGrunt_4 {
    lockall
    msgbox(format("...dampening alloy, check... containment frames, check... boss is gonna love this batch..."), MSGBOX_AUTOCLOSE)
    waitmessage
    delay(20)
    playse(SE_PIN)
    faceplayer
    applymovement(14, moves(emote_exclamation_mark))
    msgbox(format("What in the - get OUT! Right NOW!\pThis dock is authorized Faculty personnel only!\pYou better not have seen anything - scram!"), MSGBOX_AUTOCLOSE)
    waitmessage
    releaseall
}

script LionsarchCity_FacultyWorker_Suspicious {
    lockall
    faceplayer
    msgbox(format("HALT! Don't you DARE take another step!\pThis is the Faculty Steel Plant entrance - there's a MACHAMP right here and I will use it!\pYou have NO idea where you've walked into.\pTurn around and forget you ever saw this place. NOW."), MSGBOX_AUTOCLOSE)
    releaseall
}

