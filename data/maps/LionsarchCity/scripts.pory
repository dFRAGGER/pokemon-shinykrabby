script LionsarchCity_Sign_Route06 {
    lockall
    msgbox(format("{UP_ARROW} Upana Cave System\nPath to Marshduke City\pBeware of falling Geodudes!"))
    releaseall
}

script LionsarchCity_Sign_CityName {
    lockall
    msgbox(format("LIONSARCH CITY\nGateway to the Northern Peaks\pWhere the harbor meets the mountains"))
    releaseall
}

