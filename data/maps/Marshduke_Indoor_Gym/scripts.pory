mapscripts Marshduke_Indoor_Gym_MapScripts {}

// These NPCs use Tessera-owned trainer ids. Their dialogue is intentionally
// retained from the inherited Mossdeep gym until Marshduke-specific copy is
// written, but the battle scripts and parties no longer belong to Emerald.
script Marshduke_Indoor_Gym_EventScript_Preston {
    trainerbattle_single(TRAINER_PRESTON_SK, MossdeepCity_Gym_Text_PrestonIntro, MossdeepCity_Gym_Text_PrestonDefeat)
    msgbox(MossdeepCity_Gym_Text_PrestonPostBattle, MSGBOX_AUTOCLOSE)
    end
}

