Marshduke_Indoor_Garden_House1_MapScripts::
	.byte 0


Marshduke_Indoor_Garden_House1_EventScript_Gardener::
	lock
	faceplayer
	msgbox Marshduke_Indoor_Garden_House1_EventScript_Gardener_Text_0
	waitmessage
	release
	end


Marshduke_Indoor_Garden_House1_EventScript_Gardener_Text_0:
	.string "Ah, a visitor. My name is Paul, the\n"
	.string "gardener here.\p"
	.string "Most botanical gardens are filled with\n"
	.string "plants from faraway lands. I think\l"
	.string "that's a mistake.\p"
	.string "Exotic flowers are pretty, but they\n"
	.string "don't feed much of anything around\l"
	.string "here.\p"
	.string "Native plants grew up alongside the Bug\n"
	.string "Pokémon and birds of this delta.\p"
	.string "Plant what belongs here, and life finds\n"
	.string "its way back.\p"
	.string "The gardener before me sprayed\n"
	.string "everything. He meant well, but the soil\l"
	.string "went quiet.\p"
	.string "Now I'm healing what he left behind.\n"
	.string "Compost, fallen leaves, and letting the\l"
	.string "roots be.\p"
	.string "One day this will be a wild place again.\n"
	.string "Wild, but peaceful.$"
