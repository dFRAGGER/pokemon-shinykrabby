const LOCALID_ATTENDANT = 1

mapscripts TrainerHill_Elevator_SK_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_4, 0: TrainerHill_Elevator_SK_EventScript_EnterElevator
    ]
}

script TrainerHill_Elevator_SK_EventScript_Attendant {
    end
}

script TrainerHill_Elevator_SK_EventScript_ExitToRoof {
    applymovement(OBJ_EVENT_ID_PLAYER, TrainerHill_Elevator_SK_Movement_PlayerExitElevatorToRoof)
    waitmovement(0)
    releaseall
    warp(MAP_TRAINER_HILL_ROOF_SK, 15, 5)
    waitstate
    end
}

script TrainerHill_Elevator_SK_EventScript_EnterElevator {
    applymovement(OBJ_EVENT_ID_PLAYER, TrainerHill_Elevator_SK_Movement_PlayerApproachAttendant)
    waitmovement(0)
    applymovement(LOCALID_ATTENDANT, TrainerHill_Elevator_SK_Movement_AttendantFacePlayer)
    waitmovement(0)
    lockall
    msgbox(TrainerHill_Elevator_SK_Text_ReturnToReception, MSGBOX_YESNO)
    goto_if_eq(VAR_RESULT, NO, TrainerHill_Elevator_SK_EventScript_ExitToRoof)
    releaseall
    applymovement(LOCALID_ATTENDANT, TrainerHill_Elevator_SK_Movement_AttendantFaceDown)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, TrainerHill_Elevator_SK_Movement_PlayerMoveToCenterOfElevator)
    waitmovement(0)
    call(TrainerHill_Elevator_SK_EventScript_MoveElevator)
    delay(25)
    applymovement(OBJ_EVENT_ID_PLAYER, TrainerHill_Elevator_SK_Movement_PlayerExitElevator)
    waitmovement(0)
    warp(MAP_TRAINER_HILL_ENTRANCE_SK, 17, 8)
    waitstate
    end
}

script TrainerHill_Elevator_SK_EventScript_MoveElevator {
    waitse
    special(MoveElevator)
    waitstate
    return
}

movement TrainerHill_Elevator_SK_Movement_PlayerMoveToCenterOfElevator {
    walk_up
    walk_up
    walk_right
    face_down
}

movement TrainerHill_Elevator_SK_Movement_PlayerApproachAttendant {
    delay_16
    walk_left
}

movement TrainerHill_Elevator_SK_Movement_PlayerExitElevator {
    delay_16
    walk_down
    walk_down
}

movement TrainerHill_Elevator_SK_Movement_PlayerExitElevatorToRoof {
    face_down
    delay_16
}

movement TrainerHill_Elevator_SK_Movement_AttendantFacePlayer {
    face_right
}

movement TrainerHill_Elevator_SK_Movement_AttendantFaceDown {
    face_down
}

text TrainerHill_Elevator_SK_Text_ReturnToReception {
    "Would you like to return to\nthe reception counter?"
}
