mapscripts BikePark_MapScripts {}

script BikePark_BikeCheck {
    lockall
    specialvar(VAR_RESULT, GetPlayerAvatarBike)
    if (var(VAR_RESULT) == 0) {
        goto(BikePark_BikeCheck_NoBike)
    }
    setflag(FLAG_SYS_CYCLING_ROAD)
    setvar(VAR_TEMP_0, 1)
    releaseall
    end
}

script BikePark_BikeCheck_NoBike {
    playse(SE_PIN)
    applymovement(17, moves(emote_exclamation_mark))
    msgbox(format("Whoa! This is a designated cycling route.\pFor the safety of everyone on the ridge, you cannot proceed on foot.\pPlease get on your bike first."), MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(LOCALID_PLAYER, moves(walk_left))
    waitmovement
    releaseall
    end
}

script BikePark_ClearCyclingRoad {
    lockall
    clearflag(FLAG_SYS_CYCLING_ROAD)
    setvar(VAR_TEMP_0, 0)
    releaseall
    end
}

script BikePark_EventScript_SteepDownhillSign {
    lock
    faceplayer
    msgbox(format("!!{DOWN_ARROW} DANGER!!\pOnly enter downhill with proper bike and experience required.\pVery steep."), MSGBOX_DEFAULT)
    release
    end
}

script BikePark_EventScript_BikeShopSign {
    lock
    faceplayer
    msgbox(format("Mr. Kasmi's Bikeshop"), MSGBOX_SIGN)
    release
    end
}

script BikePark_Npc_LegendWatcher {
    lock
    faceplayer
    msgbox(format("You know, there's a story about a rider who trained on this exact ridge.\pRed hair. Couldn't miss him.\pThree hours a day, five days a week, for six years straight."))
    waitmessage
    msgbox(format("Six years.\pI did the math once.\pThat's over four thousand hours on a bike going downhill.\pOn this hill."))
    waitmessage
    msgbox(format("Last I heard he still travels.\pNot on a bike anymore though.\pSome beat-up campervan.\pOccasionally turns up in his hometown.\pApparently it only has one house."))
    waitmessage
    msgbox(format("...One house.\p...Four thousand hours on a bike.\p...I'm starting to think the riding didn't make him great.\pI'm starting to think it made him a little insane."), MSGBOX_AUTOCLOSE)
    waitmessage
    release
    end
}

script BikePark_Npc_BikerKai {
    lock
    faceplayer
    setspeaker("Biker Kai")
    msgbox(format("Fastest on this ridge? That would be me.\pFinn tried to argue it last week.\pHe stopped halfway down to adjust his gloves.\pCase closed."))
    waitmessage
    release
    end
}

script BikePark_Npc_BikerFinn {
    lock
    faceplayer
    setspeaker("Biker Finn")
    msgbox(format("Don't let Kai tell you anything.\pHe brakes before every bend. I've clocked it.\pFastest downhill is whoever doesn't touch the brakes.\pThat's me."))
    waitmessage
    release
    end
}

script BikePark_Npc_BikerRox {
    lock
    faceplayer
    setspeaker("Biker Rox")
    msgbox(format("Those two have been at this for a week.\pNeither of them has actually raced the other yet.\pI offered to time it. They both made excuses.\p...Fastest on this ridge is whoever's willing to actually go."))
    waitmessage
    release
    end
}

script BikePark_Npc_BikeWatcher {
    lock
    faceplayer
    msgbox(format("These bikes have been parked here a while...\pThe red one looks quick but the brakes are worn.\pThe blue one has better geometry but the saddle's too low.\pThe yellow one in the back...\p...actually, I think that one might be stolen.\pI'll keep watching."), MSGBOX_AUTOCLOSE)
    waitmessage
    release
    end
}

script BikePark_Npc_RidgeRanger {
    lock
    faceplayer
    setspeaker("Ranger Tove")
    msgbox(format("Three years I've been watching this ridge.\pGulliot, Taillow, Wingull - same crowd every season.\pBut last month I spotted something on the southern outcrop.\pOrange. Small. Left a scorch mark on the rock when it took off."))
    waitmessage
    msgbox(format("Haven't seen it since.\pI'm not writing it in the report yet."), MSGBOX_AUTOCLOSE)
    waitmessage
    release
    end
}

script BikePark_Npc_Milo {
    lock
    faceplayer
    setspeaker("Milo")
    msgbox(format("That drop right there? I've been meaning to ride it all week.\pJust waiting on the right gear. Wrong tires for that grade. Wrong suspension too, honestly."), MSGBOX_AUTOCLOSE)
    waitmessage
    release
    end
}

script BikePark_Trainer_Skye {
    trainerbattle_single(TRAINER_BIKER_FRLG_SKYE, BikePark_Text_SkyeIntro, BikePark_Text_SkyeDefeated)
    msgbox(BikePark_Text_SkyePostBattle, MSGBOX_AUTOCLOSE)
    end
}

text BikePark_Text_SkyeIntro {
    format("Every time I ride down here a whole flock joins me! Try and keep up!")
}

text BikePark_Text_SkyeDefeated {
    format("They flew ahead before the finish line...")
}

text BikePark_Text_SkyePostBattle {
    format("This ridge belongs to the birds. No predator can reach them up here.\pThey own the airspace.")
}

