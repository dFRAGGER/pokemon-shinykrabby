mapscripts Marshduke_Indoor_House2_MapScripts {}

// Move Relearner / Move Deleter couple. Flow mirrors HNS's
// BlackthornCity_House3_hns (Heart Scale relearner + move deleter).

script Marshduke_Indoor_House2_EventScript_MoveRelearner {
    lock
    faceplayer
    specialvar(VAR_RESULT, IsRandomMovesActivated)
    if (var(VAR_RESULT) == TRUE) {
        msgbox(format("Sorry, I can't help you."))
        release
        end
    }
    if (!flag(FLAG_TEMP_1)) {
        msgbox(format("Everyone in Marshduke is busy remembering the past. I help Pokémon remember what they once knew.\pA move they forgot can always be found again. It's still in there somewhere.\pMy wife does the opposite, mind you. Between the two of us, nothing is ever truly lost or stuck.\pI'll help your Pokémon remember a move for one Heart Scale."))
        setflag(FLAG_TEMP_1)
    }
    goto(Marshduke_Indoor_House2_EventScript_MoveRelearnerAsk)
}

script Marshduke_Indoor_House2_EventScript_MoveRelearnerAsk {
    checkitem(ITEM_HEART_SCALE)
    if (var(VAR_RESULT) == FALSE) {
        goto(Marshduke_Indoor_House2_EventScript_MoveRelearnerComeBack)
    }
    msgbox(format("Ah, a Heart Scale! Shall I help one of your Pokémon remember a move?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        goto(Marshduke_Indoor_House2_EventScript_MoveRelearnerComeBack)
    }
    goto(Marshduke_Indoor_House2_EventScript_MoveRelearnerChooseMon)
}

script Marshduke_Indoor_House2_EventScript_MoveRelearnerChooseMon {
    msgbox(format("Which Pokémon should remember a move?"))
    setmoverelearnerstate(MOVE_RELEARNER_LEVEL_UP_MOVES)
    chooseboxmon(SELECT_PC_MON_MOVE_RELEARNER)
    waitstate
    if (var(VAR_0x8004) == PARTY_NOTHING_CHOSEN) {
        goto(Marshduke_Indoor_House2_EventScript_MoveRelearnerComeBack)
    }
    special(IsSelectedMonEgg)
    if (var(VAR_RESULT) == TRUE) {
        msgbox(format("An Egg? It hasn't lived long enough to have anything to remember."))
        goto(Marshduke_Indoor_House2_EventScript_MoveRelearnerChooseMon)
    }
    special(HasMovesToRelearn)
    if (var(VAR_RESULT) == FALSE) {
        msgbox(format("Hmm... There's nothing this Pokémon has forgotten that I can bring back."))
        goto(Marshduke_Indoor_House2_EventScript_MoveRelearnerChooseMon)
    }
    msgbox(format("Which move should it remember?"))
    special(TeachMoveRelearnerMove)
    waitstate
    if (var(VAR_0x8004) == 0) {
        goto(Marshduke_Indoor_House2_EventScript_MoveRelearnerChooseMon)
    }
    msgbox(format("{PLAYER} handed over one Heart Scale in exchange."))
    removeitem(ITEM_HEART_SCALE)
    goto(Marshduke_Indoor_House2_EventScript_MoveRelearnerComeBack)
}

script Marshduke_Indoor_House2_EventScript_MoveRelearnerComeBack {
    msgbox(format("If your Pokémon ever need to remember a move, come back with a Heart Scale."))
    closemessage
    release
    end
}

script Marshduke_Indoor_House2_EventScript_MoveDeleter {
    lock
    faceplayer
    msgbox(format("A whole city that can't stop remembering... it's making me crazy.\pHow about we start to forget some things?\pI can help your Pokémon to let go of moves they no longer need.\pShall I make one of your Pokémon forget a move?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        goto(Marshduke_Indoor_House2_EventScript_MoveDeleterComeAgain)
    }
    goto(Marshduke_Indoor_House2_EventScript_MoveDeleterChooseMon)
}

script Marshduke_Indoor_House2_EventScript_MoveDeleterChooseMon {
    msgbox(format("Which Pokémon should forget a move?"))
    special(ChoosePartyMon)
    waitstate
    if (var(VAR_0x8004) == PARTY_NOTHING_CHOSEN) {
        goto(Marshduke_Indoor_House2_EventScript_MoveDeleterComeAgain)
    }
    special(IsSelectedMonEgg)
    if (var(VAR_RESULT) == TRUE) {
        msgbox(format("An Egg doesn't know any moves yet. There's nothing to let go of."))
        release
        end
    }
    special(GetNumMovesSelectedMonHas)
    if (var(VAR_RESULT) == 1) {
        special(BufferMoveDeleterNicknameAndMove)
        msgbox(format("{STR_VAR_1} only knows one move. I can't take that away from it."))
        release
        end
    }
    msgbox(format("Which move should be forgotten?"))
    fadescreen(FADE_TO_BLACK)
    special(MoveDeleterChooseMoveToForget)
    fadescreen(FADE_FROM_BLACK)
    if (var(VAR_0x8005) == MAX_MON_MOVES) {
        goto(Marshduke_Indoor_House2_EventScript_MoveDeleterChooseMon)
    }
    special(BufferMoveDeleterNicknameAndMove)
    msgbox(format("{STR_VAR_1}'s {STR_VAR_2}? You're sure it should forget that?"), MSGBOX_YESNO)
    if (var(VAR_RESULT) == NO) {
        goto(Marshduke_Indoor_House2_EventScript_MoveDeleterComeAgain)
    }
    special(IsLastMonThatKnowsSurf)
    if (var(VAR_RESULT) == TRUE) {
        special(BufferMoveDeleterNicknameAndMove)
        msgbox(format("Hm... Your {STR_VAR_1} doesn't seem willing to forget Surf."))
        release
        end
    }
    special(MoveDeleterForgetMove)
    playfanfare(MUS_MOVE_DELETED)
    waitfanfare
    msgbox(format("There. {STR_VAR_1} has let go of {STR_VAR_2} completely.\pDon't worry. If it ever wants it back, my husband knows the way."))
    release
    end
}

script Marshduke_Indoor_House2_EventScript_MoveDeleterComeAgain {
    msgbox(format("Come back whenever your Pokémon are carrying moves they no longer need."))
    release
    end
}
