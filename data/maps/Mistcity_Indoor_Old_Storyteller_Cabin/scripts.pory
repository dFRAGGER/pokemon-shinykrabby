mapscripts Mistcity_Indoor_Old_Storyteller_Cabin_MapScripts {}

script Mistcity_Indoor_Old_Storyteller_Elara {
    lock
    faceplayer
    if(!flag(FLAG_HELPED_DAN_BEAT_FACULTY)){
    msgbox(format("Come in, come in, child. Don't mind the old books.\p My name is {COLOR GREEN}Elara{COLOR DARK_GRAY}.\p My family has watched over this forest for more generations than I can count.\pLately, something is wrong, I can feel it in my old bones.\p These new people, The Faculty... they move without respect.\p They see the trees, but they do not see the forest.\pThey do not know the legends.\p They do not know of the Silent Guardian that sleeps beneath our feet.\p An ancient being of steel, said to awaken only when the forest's chaotic harmony is threatened...\pThat brave young man, Dan, he understands.\p He feels the forest's heartbeat. I pray you have a similar spirit."))
    waitmessage
    release
    end
    }
    if(flag(FLAG_HELPED_DAN_BEAT_FACULTY) && !flag(FLAG_ITEM_TM23_IRON_TAIL)){
        msgbox(format("{COLOR GREEN}Elara{COLOR DARK_GRAY}: You! You are the one who stood with Daan!\p I knew there was a kind heart in you.\p The forest breathes a sigh of relief, and so do I.\p Thank you.\pYou have proven yourself a true friend of the forest.\pThe legend of the Silent Guardian is not just a story, you see.\pHere, have this:"))
        waitmessage
        playfanfare(MUS_OBTAIN_ITEM)
        giveitem(ITEM_TM23)
        msgbox(format("My ancestors found this long ago, deep within a grove.\pThey said it hummed with the Guardian's energy.\pI want you to have it.\pMay it protect you as you have protected us."))
        waitmessage
        setflag(FLAG_ITEM_TM23_IRON_TAIL)
        release
        end
        
    }
    if(flag(FLAG_HELPED_DAN_BEAT_FACULTY) && flag(FLAG_ITEM_TM23_IRON_TAIL)){
        msgbox(format("{COLOR GREEN}Elara{COLOR DARK_GRAY}: Thanks for restoring the balance of the forest.\p Remember...\pLegends are not always just stories."))
        waitmessage
        release
        end
    }
}