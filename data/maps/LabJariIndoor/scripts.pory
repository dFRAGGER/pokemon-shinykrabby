script LabJariIndoor_Eventscript_Birds_Pokemon_Check {
    lockall
    setspeaker("Prof. Birds")
    msgbox(format("...WHY ARE YOU STILL HERE? BETTER GET TO THAT SCRUB OF A FRIEND CALLED {COLOR GREEN}Jacob{COLOR DARK_GRAY} IN THE {COLOR RED}Mestreech{COLOR DARK_GRAY}! HE PROBABLY KNOWS HOW TO CATCH SOME POKEMON!"))
    waitmessage
    releaseall
}

script LabJariIndoor_Eventscript_Barry_Birds {
    lock
    if(flag(FLAG_INTERN_BOXES_ASSIGNMENT)==FALSE){
    getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
    delay(10)
    playse(SE_PIN)
    applymovement(3, moves(face_down emote_exclamation_mark))
    delay(30)
    playse(SE_PIN)
    applymovement(2, moves(face_down emote_question_mark))
    waitmovement
    if(var(VAR_TEMP_0)== 3 && var(VAR_TEMP_1)== 14) {
        applymovement(3, moves(walk_down*2))
        applymovement(LOCALID_PLAYER, moves(face_up))
    }
    if(var(VAR_TEMP_0)== 4 && var(VAR_TEMP_1)== 13) {
        applymovement(3, moves(walk_right walk_down))
    }
    if(var(VAR_TEMP_0)== 5 && var(VAR_TEMP_1)== 13) {
        applymovement(3, moves(walk_right*2 walk_down))
    }
    if(var(VAR_TEMP_0)== 6 && var(VAR_TEMP_1)== 14) {
        applymovement(3, moves(walk_right*3 walk_down*2))
        applymovement(LOCALID_PLAYER, moves(face_up))
    }
    waitmovement
    setspeaker("Prof. Birds")
    msgbox(format("SO WHO ARE YOU?\p ...\pYou want to become my intern?\p WELL TOO LATE BOY!!\p BARRY WAS HERE FIRST!!\p ISN'T THAT RIGHT BARRY?"),MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(3, moves(face_left))
    playse(SE_PIN)
    applymovement(2, moves(emote_question_mark))
    waitmovement
    setspeaker("Barry")
    msgbox(format("Uhmm...\nwait a second...\pI'm just...\n...an intern???\pBut what about...\n...my salary?"),MSGBOX_AUTOCLOSE)
    waitmessage
    setspeaker("Prof. Birds")
    msgbox(format("YES BARRY, YOU ARE MY INTERN\p ...NO, I'M NOT PAYING YOU A FULL SALARY\p...NO, THE GOVERNMENT SUBSIDIES AREN'T ENOUGH!"),MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(3, moves(face_down))
    delay(40)
    applymovement(3, moves(face_left))
    delay(40)
    applymovement(3, moves(face_down))
    delay(40)
    applymovement(3, moves(face_left))
    delay(40)
    applymovement(3, moves(face_down))
    delay(60)
    playse(SE_PIN)
    applymovement(3, moves(emote_exclamation_mark))
    waitmovement
    setspeaker("Prof. Birds")
    msgbox(format("....wait a second....\p...I just looked at the new subsidies and...\pOUR BUDGET STILL ALLOWS AN EXTRA INTERN!!\pYOU ARE HIRED!!\p...SALARY?? AT THE END OF THE MONTH OFCOURSE...\pMAYBE...\pWHO KNOWS!!"))
    release
    waitmessage
    playse(SE_PIN)
    applymovement(2,moves(emote_exclamation_mark))
    waitmovement
    setspeaker("Barry")
    msgbox(format("What the..."))
    waitmessage
    applymovement(3, moves(face_left))
    setspeaker("Prof. Birds")
    msgbox(format("DON'T COMPLAIN BARRY!!\pSHUT U....I MEAN WE WILL TALK ABOUT THIS LATER!"))
    waitmessage
    applymovement(3, moves(face_down))
    setspeaker("Prof. Birds")
    msgbox(format("And you are... {PLAYER}??\p...and {PLAYER} is interested in Pokémon??\p WELL, GET IN LINE! HAHAHA.\p MY NAME IS PROFESSOR BIRDS!\p I RESEARCH POKEMON FOR A LIVING!!\pBESIDES THAT, I ALSO DEVELOP SECRET TECHNOL... I mean sensors for pig farms.\p...so you want to become a Pokémon Master?\p...HAHAHAH, YOU!!?\nA POKEMON MASTER???\p YOUR FIRST TASK AS AN INTERN IS TO GET SOME BOXES OUT OF MY STORAGE ROOM.\pEVERYBODY WHO WANTS TO BECOME A POKEMON MASTER HAS TO START SOMEWHERE!!\pHAHAHAHAH!!\pI warn you, do not sniff around in my storage room...\p...OR I'LL FIRE YOU IMMEDIATELY!\pHAHAHHAHA... HAHAH... HAHA... HA... haha..."),MSGBOX_AUTOCLOSE)
    waitmessage
    if(var(VAR_TEMP_0)== 3 && var(VAR_TEMP_1)== 14) {
        applymovement(3, moves(walk_up*2))
    }
    if(var(VAR_TEMP_0)== 4 && var(VAR_TEMP_1)== 13) {
        applymovement(3, moves(walk_up walk_left face_up))
    }
    if(var(VAR_TEMP_0)== 5 && var(VAR_TEMP_1)== 13) {
        applymovement(3, moves(walk_up walk_left*2 face_up))
    }
    if(var(VAR_TEMP_0)== 6 && var(VAR_TEMP_1)== 14) {
        applymovement(3, moves(walk_up*2 walk_left*3 face_up))
    }
    applymovement(2, moves(face_up))
    waitmovement
    delay(120)
    applymovement(3, moves(face_down))
    waitmovement
    setspeaker("Prof. Birds")
    msgbox(format("THE BOXES ARE IN THE BACK YOU IDIO... lovely little intern!!"),MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(LOCALID_PLAYER, moves(walk_up))
    waitmovement
    applymovement(3, moves(face_up))
    setspeaker("Prof. Birds")
    msgbox(format("WELL, WHERE WERE WE BARRY??"),MSGBOX_AUTOCLOSE)
    waitmessage
    setflag(FLAG_INTERN_BOXES_ASSIGNMENT)
    release
    end
    }
    else {
        playse(SE_PIN)
        applymovement(3, moves(emote_exclamation_mark face_down))
        setspeaker("Prof. Birds")
        msgbox(format("WHERE DO YOU THINK YOU ARE GOING, {PLAYER}?\p GET TO THE BACK AND GET THOSE BOXES HERE!!"),MSGBOX_AUTOCLOSE)
        waitmessage
        applymovement(LOCALID_PLAYER, moves(walk_up))
        applymovement(3, moves(face_up))
        waitmovement
        release
        end
    }
    
}

script LabJariIndoor_Eventscript_Birds_Convo {
    lock
    playse(SE_PIN)
    applymovement(3, moves(emote_exclamation_mark))
    faceplayer
    setspeaker("Prof. Birds")
    msgbox(format("DON'T BOTHER US, I'M EXPLAINING TO BARRY HOW IMPORTANT DNA SAMPL... pig sensors are!!"))
    waitmessage
    playse(SE_PIN)
    applymovement(2, moves(face_right emote_question_mark))
    setspeaker("Barry")
    msgbox(format("...ehummm...\p...my name is Wou..."),MSGBOX_AUTOCLOSE)
    waitmessage
    playse(SE_PIN)
    applymovement(3,moves(emote_exclamation_mark face_left))
    waitmovement
    setspeaker("Prof. Birds")
    msgbox(format("JUST FOCUS ON THE BOOKS BARRY!"),MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(2, moves(face_up))
    waitmovement
    delay(40)
    applymovement(3, moves(face_down))
    waitmovement
    setspeaker("Prof. Birds")
    msgbox(format("NOW GET THOSE BOXES OUT OF THE STORAGE ROOM!!"),MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(3, moves(face_up))
    waitmovement
    release
}

script LabJariIndoor_Eventscript_Barry_Convo {
    lock
    playse(SE_PIN)
    applymovement(2, moves(emote_exclamation_mark))
