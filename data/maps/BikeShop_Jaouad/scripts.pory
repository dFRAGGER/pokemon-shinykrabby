mapscripts BikeShop_Jaouad_MapScripts {}

script BikeShop_Jaouad_EventScript_Kasmi {
    lock
    faceplayer
    if (flag(FLAG_RECEIVED_BIKE) == TRUE) {
        goto(BikeShop_Jaouad_EventScript_ReturnGreeting)
    }
    setspeaker("MR. KASMI")
    msgbox(format("Oh! A customer! Come in, come in!\pThe name is Kasmi. Mr. Kasmi. My real surname has four vowels in a row.\pNobody can say it right.\pSo. Kasmi it is.\pBefore all this? I was a transfer pricing specialist. Corporate tax structures, intercompany deals, profit shifting across borders.\pI was good at it. Very good. But I did it for myself, not for them.\pLet's just say I left with more than I arrived with.\pLegally.\p Mostly...\pOne day I looked at the numbers and thought: enough. I bought a motorcycle and left.\pWar zones. Remote lands. Eventually I found these vast temperate steppes...\pJust grass and sky, horizon to horizon. Completely alone.\pThen love called me home. You know the deal.\pNow I fix these things. Simple machines. But they get the job done."), MSGBOX_DEFAULT)
    goto(BikeShop_Jaouad_EventScript_MainMenu)
}

script BikeShop_Jaouad_EventScript_ReturnGreeting {
    setspeaker("MR. KASMI")
    msgbox(format("Back again? I was just thinking about a mountain pass I once crossed.\pFixed a cracked frame with a strip of steel and two bolts ordered from three countries.\pAnyway."), MSGBOX_DEFAULT)
    goto(BikeShop_Jaouad_EventScript_MainMenu)
}

script BikeShop_Jaouad_EventScript_MainMenu {
    setspeaker("MR. KASMI")
    msgbox(format("So. What can I do for you?"), MSGBOX_DEFAULT)
    multichoice(0, 0, MULTI_KASMI_MENU, TRUE)
    if (var(VAR_RESULT) == 0) {
        goto(BikeShop_Jaouad_EventScript_TaxTips)
    }
    if (var(VAR_RESULT) == 1) {
        goto(BikeShop_Jaouad_EventScript_BikeSection)
    }
    release
    end
}

script BikeShop_Jaouad_EventScript_TaxTips {
    setspeaker("MR. KASMI")
    msgbox(format("You want to know my secrets? Fine. Listen carefully.\pFirst: everything is a business expense. This shop. My tools. My home. All of it.\pSecond: register a holding company somewhere with no tax treaty. Name it something boring.\pThird: pay yourself just below the income threshold. The rest stays in the company.\pThe tax code was written by people. And people leave gaps.\pI found mine a long time ago. I do alright for myself."), MSGBOX_DEFAULT)
    goto(BikeShop_Jaouad_EventScript_MainMenu)
}

script BikeShop_Jaouad_EventScript_BikeSection {
    if (flag(FLAG_RECEIVED_BIKE) == TRUE) {
        goto(BikeShop_Jaouad_EventScript_CheckBike)
    }
    goto(BikeShop_Jaouad_EventScript_GetBike)
}

script BikeShop_Jaouad_EventScript_GetBike {
    setspeaker("MR. KASMI")
    msgbox(format("Trying to get onto the BIKE ROUTE, are you?\pThey won't let anyone through without proper wheels. Sensible people, for once.\pGood timing. I've rebuilt a model with two setups.\pIt can handle hops and tight obstacles, but it can build serious speed too.\pWhat it still needs is a field test.\pIn transfer pricing, you learn never to give anything away.\pYou simply move its value somewhere more useful.\pI record the BIKE as promotional equipment, and you as my field tester.\pYou get wheels. I get test data, free publicity, and a beautifully empty line in my inventory.\pMuch tidier than hiding money.\pSo, {PLAYER}: ride it hard, tell everyone Mr. Kasmi built it, and bring back any pieces that fall off.\pDeal?\pGood. I've already filed the paperwork."), MSGBOX_DEFAULT)
    giveitem(ITEM_BICYCLE)
    if (var(VAR_RESULT) == FALSE) {
        goto(Common_EventScript_ShowBagIsFull)
    }
    setflag(FLAG_RECEIVED_BIKE)
    goto(BikeShop_Jaouad_EventScript_AfterGive)
}

script BikeShop_Jaouad_EventScript_AfterGive {
    setspeaker("MR. KASMI")
    msgbox(format("There. A perfectly legitimate sponsorship.\pPress R while you're standing still to change its setup.\pUse the quick setup for jumps and tricks, or switch over when you need pure speed."), MSGBOX_DEFAULT)
    release
    end
}

script BikeShop_Jaouad_EventScript_CheckBike {
    checkitem(ITEM_BICYCLE)
    if (var(VAR_RESULT) == TRUE) {
        goto(BikeShop_Jaouad_EventScript_BikeInstructions)
    }
    checkitem(ITEM_MACH_BIKE)
    if (var(VAR_RESULT) == TRUE) {
        goto(BikeShop_Jaouad_EventScript_ConvertMachBike)
    }
    checkitem(ITEM_ACRO_BIKE)
    if (var(VAR_RESULT) == TRUE) {
        goto(BikeShop_Jaouad_EventScript_ConvertAcroBike)
    }
    setspeaker("MR. KASMI")
    msgbox(format("Your BIKE is in PC storage? Hmm.\pTake it out first and I'll give it a look."), MSGBOX_DEFAULT)
    release
    end
}

script BikeShop_Jaouad_EventScript_ConvertMachBike {
    setspeaker("MR. KASMI")
    msgbox(format("That's one of my old single-setup models. Let me upgrade it so you can switch riding styles whenever you like."), MSGBOX_DEFAULT)
    removeitem(ITEM_MACH_BIKE)
    giveitem(ITEM_BICYCLE)
    goto(BikeShop_Jaouad_EventScript_AfterConversion)
}

script BikeShop_Jaouad_EventScript_ConvertAcroBike {
    setspeaker("MR. KASMI")
    msgbox(format("That's one of my old single-setup models. Let me upgrade it so you can switch riding styles whenever you like."), MSGBOX_DEFAULT)
    removeitem(ITEM_ACRO_BIKE)
    giveitem(ITEM_BICYCLE)
    goto(BikeShop_Jaouad_EventScript_AfterConversion)
}

script BikeShop_Jaouad_EventScript_AfterConversion {
    special(ConvertRegisteredBikeToBicycle)
    setspeaker("MR. KASMI")
    msgbox(format("There. One frame, both setups. Much cleaner."), MSGBOX_DEFAULT)
    goto(BikeShop_Jaouad_EventScript_BikeInstructions)
}

script BikeShop_Jaouad_EventScript_BikeInstructions {
    setspeaker("MR. KASMI")
    msgbox(format("Press R while you're standing still to switch setups.\pOne is built for jumps and tricks. The other is built for speed."), MSGBOX_DEFAULT)
    release
    end
}

script BikeShop_Jaouad_EventScript_Customer {
    lock
    faceplayer
    msgbox(format("Did you see that ridge out there?\pApparently there's an incredible downhill run.\pBut you can't get on it without a bike.\pI walked all the way up here on foot like an idiot.\pMr. Kasmi is the one to talk to about bikes.\pHe's just over there."), MSGBOX_DEFAULT)
    release
    end
}

script BikeShop_Jaouad_EventScript_MartEmployee {
    lockall
    faceplayer
    msgbox(format("Long ride? I've got cold drinks.\pFresh water, soda, lemonade, pick your poison."))
    waitmessage
    pokemart(BikeShop_Jaouad_Mart_Sodas)
    msgbox(gText_PleaseComeAgain, MSGBOX_DEFAULT)
    releaseall
}

mart BikeShop_Jaouad_Mart_Sodas {
    ITEM_FRESH_WATER
    ITEM_SODA_POP
    ITEM_LEMONADE
}
