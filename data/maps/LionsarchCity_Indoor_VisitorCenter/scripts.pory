mapscripts LionsarchCity_Indoor_VisitorCenter_MapScripts {}

// Visitor Center for Twin Lions Mountain tourism

script VisitorCenter_Receptionist {
    lockall
    faceplayer
    msgbox(format("Welcome to the Twin Lions Visitor Center!\pWe provide information and supplies for travelers heading north to the Lion Mountains.\pHow can I help you today?"))
    waitmessage
    releaseall
}

script VisitorCenter_MountainGuide {
    lockall
    faceplayer
    msgbox(format("The Lion Mountains are named after the twin peaks that resemble two lions facing each other.\pThe northern route is challenging but offers incredible views.\pMake sure you're prepared - the weather can change quickly up there!"))
    releaseall
}

script VisitorCenter_Ranger {
    lockall
    faceplayer
    msgbox(format("I'm a ranger stationed in the mountains.\pWe've noticed increased activity from the Faculty lately.\pThey claim to have mining permits, but something feels... off.\pPlease be careful if you head up there."))
    releaseall
}

script VisitorCenter_Hiker {
    lockall
    faceplayer
    msgbox(format("I've hiked these mountains for twenty years.\pThe Faculty's drilling has disturbed the local Pokémon.\pUrsaring have been more aggressive than usual.\pStay on the marked trails!"))
    releaseall
}

script VisitorCenter_Tourist {
    lockall
    faceplayer
    msgbox(format("I came all the way from Marshduke City to see the Twin Lions!\pAlso the view from the eastern cliff route is supposed to be spectacular.\pI'm so excited!"))
    releaseall
}

script VisitorCenter_MapBoard {
    lockall
    msgbox(format("A large map of the Lion Mountains region:\p- Northern Route:\nSteep terrain, requires proper footware\p- Eastern Cliff Route:\nLonger path to Marshduke City\p- Wildlife Warning:\nUrsaring, Donphan, Golem common\p- Faculty Mining Zone:\nRESTRICTED ACCESS"))
    releaseall
}

script VisitorCenter_WarningSign {
    lockall
    msgbox(format("MOUNTAIN SAFETY WARNING:\p- Bring plenty of Potions\nand Revives\p- Watch for falling rocks\n- Avoid Faculty mining zones\p- Emergency shelters on map\p- Report suspicious activity\nto rangers"))
    releaseall
}

script VisitorCenter_BrochureRack {
    lockall
    msgbox(format("Brochures about the Lion Mountains:\p- 'Twin Lions: A Natural Wonder'\n- 'Mountain Pokémon of the North'\p- 'Hiking Safety Guide'\n- 'History of Lionsarch City'"))
    releaseall
}

script VisitorCenter_DonationBox {
    lockall
    msgbox(format("A donation box for mountain trail maintenance.\pThere's a note:\p'Help us keep the trails safe\nand clean!\pAll donations go to ranger programs\nand wildlife protection.'"))
    releaseall
}
