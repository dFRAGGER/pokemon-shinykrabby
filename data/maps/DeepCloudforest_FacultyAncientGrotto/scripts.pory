mapscripts DeepCloudforest_FacultyAncientGrotto_MapScripts {
        MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_MISTCITY_RESEARCH_CENTER_LOCATION, 5: DeepCloudForest_AncientGrotto_GetOutTruck
    ]

}

script DeepCloudForest_AncientGrotto_GetOutTruck {
    lock
    applymovement(LOCALID_PLAYER, moves(jump_right))
    waitmovement
    setvar(VAR_MISTCITY_RESEARCH_CENTER_LOCATION,6)
    delay(60)
    applymovement(LOCALID_PLAYER, moves(walk_fast_up*3 walk_fast_left*2 walk_fast_up walk_fast_left))
    waitmovement
    special(SpawnCameraObject)
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_left*4))
    waitmovement
    msgbox(format("The Rector: Allright children, to make a long story short, force the golem on the ship and lets get out of here."),MSGBOX_AUTOCLOSE)
    setflag(FLAG_ANCIENTGROTTO_BOARD_SHIP)
    delay(40)
    applymovement(3, moves(walk_slow_left*3))
    applymovement(5, moves(walk_slow_left*3))
    applymovement(4, moves(walk_slow_left*3))
    applymovement(7, moves(walk_slow_left*3))
    applymovement(12, moves(walk_slow_left*3))
    applymovement(6, moves(walk_slow_left*3))
    applymovement(11, moves(walk_slow_left*3))
    applymovement(13, moves(walk_slow_left*3))
    waitmovement  
    applymovement(LOCALID_PLAYER, moves(walk_fast_left*3))
    applymovement(9, moves(walk_fast_left*3 emote_exclamation_mark))
    applymovement(8, moves(walk_fast_left*3))
    applymovement(10, moves(walk_fast_left*3))
    waitmovement
    msgbox(format("{COLOR GREEN}Daan{COLOR DARK_GRAY}: HEY!\nWHAT ARE YOU GUYS DOING?"),MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(7, moves(walk_right*2))
    playse(SE_PIN)
    applymovement(6, moves(emote_exclamation_mark walk_slow_right))
    waitmovement
    applymovement(LOCALID_PLAYER, moves(jump_right face_left))
    applymovement(12, moves(face_right))
    applymovement(11, moves(face_right))
    applymovement(13, moves(face_right))
    applymovement(3, moves(face_right))
    applymovement(5, moves(face_right))
    applymovement(4, moves(face_right))
    waitmovement
    applymovement(6, moves(walk_slow_left face_right))
    waitmovement
    msgbox(format("The Rector: Impressive!\pHow did you guys find us that quickly?"), MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(8, moves(walk_down face_left))
    delay(40)
    msgbox(format("{COLOR RED}David{COLOR DARK_GRAY}: That energy...\pthe pressure...\pIt's the 'Silent Guardian'...\pIt's exactly what the legends described.\nThey actually did it.\pThey have Registeel."),MSGBOX_AUTOCLOSE)
    delay(60)
    applymovement(7, moves(walk_down*2 face_right))
    waitmovement
    msgbox(format("The Rector: Well well, young man.\pYou seem to be an intelligent kid.\pWhy don't you join the faculty?\nAt the faculty we Push Boundaries, Develop Talent and Inspire!!\pYou would be the perfect fit!"),MSGBOX_AUTOCLOSE)
    waitmessage
    playse(SE_PIN)
    applymovement(9, moves(emote_exclamation_mark walk_fast_left walk_fast_down*2 face_left ))
    waitmovement
    msgbox(format("{COLOR GREEN}Daan{COLOR DARK_GRAY}: Don't talk to him, you fool!\pFree Registeel, he belongs in this forest!"), MSGBOX_AUTOCLOSE)
    delay(40)
    applymovement(7, moves(face_left))
    delay(60)
    applymovement(7, moves(face_right))
    waitmessage
    msgbox(format("The Rector: Unfortunately, I can't do that.\pOur plan is bigger than this chaotic forest.\pHe is a necessary piece to bring order to this world."), MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(10, moves(emote_exclamation_mark walk_fast_left*2 face_down))
    waitmovement
    msgbox(format("{COLOR BLUE}Nash{COLOR DARK_GRAY}: What do you mean?"),MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(7, moves(face_up))
    msgbox(format("The Rector: You will see my friend, you will see.\pChildren, lets get out of here."), MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(7, moves(face_left))
    msgbox(format("The Rector: ELECTABUZZ, FLASH!!"), MSGBOX_AUTOCLOSE)
    setflag(FLAG_ANCIENTGROTTO_DISAPPEAR_SHIP)
    delay(40)
    playse(SE_BANG)
    fadescreenswapbuffers(FADE_TO_WHITE)
    msgbox(format("{COLOR BLUE}Nash{COLOR DARK_GRAY}: Goddamn, not again...\nI should have brought my sunglasses..."),MSGBOX_AUTOCLOSE)
    removeobject(12)
    removeobject(7)
    removeobject(6)
    removeobject(13)
    removeobject(11)
    removeobject(3)
    removeobject(4)
    removeobject(5)
    delay(60)    
    fadescreenswapbuffers(FADE_FROM_WHITE)
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_left*2))
    applymovement(LOCALID_PLAYER, moves(walk_fast_left*4))
    applymovement(9, moves(walk_fast_left*4))
    applymovement(10, moves(walk_fast_left*4))
    applymovement(8, moves(walk_fast_left*4))
    waitmovement
    applymovement(2, moves(walk_slow_left*5))
    special(RemoveCameraObject)
    msgbox(format("{COLOR GREEN}Daan{COLOR DARK_GRAY}: We can't catch them..."),MSGBOX_AUTOCLOSE)
    delay(120)
    msgbox(format("{COLOR GREEN}Daan{COLOR DARK_GRAY}: Lets get back to the research station, it's getting dark."),MSGBOX_AUTOCLOSE)
    waitmessage
    clearflag(FLAG_DAVID_TRUCK)
    fadescreen(FADE_TO_BLACK)
    delay(40)
    playse(SE_TRUCK_DOOR)
    warpsilent (MAP_INSIDE_OF_TRUCK, 1)
    waitstate
    release 
}