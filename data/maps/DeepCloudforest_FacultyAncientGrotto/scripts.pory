mapscripts DeepCloudforest_FacultyAncientGrotto_MapScripts {
        MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_MISTCITY_RESEARCH_CENTER_LOCATION, 5: DeepCloudForest_AncientGrotto_GetOutTruck
    ]

}

script DeepCloudForest_AncientGrotto_GetOutTruck {
    lock
    applymovement(LOCALID_PLAYER, moves(jump_right))
    waitmovement
    setvar(VAR_MISTCITY_RESEARCH_CENTER_LOCATION,6)
    applymovement(14, moves(walk_left*2))
    delay(60)
    playse(SE_PIN)
    applymovement(LOCALID_PLAYER, moves(emote_question_mark))
    waitmovement
    delay(40)
    applymovement(14, moves(walk_fast_down walk_fast_left*2))
    waitmovement
    playse(SE_PIN)
    applymovement(14, moves(emote_question_mark))
    waitmovement
    delay(60)
    playmoncry(SPECIES_MEW,CRY_MODE_ENCOUNTER)
    waitmoncry
    delay(40)
    applymovement(14, moves(walk_fast_right*5))
    waitmovement
    delay(60)
    msgbox(format("What even was that?\p...maybe my eyes decieved me...\p...\pThe others need me, wake up!"),MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(LOCALID_PLAYER, moves(walk_fast_up*2 walk_fast_left*2 walk_fast_up walk_fast_left*3 walk_fast_up*6))
    waitmovement
    playbgm(MUS_AQUA_MAGMA_HIDEOUT,FALSE)
    special(SpawnCameraObject)
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_up*9))
    waitmovement
    setspeaker("THE RECTOR")
    msgbox(format("Allright teachers, to make a long story short...\pForce the golem out of that meteorite and lets get out of here."),MSGBOX_AUTOCLOSE)
    setflag(FLAG_ANCIENTGROTTO_BOARD_SHIP)
    delay(40)
    applymovement(6, moves(walk_fast_left*2 face_right))
    applymovement(11, moves(walk_fast_right*2 face_left))
    applymovement(7, moves(walk_slow_down face_up))
    waitmovement
    setspeaker("THE RECTOR")
    msgbox(format("1... 2... 3... MEGA PUNCH!"),MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(5, moves(jump_right))
    applymovement(4, moves(jump_left))
    applymovement(13, moves(jump_up))
    waitmovement
    playse(SE_M_EARTHQUAKE)
    waitse
    setspeaker("NASH")
    msgbox(format("WATCH OUT!\nTAKE COVER!"),MSGBOX_AUTOCLOSE)
    fadescreenswapbuffers(FADE_TO_BLACK)
    delay(60)
    setmetatile(22,14, 0x35E, TRUE)
    setmetatile(22,15, 0x349, TRUE)
    setmetatile(22,16,0x349, TRUE)
    setmetatile(23,13,0x35E, TRUE)
    setmetatile(23,14,0x395, TRUE)
    setmetatile(23,15,0x339, TRUE)
    setmetatile(23,16,0x339, TRUE)
    setmetatile(23,17,0x393, TRUE)
    setmetatile(24,13,0x334, TRUE)
    setmetatile(24,14,0x394, TRUE)
    setmetatile(24,15,0x339, TRUE)
    setmetatile(24,16,0x339, TRUE)
    setmetatile(24,17,0x339, TRUE)
    setmetatile(24,18,0x34B, TRUE)
    setmetatile(25,14,0x341, TRUE)
    setmetatile(25,15,0x339, TRUE)
    setmetatile(25,16,0x392, TRUE)
    setmetatile(25,17,0x351, TRUE)
    setmetatile(26,14,0x334, TRUE)
    setmetatile(26,15,0x351, TRUE)
    setmetatile(17,12,0x39A, FALSE)
    setmetatile(17,13,0x3AA, FALSE)
    setmetatile(17,14,0x3A2, FALSE)
    setmetatile(18,11,0x3B0, FALSE)
    setmetatile(18,12,0x3A8, TRUE)
    setmetatile(18,13,0x3A0, TRUE)
    setmetatile(18,14,0x3A5, FALSE)
    setmetatile(18,15,0x3B2, FALSE)
    setmetatile(19,11,0x3B1, FALSE)
    setmetatile(19,12,0x3A9, TRUE)
    setmetatile(19,13,0x3A1, TRUE)
    setmetatile(19,14,0x3A6, FALSE)
    setmetatile(19,15,0x3B3, FALSE)
    setmetatile(20,12,0x39B, FALSE)
    setmetatile(20,13,0x3AB, FALSE)
    setmetatile(20,14,0x3A3, FALSE)
    setmetatile(18,18,0x39A, FALSE)
    setmetatile(18,19,0x3A4, FALSE)
    setmetatile(18,20,0x3A2, FALSE)
    setmetatile(19,18,0x398, TRUE)
    setmetatile(19,19,0x3A0, TRUE)
    setmetatile(19,20,0x3AD, TRUE)
    setmetatile(19,21,0x3B2, FALSE)
    setmetatile(20,18,0x399, TRUE)
    setmetatile(20,19,0x3A1, TRUE)
    setmetatile(20,20,0x3A6, FALSE)
    setmetatile(20,21,0x3B3, FALSE)
    setmetatile(21,18,0x39B, FALSE)
    setmetatile(21,19,0x39D, FALSE)
    setmetatile(21,20,0x3A3, FALSE)
    setmetatile(21,21,0x39A, FALSE)
    setmetatile(21,22,0x39C, FALSE)
    setmetatile(22,20,0x383, FALSE)
    setmetatile(22,21,0x396, FALSE)
    setmetatile(22,22,0x3B3, FALSE)
    setmetatile(23,20,0x384, FALSE)
    setmetatile(23,21,0x37B, FALSE)
    setmetatile(22,9,0x39A, FALSE)
    setmetatile(22,10,0x3AA, FALSE)
    setmetatile(22,11,0x39C, FALSE)
    setmetatile(23,9,0x39F, TRUE)
    setmetatile(23,10,0x397, TRUE)
    setmetatile(23,11,0x3AC, FALSE)
    setmetatile(24,9,0x39B, FALSE)
    setmetatile(24,10,0x3AB, FALSE)
    setmetatile(24,11,0x3A3, FALSE)
    setmetatile(26,9,0x39A, FALSE)
    setmetatile(26,10,0x3AA, FALSE)
    setmetatile(26,11,0x3A2, FALSE)
    setmetatile(27,8,0x3B0, FALSE)
    setmetatile(27,9,0x3A8, TRUE)
    setmetatile(27,10,0x3A0, TRUE)
    setmetatile(27,11,0x3AD, TRUE)
    setmetatile(27,12,0x3B2, FALSE)
    setmetatile(28,8,0x3B1, FALSE)
    setmetatile(28,9,0x3A9, TRUE)
    setmetatile(28,10,0x3A1, TRUE)
    setmetatile(28,11,0x3A6, FALSE)
    setmetatile(28,12,0x3B4, FALSE)
    setmetatile(28,13,0x3A4, FALSE)
    setmetatile(28,14,0x39C, FALSE)
    setmetatile(29,9,0x39B, FALSE)
    setmetatile(29,10,0x3AB, FALSE)
    setmetatile(29,11,0x3AF, FALSE)
    setmetatile(29,12,0x372, FALSE)
    setmetatile(29,13,0x396, TRUE)
    setmetatile(29,14,0x3AC, FALSE)
    setmetatile(30,13,0x3BC, FALSE)
    setmetatile(30,14,0x3A3, FALSE)
    setmetatile(28,18,0x39A, FALSE)
    setmetatile(28,19,0x3AA, FALSE)
    setmetatile(28,20,0x3A2, FALSE)
    setmetatile(29,18,0x398, TRUE)
    setmetatile(29,19,0x3A0, TRUE)
    setmetatile(29,20,0x3A5, FALSE)
    setmetatile(29,21,0x3B2, FALSE)
    setmetatile(30,17,0x39A, FALSE)
    setmetatile(30,18,0x38D, TRUE)
    setmetatile(30,19,0x3A1, TRUE)
    setmetatile(30,20,0x3AE, TRUE)
    setmetatile(30,21,0x3B3, FALSE)
    setmetatile(31,17,0x39B, FALSE)
    setmetatile(31,18,0x39D, FALSE)
    setmetatile(31,19,0x3AB, FALSE)
    setmetatile(31,20,0x3A3, FALSE)
    special(DrawWholeMapView)
    addobject(15)
    applymovement(6, moves(walk_up face_right))
    applymovement(7, moves(walk_up))
    applymovement(11, moves(walk_up face_left))
    applymovement(5, moves(walk_left face_right))
    applymovement(4, moves(walk_right face_left))
    applymovement(13, moves(walk_down face_up))
    applymovement(15, moves(walk_faster_down*4))
    waitmovement
    playse(SE_M_THUNDERBOLT)
    waitse
    delay(60)
    playse(SE_M_ROCK_THROW)
    waitse
    delay(60)
    playse(SE_M_ROCK_THROW)
    waitse
    fadescreenswapbuffers(FADE_FROM_BLACK)
    delay(120)


    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_down*3))
    applymovement(LOCALID_PLAYER, moves(walk_fast_up*5))
    applymovement(8, moves(walk_fast_up*5))
    applymovement(10, moves(walk_fast_up*5))
    applymovement(9, moves(walk_fast_up*6))
    waitmovement
    playse(SE_PIN)
    applymovement(9, moves(emote_exclamation_mark))
    waitmovement
    setspeaker("DAAN")
    msgbox(format("HEY!\nWHAT ARE YOU GUYS DOING?"),MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(7, moves(face_down))
    playse(SE_M_JUMP_KICK)
    applymovement(12, moves(walk_fast_left walk_fast_down walk_slow_up face_down))
    applymovement(9, moves(jump_down face_up))
    applymovement(6, moves(walk_left face_down))
    applymovement(11, moves(walk_left face_down))
    applymovement(13, moves(walk_left walk_up face_down))
    applymovement(3, moves(face_down))
    applymovement(5, moves(face_down))
    applymovement(4, moves(face_down))
    waitmovement
    delay(60)
    applymovement(7, moves(walk_slow_down))
    setspeaker("THE RECTOR")
    msgbox(format("Impressive!\pHow did you guys find us that quickly?\pI'm THE RECTOR, leader of The Faculty.\pWe believe in pushing boundaries, developing talent, and inspiring others.\pBut above all, we believe in bringing order to a chaotic world."), MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(8, moves(walk_left walk_up face_up))
    delay(60)
    setspeaker("DAVID")
    msgbox(format("That energy...\pthe pressure...\pIt must be the 'Silent Guardian'..."),MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_up*4))
    waitmovement
    setspeaker("DAVID")
    msgbox(format("It's exactly what the legends described.\pMade from steel not of this earth...\pIt is one of the three ancient golems...\p...they call it... REGISTEEL."),MSGBOX_AUTOCLOSE)
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_down*4))
    delay(60)
    applymovement(7, moves(walk_up walk_left*3 face_down))
    waitmovement
    setspeaker("THE RECTOR")
    msgbox(format("Look at you, young man.\pYou seem to be an intelligent kid.\pWhy don't you join the faculty?\pAt the faculty you can push your Boundaries, develop your Talent and Inspire others!!\pYou would be the perfect fit!"),MSGBOX_AUTOCLOSE)
    waitmessage
    playse(SE_PIN)
    applymovement(8, moves(jump_down face_up))
    applymovement(10, moves(emote_exclamation_mark walk_fast_left*2 face_up ))
    waitmovement
    setspeaker("NASH")
    msgbox(format("Don't talk to him, you fool!\pDon't you dare to touch the golem, he belongs in this forest!"), MSGBOX_AUTOCLOSE)
    delay(40)
    applymovement(7, moves(walk_right*2 face_up))
    waitmovement
    delay(90)
    applymovement(7, moves(walk_left*2 face_down))
    waitmovement
    delay(60)
    setspeaker("THE RECTOR")
    msgbox(format("Unfortunately, I can't do that.\pOur plan is bigger than this chaotic forest.\pHe is a necessary piece to bring order to this world."), MSGBOX_AUTOCLOSE)
    waitmessage
    playse(SE_PIN)
    applymovement(12, moves(face_left))
    applymovement(9, moves(emote_exclamation_mark walk_fast_left*2 walk_fast_up*2 face_left))
    waitmovement
    setspeaker("NASH")
    msgbox(format("What do you mean?"),MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(7, moves(face_right))
    setspeaker("THE RECTOR")
    msgbox(format("You will see my friend, you will see.\pTeachers, get the golem into a truck.\pI'll deal with these children."), MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(9,moves(face_up))
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_up))
    applymovement(12,moves(face_up))
    applymovement(13, moves(walk_slow_up jump_2_right face_down))
    applymovement(6, moves(walk_slow_right face_right))
    applymovement(11, moves(walk_slow_left face_left))
    applymovement(5, moves(walk_slow_right))
    applymovement(4, moves(walk_slow_left))
    waitmovement
    setspeaker("THE RECTOR")
    msgbox(format("ELECTABUZZ, FLASH!!"), MSGBOX_AUTOCLOSE)
    setflag(FLAG_ANCIENTGROTTO_DISAPPEAR_SHIP)
    delay(40)
    applymovement(10, moves(face_right))
    setspeaker("NASH")
    msgbox(format("Goddamn, not again...\nI should have brought my sunglasses..."),MSGBOX_AUTOCLOSE)
    waitmessage
    playse(SE_M_THUNDERBOLT2)
    fadescreenswapbuffers(FADE_TO_WHITE)
    clearflag(FLAG_DAVID_TRUCK)
    delay(120)
    removeobject(16)
    removeobject(17)
    removeobject(2)
    removeobject(12)
    removeobject(7)
    removeobject(6)
    removeobject(13)
    removeobject(11)
    removeobject(3)
    removeobject(4)
    removeobject(5)
    removeobject(15)
    addobject(18)
    addobject(19)
    addobject(20)
    delay(60)    
    fadescreenswapbuffers(FADE_FROM_WHITE)
    delay(60)
    playse(SE_PIN)
    applymovement(10, moves(walk_right face_down emote_exclamation_mark))
    waitmovement
    setspeaker("NASH")
    msgbox(format("They headed for the trucks!\pLet's go!"),MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_fast_down*15 walk_left*3))
    applymovement(LOCALID_PLAYER, moves(walk_fast_down*16 walk_fast_left*4))
    applymovement(9, moves(walk_fast_down*16 walk_fast_left*3))
    applymovement(10, moves(walk_fast_down*15 walk_fast_left face_left))
    applymovement(8, moves( walk_fast_down*15 face_left))
    waitmovement
    delay(10)
    playse(SE_TRUCK_MOVE)
    applymovement(18, moves(walk_left*10))
    applymovement(19, moves(walk_left*10))
    applymovement(20, moves(walk_left*10))
    waitmovement

    fadedefaultbgm
    special(RemoveCameraObject)
    playse(SE_PIN)
    applymovement(9, moves(emote_double_exclamation_mark))
    setspeaker("DAAN")
    msgbox(format("Damn...\pWe can't catch them...\pIt's getting dark, and chasing them in this forest is dangerous."),MSGBOX_AUTOCLOSE)
    delay(120)
    applymovement(9, moves(face_down))
    applymovement(LOCALID_PLAYER, moves(face_up))
    applymovement(10, moves(walk_left face_up))
    waitmovement
    setspeaker("NASH")
    msgbox(format("Hmmm...\pLet's get back to the research station...\pWe need to regroup and think about our next steps."),MSGBOX_AUTOCLOSE)
    waitmessage

    fadescreen(FADE_TO_BLACK)
    delay(40)
    playse(SE_TRUCK_DOOR)
    warpsilent (MAP_INSIDE_OF_TRUCK, 1)
    waitstate
    release 
}
