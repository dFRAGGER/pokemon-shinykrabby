    end
}

script Route014_NPC_PatientAngler {
    lock
    faceplayer
    if (flag(FLAG_MARSHDUKE_CATHEDRAL_TOUR)) {
        msgbox(format("One fish today.\pYou saw old fishing records in the city? Bring the dates next time. I'd like to compare them with mine."))
    } else {
        msgbox(format("One fish today. I wrote it down, same as always."))
    }
    release
    end
}
