script Route014_NPC_BridgeCarpenter {
    lock
    faceplayer
    msgbox(format("Ari looks at a gap and sees a sporting opportunity. I look at it and see three days of work.\pHe has never offered to race me carrying the timber."))
    release
    end
}

script Route014_NPC_OldRoad {
    lock
    faceplayer
    msgbox(format("The road used to run closer to the bank.\pMy knees still try to take the old turning."))
    release
    end
}


