script Route014_Trainer_Derk {
    trainerbattle_single(TRAINER_DELTA_DERK_SK, Route014_Trainer_Derk_Intro, Route014_Trainer_Derk_Defeat)
    msgbox(Route014_Trainer_Derk_After, MSGBOX_AUTOCLOSE)
    end
}

text Route014_Trainer_Derk_Intro {
    format("I've had enough waiting for a bite!")
}

text Route014_Trainer_Derk_Defeat {
    format("Back to fishing, then!")
}

text Route014_Trainer_Derk_After {
    format("I promised to be home by lunchtime if nothing was biting. That was yesterday.")
}

