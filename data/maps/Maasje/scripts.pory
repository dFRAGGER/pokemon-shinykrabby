script Maasje_Eventscript_Maniac {
    lock
    faceplayer
    if(flag(FLAG_SHINY_KRABBY_ENCOUNTER)==FALSE){
    msgbox(format("This town is overrun by Krabby's.\pEverybody is scared to go outside.\pI still need groceries though, so I'm taking the risk!"))
    release
    end
    }
    else{
        msgbox(format("Everybody is still shook by the infestation by those Krabby's.\p You won't seem them outside very often.\p Hopefully one day everyting will be back to normal."))
        release
        end
    }
}