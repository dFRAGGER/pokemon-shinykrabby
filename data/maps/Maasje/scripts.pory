mapscripts Maasje_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        call(Maasje_On_Transition)
    }
}

script Maasje_On_Transition {
    setflag (FLAG_VISITED_MAASJE)
}

script Maasje_Sign_Welcome {
    lock
    msgbox(format("Welcome to Maasje!"))
    waitmessage
    release
}

script Maasje_Sign_Jakub_Home {
    lock
    msgbox(format("Jakub's House"))
    waitmessage
    release
}

script Maasje_Sign_Gym {
    lock
    msgbox(format("Maasje Gym:\n Where sand rules the world."))
    waitmessage
    release
}

script Maasje_Sign_Hill {
    lock
    msgbox(format("Uphill: PokeGym\n Downhill: The beach"))
    waitmessage
    release
}

script Maasje_Sign_Beekeeper {
    lock
    msgbox(format("Beekeeper Smells's House"))
    waitmessage
    release
}

script Maasje_Sign_CrabHill {
    lock
    msgbox(format("Crab Hill:\n WARNING! EASY TO GET LOST! TAKE CARE!"))
    waitmessage
    release
}

script Maasje_Sign_NextRoute {
    lock
    msgbox(format("The Cloud Forest:\n Enter on own risk, or with a guide."))
    waitmessage
    release
}

script Maasje_Krabby_Cry {
    playmoncry(SPECIES_KRABBY, CRY_MODE_NORMAL)
}

script Maasje_Collect_Honey_BeeHives {
    lock
    msgbox(format("You have collected honey from the beehive."))
    release
}

script Maasje_Advice_Fisher_Crabhill {
    lock
    applymovement(60, moves(face_player))
    if(flag(FLAG_RECEIVED_ESCAPE_ROPE) == FALSE){
    msgbox(format("Whoa there, planning on going in?\pThat place can be a tricky maze. Here, take this with you, just in case."))
    giveitem(ITEM_ESCAPE_ROPE)
    setflag(FLAG_RECEIVED_ESCAPE_ROPE)
    msgbox(format("It's an Escape Rope. A real lifesaver if you ever feel hopelessly lost!"))
    waitmessage
    }
    else {
        msgbox(format("Can you believe this whole place was once an underwater reef?\p Thanks to the tireless work of crabs, the reef grew over time, creating this safe haven for Pokémon."))
        waitmessage
    }
    release
}

script Maasje_Flag_Follower_Prep {
    setflag(FLAG_DISABLE_FOLLOWER_POKEMON)
}

script Maasje_Beehive_01 {
    lock
    if(flag(FLAG_START_COLLECTING_HONEY) == TRUE){
    if(flag(FLAG_CLEAR_BEEHIVE_01) == FALSE){
        msgbox(format("This beehive seems full of honey, do you want to collect it?"), MSGBOX_YESNO)
        if(var(VAR_RESULT)){
            msgbox(format("{PLAYER} collected the honey."))
            addvar(VAR_BEEKEEPER_GEURTS, 1)
            setflag(FLAG_CLEAR_BEEHIVE_01)
            waitmessage
        }
    }
    else{
        msgbox(format("The beehive is empty. Better look for another hive."))
        waitmessage
    }
    }
    else{
        msgbox(format("It's a beehive, better not touch it."))
        waitmessage
    }
    release
}

