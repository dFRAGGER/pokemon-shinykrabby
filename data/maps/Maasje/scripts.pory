script Maasje_Joris_UpToTheWhiteLight {
    lock
    faceplayer
    setflag(FLAG_UP_TO_THE_WHITELIGHT_MAASJE)
    getplayerxy(VAR_TEMP_0,VAR_TEMP_1)
    msgbox(format("..."),MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(2, moves(walk_in_place_fast_down))
    delay(40)
    setspeaker("?????")
    msgbox(format("UP TO THE WHITELIGHT!!!"), MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(LOCALID_PLAYER,moves(emote_question_mark))
    delay(40)
    if(var(VAR_TEMP_0)== 49 && var(VAR_TEMP_1)== 34){
        applymovement(2, moves(walk_fast_left walk_fast_down*7 walk_fast_left walk_fast_down*2))
    }
    else{
        applymovement(2, moves(walk_fast_down*7 walk_fast_left*2 walk_fast_down*2))
    }
    waitmovement
    removeobject(2)
    release
    
}

