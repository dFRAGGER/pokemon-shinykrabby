mapscripts Mistcity_PokemonCenter_1F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION{
        call(Mistcity_PokemonCenter_1F_OnTransition)
    }    
    MAP_SCRIPT_ON_RESUME{
        call(CableClub_OnResume)
    }
}

script Mistcity_PokemonCenter_1F_OnTransition {
    setrespawn(HEAL_LOCATION_MIST_CITY)
    end
}

script Mistcity_PokemonCenter_1F_EventScript_Nurse {
	setvar(VAR_0x800B, LOCALID_MISTCITY_NURSE) 
	call (Common_EventScript_PkmnCenterNurse)
	waitmessage
    waitbuttonpress
    release
    end
	
}

script Mistcity_PokemonCenter_BugCatcher {
    lock
    faceplayer
    msgbox(format("Walking through the rain really tires you out, doesn't it?\pIt's nice to just sit here for a while and listen to the healing machine chime."))
    waitmessage
    release
}

script Mistcity_PokemonCenter_Hiker {
    lock
    faceplayer
    msgbox(format("It rains almost every day in this town due to permanent clouds trapped in the valley, so I keep my Charmander inside its Poké Ball to keep its tail flame safe."))
    waitmessage
    release
}