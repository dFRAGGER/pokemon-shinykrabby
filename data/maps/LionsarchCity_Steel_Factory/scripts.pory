// ─── MACHINE WIRES ───

script SteelFactory_1F_Wire1 {
    lock
    if (flag(FLAG_STEEL_FACTORY_WIRE_1_PULLED) == TRUE) {
        msgbox(SteelFactory_Wire_AlreadyPulled)
        release
        end
    }
    if (flag(FLAG_STEEL_FACTORY_ARON_GUIDING) == FALSE) {
        msgbox(SteelFactory_Wire_NotReady)
        release
        end
    }
    msgbox(SteelFactory_Wire_Prompt, MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        setflag(FLAG_STEEL_FACTORY_WIRE_1_PULLED)
        playse(SE_CLICK)
        waitse
        msgbox(SteelFactory_Wire1_PulledText)
        if (flag(FLAG_STEEL_FACTORY_ARON_GUIDING) == TRUE) {
            playse(SE_PIN)
            applymovement(18, moves(emote_exclamation_mark))
            waitmovement(0)
            msgbox(SteelFactory_AronNextMachine_Text,MSGBOX_AUTOCLOSE)
            applymovement(18, moves(walk_fast_down walk_fast_right*3 walk_fast_up*3 walk_fast_right*8))
            waitmovement(18)
            removeobject(18)
            setobjectxyperm(18, 12, 7)
            setobjectmovementtype(18, MOVEMENT_TYPE_FACE_RIGHT)
            clearflag(FLAG_STEEL_FACTORY_ARON_HIDDEN)
            addobject(18)


        }
        call(SteelFactory_CheckAllWires)
    }
    release
}

