mapscripts LionsarchCity_Steel_Factory_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        call(SteelFactory_1F_OnTransition)
    }
}

script SteelFactory_1F_OnTransition {
    if (flag(FLAG_STEEL_FACTORY_ALL_WIRES_PULLED) == TRUE) {
        setmetatile(5, 20, 0x229, FALSE)
        setmetatile(6, 20, 0x229, FALSE)
        setmetatile(7, 20, 0x229, FALSE)
        setmetatile(5, 21, 0x229, FALSE)
        setmetatile(6, 21, 0x229, FALSE)
        setmetatile(7, 21, 0x229, FALSE)
    }
    if (flag(FLAG_STEEL_FACTORY_ARON_INTRO_DONE) == FALSE) {
        setflag(FLAG_STEEL_FACTORY_ARON_HIDDEN)
        setobjectxyperm(18, 4, 12)
        end
    }
    if (flag(FLAG_STEEL_FACTORY_ARON_GUIDING) == FALSE) {
        setflag(FLAG_STEEL_FACTORY_ARON_HIDDEN)
        end
    }
    if (flag(FLAG_STEEL_FACTORY_ALL_WIRES_PULLED) == TRUE) {
        setflag(FLAG_STEEL_FACTORY_ARON_HIDDEN)
        end
    }
    clearflag(FLAG_STEEL_FACTORY_ARON_HIDDEN)
    if (flag(FLAG_STEEL_FACTORY_WIRE_1_PULLED) == FALSE) {
        setobjectxyperm(18, 2, 13)
        end
    }
    if (flag(FLAG_STEEL_FACTORY_WIRE_2_PULLED) == FALSE) {
        setobjectxyperm(18, 12, 7)
        end
    }
    if (flag(FLAG_STEEL_FACTORY_WIRE_3_PULLED) == FALSE) {
        setobjectxyperm(18, 21, 23)
        end
    }
    if (flag(FLAG_STEEL_FACTORY_WIRE_4_PULLED) == FALSE) {
        setobjectxyperm(18, 25, 10)
        end
    }
    setobjectxyperm(18, 35, 16)
    end
}

// ─── ARON INTERACTION ───

script SteelFactory_1F_Aron_Interact {
    lock
    faceplayer
    playse(SE_PIN)
    applymovement(18, moves(emote_question_mark jump_in_place_down))
    waitmovement(18)
    msgbox(SteelFactory_Aron_Interact_Text,MSGBOX_AUTOCLOSE)
    release
}

// ─── ARON INTRO TRIGGER ───

script SteelFactory_1F_AronIntro {
    if (flag(FLAG_STEEL_FACTORY_ARON_INTRO_DONE) == TRUE) {
        end
    }
    getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
    setflag(FLAG_STEEL_FACTORY_ARON_INTRO_DONE)
    lockall
    addobject(18)
    if(var(VAR_TEMP_0) == 1){
    applymovement(18, moves(walk_fast_up * 2 walk_fast_left*2 walk_fast_up*4 face_left))
    waitmovement
    applymovement(LOCALID_PLAYER, moves(face_right))
    waitmovement(0)
    }
    if(var(VAR_TEMP_0) == 2){
    applymovement(18, moves(walk_fast_up * 2 walk_fast_left*2 walk_fast_up*3 face_up))
    waitmovement
    applymovement(LOCALID_PLAYER, moves(face_down))
    waitmovement(0)
    }   
    playse(SE_PIN)
    applymovement(18, moves(emote_question_mark))    
    waitmovement(0)
    msgbox(SteelFactory_AronIntro_Text, MSGBOX_YESNO)
    msgbox(format("The Aron scuttled away!"), MSGBOX_AUTOCLOSE)
    if (var(VAR_RESULT) == YES) {
        setflag(FLAG_STEEL_FACTORY_ARON_GUIDING)
        if(var(VAR_TEMP_0) == 1){
        applymovement(18, moves(walk_fast_down * 3 walk_fast_right *2 walk_fast_down*5 walk_fast_left*2 walk_fast_up face_left))
        applymovement(LOCALID_PLAYER, moves(walk_right walk_down * 3 walk_right *2 walk_down*5 walk_left*3 face_up))
        waitmovement(0)
        }
        if(var(VAR_TEMP_0) == 2){
        applymovement(18, moves(walk_fast_down * 2 walk_fast_right *2 walk_fast_down*5 walk_fast_left*2 walk_fast_up face_left))
        applymovement(LOCALID_PLAYER, moves(walk_down * 3 walk_right *2 walk_down*5 walk_left*3 face_up))
        waitmovement(0)
        }
        msgbox(SteelFactory_AronFollow_Text)
        waitmovement(0)
    } else {
        applymovement(18, moves(walk_fast_down * 3 walk_fast_right *2 walk_fast_down*6))
        waitmovement(0)
        msgbox(SteelFactory_AronLeave_Text)
        removeobject(18)
        setflag(FLAG_STEEL_FACTORY_ARON_HIDDEN)
    }
    releaseall
}

