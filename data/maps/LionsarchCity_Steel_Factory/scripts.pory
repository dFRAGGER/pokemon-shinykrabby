script SteelFactory_CheckAllWires {
    if (flag(FLAG_STEEL_FACTORY_WIRE_1_PULLED) == FALSE) {
        return
    }
    if (flag(FLAG_STEEL_FACTORY_WIRE_2_PULLED) == FALSE) {
        return
    }
    if (flag(FLAG_STEEL_FACTORY_WIRE_3_PULLED) == FALSE) {
        return
    }
    if (flag(FLAG_STEEL_FACTORY_WIRE_4_PULLED) == FALSE) {
        return
    }
    if (flag(FLAG_STEEL_FACTORY_WIRE_5_PULLED) == FALSE) {
        return
    }
    if (flag(FLAG_STEEL_FACTORY_ALL_WIRES_PULLED) == TRUE) {
        return
    }
    setflag(FLAG_STEEL_FACTORY_ALL_WIRES_PULLED)
    setmetatile(5, 20, 0x229, FALSE)
    setmetatile(6, 20, 0x229, FALSE)
    setmetatile(7, 20, 0x229, FALSE)
    setmetatile(5, 21, 0x229, FALSE)
    setmetatile(6, 21, 0x229, FALSE)
    setmetatile(7, 21, 0x229, FALSE)
    playse(SE_DOOR)
    waitse
    msgbox(SteelFactory_AllWires_Text)
    return
}

// ─── CONTROL PANEL - THE CORE CHOICE ───

script SteelFactory_1F_ControlPanel {
    lockall
    if (flag(FLAG_STEEL_FACTORY_CHOICE_MADE) == TRUE) {
        if (flag(FLAG_STEEL_FACTORY_FREED_POKEMON) == TRUE) {
            msgbox(SteelFactory_1F_Panel_AlreadyFreed)
        } else {
            msgbox(SteelFactory_1F_Panel_AlreadyLeft)
        }
        releaseall
        end
    }
    msgbox(SteelFactory_1F_Panel_Prompt, MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        playse(SE_SUCCESS)
        msgbox(SteelFactory_1F_Panel_FreeSequence)
        waitmessage
        setflag(FLAG_STEEL_FACTORY_FREED_POKEMON)
        setflag(FLAG_MEW_SAW_FACTORY_FREED)
        playmoncry(SPECIES_MEW, CRY_MODE_ENCOUNTER)
        waitmoncry
        msgbox(SteelFactory_1F_Panel_MewFree)
        waitmessage
    }
    if (var(VAR_RESULT) == NO) {
        msgbox(SteelFactory_1F_Panel_Left)
        waitmessage
        setflag(FLAG_MEW_SAW_FACTORY_NOT_FREED)
        playmoncry(SPECIES_MEW, CRY_MODE_ENCOUNTER)
        waitmoncry
        msgbox(SteelFactory_1F_Panel_MewLeft)
        waitmessage
    }
    setflag(FLAG_STEEL_FACTORY_CHOICE_MADE)
    releaseall
}

// ─── TEXT ───

text SteelFactory_1F_Scientist_Lore1_Text {
    format("The Regi-Metal alloy is our greatest achievement.\pBy replicating the elemental forging process Regigigas used in Lions Mountains, we create a material that channels legendary energy.\pThe Faculty will bring true order to Teressa. Diversity has had its chance. Now it is structure's turn.")
}

text SteelFactory_1F_Scientist_Lore2_Text {
    format("This is a restricted area!\pLeave immediately or I'm calling security!")
}

text SteelFactory_1F_Scientist_Lore3_Text {
    format("The ore from Lions Mountains is unlike anything we've catalogued.\pDense with ancient energy.\pThe Pokemon here can sense it - it makes them... compliant.\pThat's what The Rector calls it. Compliant.")
}

text SteelFactory_1F_Scientist_Lore4_Text {
    format("Registeel is just a small piece of the puzzle.\pHowever, it does help us build metal structures that can bring order to even the most chaotic places.\pThe Rector seems to have found a way to incentivize it.\pI try not to think about the details.")
}

text SteelFactory_1F_Scientist_Lore5_Text {
    format("The electro-magnetic resonance from the Magnemite cluster amplifies the metal's conductivity tenfold.\pAdd the origin of the ore to the equation and we're making something the Regis would recognize as their own.")
}

text SteelFactory_1F_Official_Lore1_Text {
    format("Teressa is a beautiful region.\pBut it's wasted on chaos.\pDozens of mutations, dozens of types, no cohesion, no direction.\pWe are going to change that.\pOne processed metric ton at a time.")
}

text SteelFactory_1F_Official_Lore2_Text {
    format("The Faculty destroying diversity?\pWe organize it.\pEverything in its right place.\pEveryone with a clear role.\pIs that really so terrible?")
}

text SteelFactory_1F_Official_Lore3_Text {
    format("The Pokemon working here are fed, sheltered, and given purpose.\pThat's more than most wild Pokemon get.\pIt's not cruelty. It's efficiency.\pAt least... that's what we tell ourselves.")
}

text SteelFactory_1F_Scientist1_Intro {
    format("A trespasser?!\pI'll neutralize you with cold, hard science!")
}

text SteelFactory_1F_Scientist1_Defeat {
    format("Unacceptable.\pMy data... completely disrupted...")
}

text SteelFactory_1F_Scientist1_PostBattle {
    format("How can something that disorganized defeat me?!")
}

text SteelFactory_1F_Scientist2_Intro {
    format("Security breach detected!\pInitiating containment protocol!\pWhich is to say - I will fight you!")
}

text SteelFactory_1F_Scientist2_Defeat {
    format("My containment protocol... failed.\pThis is extremely irregular.")
}

text SteelFactory_1F_Scientist2_PostBattle {
    format("The Rector is going to hear about this data anomaly.")
}

text SteelFactory_1F_Official1_Intro {
    format("Nobody disrupts Faculty operations and walks away, intruder.\pOrder will be maintained!\pStarting with you!")
}

text SteelFactory_1F_Official1_Defeat {
    format("Extraordinary.\pYou've upended three months of production schedules.")
}

text SteelFactory_1F_Official1_PostBattle {
    format("...\pYou'll want to turn around before you reach the upper floors.")
}

text SteelFactory_1F_Official2_Intro {
    format("I don't know who let you in, but your little tour ends here.\pThe Faculty's order demands it!")
}

text SteelFactory_1F_Official2_Defeat {
    format("Chaos wins the battle.\pBut it always loses the war.")
}

text SteelFactory_1F_Official2_PostBattle {
    format("Don't say I didn't warn you.")
}

text SteelFactory_1F_Official3_Intro {
    format("Nobody reaches The Rector's floor without going through me.\pThe Faculty's order demands it.\pAnd I am very orderly.")
}

text SteelFactory_1F_Official3_Defeat {
    format("Impossible.\pYou... you're chaos incarnate.")
}

text SteelFactory_1F_Official3_PostBattle {
    format("The Rector is on the second floor. Face him, if you dare.")
}


text SteelFactory_1F_Panel_Prompt {
    format("POKEMON CONTAINMENT OVERRIDE - EMERGENCY RELEASE -\pDecades of Pokemon are held in these bays, forced to power the facility. Machop, Aron, Magnemite... and something much larger.\pDo you release them?")
}

text SteelFactory_1F_Panel_FreeSequence {
    format("You engage the override.\pA deep rumble moves through the floor.\pThe bay doors grind open.\pOne by one, the Pokemon stir - confused, then alert.\pThey look at you.\pThen they scatter into the vents and corridors, gone in seconds.\pThe machines fall silent.")
}

text SteelFactory_1F_Panel_MewFree {
    format("A soft cry echoes from somewhere deep in the factory walls.\pYou sense something watching.\pSomething that has been watching for a very long time.")
}

text SteelFactory_1F_Panel_Left {
    format("You step back from the panel.\pThe machines keep running.\pThe Pokemon keep working.")
}

text SteelFactory_1F_Panel_MewLeft {
    format("A faint cry carries through the steel walls.\pYou almost missed it.")
}

text SteelFactory_1F_Panel_AlreadyFreed {
    format("The containment bays are open.\pThe Pokemon are free.")
}

text SteelFactory_1F_Panel_AlreadyLeft {
    format("The panel flickers.\pThe Pokemon continue their labor.")
}

text SteelFactory_Wire_Prompt {
    format("A thick cable runs from this machine into the wall.\pIt looks like it keeps something running.\pDisconnect the wire?")
}

text SteelFactory_Wire_AlreadyPulled {
    format("The wire hangs loose from the machine.\pIt's already been disconnected.")
}

text SteelFactory_Wire_NotReady {
    format("A thick cable runs from this machine into the wall.\pYou leave it alone.")
}

text SteelFactory_Wire1_PulledText {
    format("You grip the cable and pull.\pIt comes free with a sharp click.\pThe machine goes dark.")
}

text SteelFactory_Wire2_PulledText {
    format("The cable resists briefly, then snaps free. Click.\pAnother machine falls silent.")
}

text SteelFactory_Wire3_PulledText {
    format("You work the cable loose from its housing. Click.\pThe hum in this corner of the factory dies.")
}

text SteelFactory_Wire4_PulledText {
    format("The thick cable pulls free with a hollow click.\pSomewhere above, a light flickers out.")
}

text SteelFactory_Wire5_PulledText {
    format("The last cable.\pYou pull it free. Click.\pA deep silence falls over the machines around you.")
}

text SteelFactory_AllWires_Text {
    format("A low groan of shifting metal...\pDeep in the factory, something heavy has moved.")
}

text SteelFactory_Aron_Interact_Text {
    format("The Aron glances up at you, then turns back to the machine.")
}

text SteelFactory_AronIntro_Text {
    format("... the small Aron seems stressed.\pIt seems desperate to show you something.\pFollow it? The Rector might escape...")
}

text SteelFactory_AronFollow_Text {
    format("Hmm... must be something with the machine...\pIt's trying to pull something from the machine.\pIt looks like it's trying to disconnect a wire?")
}

text SteelFactory_AronLeave_Text {
    format("The Aron's head droops.\pIt retreats behind some steel beams.\pThe factory keeps humming.")
}

text SteelFactory_AronNextMachine_Text {
    format("The Aron looks pleased. It scurries ahead to the next machine.")
}

text SteelFactory_AronFarewell_Text {
    format("The Aron seems grateful for your help.\pWhat could it be trying to say?\pI think it's wanting me to follow it one last time...")
}
