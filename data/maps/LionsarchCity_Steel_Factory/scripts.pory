// Gate guard - must be defeated before the 2F stairs become accessible
script SteelFactory_1F_Official_Battle3 {
    lock
    faceplayer
    if (flag(FLAG_STEEL_FACTORY_OFFICIAL_3) == TRUE) {
        setspeaker("Faculty Official")
        msgbox(SteelFactory_1F_Official3_After)
        waitmessage
        setspeaker(NULL)
        release
        end
    }
    trainerbattle_single(TRAINER_FACULTY_OFFICIAL_3, SteelFactory_1F_Official3_Intro, SteelFactory_1F_Official3_Defeat, SteelFactory_1F_Official3_Defeated)
    end
}

script SteelFactory_1F_Official3_Defeated {
    lock
    setspeaker("Faculty Official")
    msgbox(SteelFactory_1F_Official3_PostBattle)
    waitmessage
    setspeaker(NULL)
    setflag(FLAG_STEEL_FACTORY_OFFICIAL_3)
    release
    end
}

// ─── CONTROL PANEL - THE CORE CHOICE ───

script SteelFactory_1F_ControlPanel {
    lockall
    if (flag(FLAG_STEEL_FACTORY_CHOICE_MADE) == TRUE) {
        if (flag(FLAG_STEEL_FACTORY_FREED_POKEMON) == TRUE) {
            msgbox(SteelFactory_1F_Panel_AlreadyFreed)
        } else {
            msgbox(SteelFactory_1F_Panel_AlreadyLeft)
        }
        releaseall
        end
    }
    msgbox(SteelFactory_1F_Panel_Prompt, MSGBOX_YESNO)
    if (var(VAR_RESULT) == YES) {
        playfanfare(MUS_OBTAIN_ITEM)
        waitfanfare
        msgbox(SteelFactory_1F_Panel_FreeSequence)
        waitmessage
        setflag(FLAG_STEEL_FACTORY_FREED_POKEMON)
        setflag(FLAG_MEW_SAW_FACTORY_FREED)
        playmoncry(SPECIES_MEW, CRY_MODE_ENCOUNTER)
        waitmoncry
        msgbox(SteelFactory_1F_Panel_MewFree)
        waitmessage
    }
    if (var(VAR_RESULT) == NO) {
        msgbox(SteelFactory_1F_Panel_Left)
        waitmessage
        setflag(FLAG_MEW_SAW_FACTORY_NOT_FREED)
        playmoncry(SPECIES_MEW, CRY_MODE_ENCOUNTER)
        waitmoncry
        msgbox(SteelFactory_1F_Panel_MewLeft)
        waitmessage
    }
    setflag(FLAG_STEEL_FACTORY_CHOICE_MADE)
    releaseall
}

// ─── TEXT ───

text SteelFactory_1F_Scientist_Lore1_Text {
    format("The Regi-Metal alloy is our greatest\lachievement.\pBy replicating the elemental forging\lprocess Regigigas used in Lions Mountains,\lwe create a material that channels\llegendary energy.\pThe Faculty will bring true order to\lTeressa. Diversity has had its chance.\lNow it is structure's turn.")
}

text SteelFactory_1F_Scientist_Lore2_Text {
    format("This is a restricted area!\pLeave immediately or I'm calling\lsecurity!")
}

text SteelFactory_1F_Scientist_Lore3_Text {
    format("The ore from Lions Mountains is unlike\lanything we've catalogued.\pDense with ancient energy.\pThe Pokemon here can sense it -\lit makes them... compliant.\pThat's what the Director calls it.\lCompliant.")
}

text SteelFactory_1F_Scientist_Lore4_Text {
    format("Registeel is the linchpin of the\lwhole operation.\pWithout it, the entire synthesis\lbreaks down.\pThe Director found a way to\lincentivize it.\pI try not to think about the details.")
}

text SteelFactory_1F_Scientist_Lore5_Text {
    format("The electro-magnetic resonance from\lthe Magnemite cluster amplifies the\lmetal's conductivity tenfold.\pAdd Registeel to the equation and\lwe're not just making metal.\pWe're making something the Regis would\lrecognize as their own.")
}

text SteelFactory_1F_Official_Lore1_Text {
    format("Teressa is a beautiful region.\pBut it's wasted on chaos.\pDozens of cultures, dozens of types,\lno cohesion, no direction.\pWe are going to change that.\pOne processed metric ton at a time.")
}

text SteelFactory_1F_Official_Lore2_Text {
    format("The Faculty doesn't destroy diversity.\pWe organize it.\pEverything in its right place.\pEveryone with a clear role.\pIs that really so terrible?")
}

text SteelFactory_1F_Official_Lore3_Text {
    format("The Pokemon working here are fed,\lsheltered, and given purpose.\pThat's more than most wild Pokemon get.\pIt's not cruelty. It's efficiency.\pAt least... that's what we tell\lourselves.")
}

text SteelFactory_1F_Scientist1_Intro {
    format("A trespasser?!\pI'll neutralize you with cold,\lhard science!")
}

text SteelFactory_1F_Scientist1_Defeat {
    format("Unacceptable.\pMy data... completely disrupted...")
}

text SteelFactory_1F_Scientist1_PostBattle {
    format("How can something that disorganized\ldefeat me?!")
}

text SteelFactory_1F_Scientist2_Intro {
    format("Security breach detected!\pInitiating containment protocol!\pWhich is to say - I will fight you!")
}

text SteelFactory_1F_Scientist2_Defeat {
    format("My containment protocol... failed.\pThis is extremely irregular.")
}

text SteelFactory_1F_Scientist2_PostBattle {
    format("The Director is going to hear about\lthis data anomaly.")
}

text SteelFactory_1F_Official1_Intro {
    format("Nobody disrupts Faculty operations\land walks away, intruder.\pOrder will be maintained!\pStarting with you!")
}

text SteelFactory_1F_Official1_Defeat {
    format("Extraordinary.\pYou've upended three months of\lproduction schedules.")
}

text SteelFactory_1F_Official1_PostBattle {
    format("...\pYou'll want to turn around before you\lreach the upper floors.")
}

text SteelFactory_1F_Official2_Intro {
    format("I don't know who let you in, but\lyour little tour ends here.\pThe Faculty's order demands it!")
}

text SteelFactory_1F_Official2_Defeat {
    format("Chaos wins the battle.\pBut it always loses the war.")
}

text SteelFactory_1F_Official2_PostBattle {
    format("Don't say I didn't warn you.")
}

text SteelFactory_1F_Official3_Intro {
    format("Nobody reaches the Director's floor\lwithout going through me.\pThe Faculty's order demands it.\pAnd I am very orderly.")
}

text SteelFactory_1F_Official3_Defeat {
    format("Impossible.\pYou... you're chaos incarnate.")
}

text SteelFactory_1F_Official3_PostBattle {
    format("The Director is on the second floor.\lFace him, if you dare.")
}

text SteelFactory_1F_Official3_After {
    format("...The Director is upstairs.\pJust go.")
}

text SteelFactory_1F_Panel_Prompt {
    format("POKEMON CONTAINMENT OVERRIDE\l- EMERGENCY RELEASE -\pDecades of Pokemon are held in these\lbays, forced to power the facility.\lMachop, Aron, Magnemite...\land something much larger.\pDo you release them?")
}

text SteelFactory_1F_Panel_FreeSequence {
    format("You engage the override.\pA deep rumble moves through the floor.\pThe bay doors grind open.\pOne by one, the Pokemon stir -\lconfused, then alert.\pThey look at you.\pThen they scatter into the vents and\lcorridors, gone in seconds.\pThe machines fall silent.")
}

text SteelFactory_1F_Panel_MewFree {
    format("A soft cry echoes from somewhere deep\lin the factory walls.\pYou sense something watching.\pSomething that has been watching for\la very long time.")
}

text SteelFactory_1F_Panel_Left {
    format("You step back from the panel.\pThe machines keep running.\pThe Pokemon keep working.")
}

text SteelFactory_1F_Panel_MewLeft {
    format("A faint cry carries through the\lsteel walls.\pYou almost missed it.")
}

text SteelFactory_1F_Panel_AlreadyFreed {
    format("The containment bays are open.\pThe Pokemon are free.")
}

text SteelFactory_1F_Panel_AlreadyLeft {
    format("The panel flickers.\pThe Pokemon continue their labor.")
}
