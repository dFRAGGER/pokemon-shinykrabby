mapscripts EastLionMountain_Faculty_Mining_Cave_MapScripts {}

// =====================
// TRAINER SCRIPTS - MINING CAVE ENTRANCE
// 2 Faculty Member Trainers
// =====================

script MiningCave_Trainer_Faculty_Owen {
    trainerbattle_single(TRAINER_OWEN, MiningCave_Text_OwenIntro, MiningCave_Text_OwenDefeated)
    msgbox(MiningCave_Text_OwenPostBattle, MSGBOX_AUTOCLOSE)
    end
}

text MiningCave_Text_OwenIntro {
    format("You made it past the guards outside?\pNo matter. You won't get any further!\pThese sacred grounds belong to the Faculty now!")
}

text MiningCave_Text_OwenDefeated {
    format("The mountain... it trembles with ancient power...")
}

text MiningCave_Text_OwenPostBattle {
    format("Do you know what lies beneath these peaks?\pLong ago, Regigigas itself walked these mountains.\pIt gathered boulders, ice, and molten iron from deep within...\pAnd shaped them into the legendary Golems!\pWith the right materials, we can forge devices to control its creations!")
}

script MiningCave_Trainer_Faculty_Warren {
    trainerbattle_single(TRAINER_WARREN, MiningCave_Text_WarrenIntro, MiningCave_Text_WarrenDefeated)
    msgbox(MiningCave_Text_WarrenPostBattle, MSGBOX_AUTOCLOSE)
    end
}

text MiningCave_Text_WarrenIntro {
    format("Intruder detected!\pI've been trained to deal with troublemakers like you!")
}

text MiningCave_Text_WarrenDefeated {
    format("M-My calculations didn't account for your strength!")
}

text MiningCave_Text_WarrenPostBattle {
    format("The Lion Mountains are unique, you see.\pHard rock, eternal ice, and magma all exist here in close proximity.\pThe same primordial materials Regigigas used to craft its servants!\pOnce we extract enough ore, our control apparatus will be complete!")
}

// =====================
// NPC CONVERSATIONS - MINING CAVE ENTRANCE
// Scientists explaining their operation
// =====================

script MiningCave_Worker1_Convo {
    lock
    faceplayer
    msgbox(format("Keep those sample containers sealed!\pThe Administrator wants this ore analyzed before shipping to the Steel Factory.\pAccording to legend, Regigigas shaped Regirock from these very boulders!"), MSGBOX_AUTOCLOSE)
    release
    end
}

script MiningCave_Worker2_Convo {
    lock
    faceplayer
    msgbox(format("Fascinating... The mineral composition here is unlike anything documented.\pIt resonates at the exact frequency as the Golem relics we've studied.\pRegigigas must have chosen this location specifically for its unique geology!"), MSGBOX_AUTOCLOSE)
    release
    end
}

script MiningCave_Scientist_Convo {
    lock
    faceplayer
    msgbox(format("The ancient texts were right!\pRegigigas, the Colossal Pokemon, created its servants here eons ago.\pRegirock from the mountain's stone, Regice from never-melt ice, Registeel from volcanic iron...\pBy synthesizing these same materials into control devices, we'll bend the Golems to our will!"), MSGBOX_AUTOCLOSE)
    release
    end
}

script MiningCave_Sign_Danger {
    lock
    msgbox(format("DANGER: Active Mining Zone\nHard hats required\nBeware of falling rocks and tremors"), MSGBOX_AUTOCLOSE)
    release
}
