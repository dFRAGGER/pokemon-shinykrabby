script LabJariIndoorF0_Eventscript_DiscoveryStealStarterPokemon_LeftExit {
        lockall
        if(flag(FLAG_RECEIVED_STARTER_CHOICE)) {
        msgbox(format("HEY.........."))
        waitmessage
        msgbox(format("WHAT ARE YOU DOING IN MY LAB??!"))
        waitmessage
        applymovement(LOCALID_PLAYER, moves(emote_exclamation_mark))
        waitmovement
        clearflag (FLAG_PROFESSOR_BIRDS_DISCOVERY)
        addobject (10)
        applymovement (10, moves(walk_fast_right walk_fast_down face_left))
        waitmovement
        applymovement(LOCALID_PLAYER, moves(face_right))
        msgbox(format("GET THE FUCK OUT!!"))
        waitmessage
        fadescreen(FADE_TO_BLACK)
        warpsilent (MAP_ERP_CITY, 0)
        fadescreen (FADE_FROM_BLACK)
        }
        else {
            msgbox(format("Hmmmm, those pokeballs look shiny. Nobody will notice when I take one right?"))
            applymovement(LOCALID_PLAYER, stopplayer)
            waitmovement(0)
        }

        releaseall
}

script LabJariIndoorF0_Eventscript_DiscoveryStealStarterPokemon_RightExit {
        lockall
        if(flag(FLAG_RECEIVED_STARTER_CHOICE)) {
        msgbox(format("HEY.........."))
        waitmessage
        msgbox(format("WHAT ARE YOU DOING IN MY LAB??!"))
        waitmessage
        applymovement(LOCALID_PLAYER, moves(emote_exclamation_mark))
        waitmovement
        clearflag (FLAG_PROFESSOR_BIRDS_DISCOVERY)
        addobject (10)
        applymovement (10, moves(walk_fast_down face_right))
        waitmovement
        applymovement(LOCALID_PLAYER, moves(face_left))
        msgbox(format("GET THE FUCK OUT!!"))
        waitmessage
        fadescreen(FADE_TO_BLACK)
        warpsilent (MAP_ERP_CITY, 0)
        fadescreen (FADE_FROM_BLACK)
        }
        else {
            msgbox(format("Hmmmm, those pokeballs look shiny. Nobody will notice when I take one right?"))
            applymovement(LOCALID_PLAYER, stopplayer)
            waitmovement(0)
        }
        releaseall
}

movement stopplayer {
    walk_down
}
