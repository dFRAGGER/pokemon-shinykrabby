mapscripts LabJariIndoorF0_MapScripts {

}

script ErpusCity_ProfessorBirdsLab_Eventscript_CharmanderSelection {
    lockall
    if(!flag(FLAG_RECEIVED_STARTER_CHOICE)){
    showmonpic(SPECIES_CHARMANDER, 10, 3)
    msgbox(format("Do you want to select Charmander?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == NO) {
        msgbox(format("Lets see what is in the other pokeballs."))
    }
    if(var(VAR_RESULT) == YES) {
        givemon(SPECIES_CHARMANDER, 5)
        playfanfare(MUS_OBTAIN_ITEM)
        setflag(FLAG_SYS_POKEMON_GET)
        setflag(FLAG_RECEIVED_STARTER_CHARMANDER)
        removeobject(9)
        setflag(FLAG_RECEIVED_STARTER_CHOICE)
        bufferspeciesname(STR_VAR_2, SPECIES_CHARMANDER)
        msgbox(gText_UnusedNicknameReceivedPokemon, MSGBOX_YESNO)
        call(Common_EventScript_NameReceivedPartyMon)
    }
    hidemonpic
    }
    else{
        msgbox(format("Better leave quickly.."))
    }
    releaseall

}

