script ErpusCity_ProfessorBirdsLab_Eventscript_Kanto_Sign {
    lockall
    msgbox(format("There seems to be something written on this paper:"))
    waitmessage
    msgbox(format("KANTOOOO!!?"))
    waitmessage
    releaseall
}

