mapscripts EastLionMountain_MapScripts {}

// =====================
// TRAINER SCRIPTS - EAST LION MOUNTAIN
// 2 Faculty Members + 1 Regular Trainer
// =====================

// FACULTY MEMBER 1 - Guards the mining cave entrance
script EastLionMountain_Trainer_Faculty_Albert {
    trainerbattle_single(TRAINER_ALBERT_EAST_LION_SK, EastLionMountain_Text_AlbertIntro, EastLionMountain_Text_AlbertDefeated)
    msgbox(EastLionMountain_Text_AlbertPostBattle, MSGBOX_AUTOCLOSE)
    end
}

text EastLionMountain_Text_AlbertIntro {
    format("Halt! This area is restricted by order of the Faculty!\pOur excavation here is of the utmost importance!")
}

text EastLionMountain_Text_AlbertDefeated {
    format("You... You have no idea what forces you're interfering with!")
}

text EastLionMountain_Text_AlbertPostBattle {
    format("Our permits say mineral extraction.\pThey don't say you can wander into the sealed ice chambers.\pThe freight has already gone down to the steelworks. You're interfering with the cleanup.")
}

// FACULTY MEMBER 2 - Patrols the area
script EastLionMountain_Trainer_Faculty_Samuel {
    trainerbattle_single(TRAINER_SAMUEL_EAST_LION_SK, EastLionMountain_Text_SamuelIntro, EastLionMountain_Text_SamuelDefeated)
    msgbox(EastLionMountain_Text_SamuelPostBattle, MSGBOX_AUTOCLOSE)
    end
}

text EastLionMountain_Text_SamuelIntro {
    format("Another intruder?\pThe Rector will not be pleased with these interruptions!")
}

text EastLionMountain_Text_SamuelDefeated {
    format("Impossible! My calculations were perfect!")
}

text EastLionMountain_Text_SamuelPostBattle {
    format("The oldest ice in this mountain never thawed. Something was resting inside it.\pWe needed a containment frame, not an ore cart.\pThat's all I'm authorized to tell you.")
}

// REGULAR TRAINER - A hiker who witnessed the Faculty
script EastLionMountain_Trainer_Vito {
    trainerbattle_single(TRAINER_VITO_EAST_LION_SK, EastLionMountain_Text_VitoIntro, EastLionMountain_Text_VitoDefeated)
    if(flag(FLAG_HIDE_FACULTY_AT_WESTLION_MINE)){
        msgbox(EastLionMountain_Text_VitoPostBattle_After, MSGBOX_AUTOCLOSE)
    } else {
        msgbox(EastLionMountain_Text_VitoPostBattle, MSGBOX_AUTOCLOSE)
    }
    end
}

text EastLionMountain_Text_VitoIntro {
    format("Hey, you look like someone who can handle themselves!\pI've been too scared to go near that cave alone.\pLet me test your strength first!")
}

text EastLionMountain_Text_VitoDefeated {
    format("Wow, you're the real deal!")
}

text EastLionMountain_Text_VitoPostBattle {
    format("Those people in the suits have been drilling through ancient ice, day and night.\pThe tremors get worse every time they start the machines.\pYesterday a sealed load came down the trail. No loose stone. No ore dust.\pWhy does a mining company need guards around a single piece of freight?")
}

text EastLionMountain_Text_VitoPostBattle_After {
    format("Those brown-suited folks are gone!\pI finally worked up the nerve to walk past that cave entrance.\pWhatever went on in there... I'm just glad it's over.")
}

// =====================
// NPC CONVERSATIONS - EAST LION MOUNTAIN
// =====================

script EastLionMountain_Worried_Hiker_Convo {
    lock
    faceplayer
    if(flag(FLAG_HIDE_FACULTY_AT_WESTLION_MINE)){
        msgbox(format("The drilling crews have left.\pBut a sealed transport went down to the factory before they packed up.\pMy grandfather told me a guardian slept in the old ice.\pI wish I knew whether it was still there."), MSGBOX_AUTOCLOSE)
    } else {
        msgbox(format("I've lived near these mountains my whole life.\pMy grandfather told me stories about Regigigas creating guardians here.\pIt shaped them from the mountain's stone, ice, and volcanic iron...\pIf those suited folks really found a way to control those ancient beings..."), MSGBOX_AUTOCLOSE)
    }
    release
    end
}

script EastLionMountain_Scared_Woman_Convo {
    lock
    faceplayer
    if(flag(FLAG_HIDE_FACULTY_AT_WESTLION_MINE)){
        msgbox(format("The tremors stopped!\pNot a single one since those researchers packed up and left.\pI actually slept through the night for the first time in weeks.\pThank you, whoever you are!"), MSGBOX_AUTOCLOSE)
    } else {
        msgbox(format("My house down in the valley has been shaking every few hours!\pThe tremors started when those 'researchers' began drilling through the old ice.\pThey say their mining permit covers it.\pDoes it cover bringing the mountain down on us too?"), MSGBOX_AUTOCLOSE)
    }
    release
    end
}

script EastLionMountain_Sign_MiningCave {
    lock
    msgbox(format("Faculty Excavation Site\nAuthorized Personnel Only\n...This sign looks recently installed."), MSGBOX_AUTOCLOSE)
    release
}
