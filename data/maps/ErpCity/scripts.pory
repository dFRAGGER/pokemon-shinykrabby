mapscripts ErpCity_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setflag(FLAG_KICKED_OUT_LAB_CONVO)
        setflag(FLAG_HIDE_MOM_SHOES)
        call (ErpCity_Visited)
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_RECIEVED_STARTER_POKEMON, 1: ErpCity_ProfessorBirds_Speech_Pokedex
    ]
    
}

script ErpCity_Visited {
    setflag(FLAG_VISITED_ERP_CITY)
}

script ErpCity_ProfessorBirds_Speech_Pokedex {
    lockall
    applymovement (LOCALID_PLAYER, moves(walk_fast_left jump_left face_right))
    clearflag(FLAG_KICKED_OUT_LAB_CONVO)
    addobject(2)
    addobject(5)
    applymovement(2, moves(walk_fast_down walk_fast_left))
    applymovement(5, moves(walk_down*2 face_left))
    waitmovement
    msgbox(format("WHO DO YOU THINK YOU ARE? TAYLOR SWIFT OR SOMETHING?\pActually.... I love Taylor Swift hehe.. ANYWAYS!!\pI TOLD YOU TO NOT SNIFF AROUND IN MY SECRET LA... I MEAN STORAGE ROOM!!\p...YOU DIDN'T STEAL ANYTHING RIGHT? RIGHT??!!\pIT DOESN'T REALLY MATTER ANYWAYS, YOU ARE FIRED!!\pI GOT MY SQUIRKY LITTLE INTERN CALLED BARRY ALREADY, HE IS LIVING THE DREAM..."),MSGBOX_AUTOCLOSE)
    waitmessage
    playse(SE_PIN)
    applymovement(5, moves(emote_question_mark))
    waitmovement
    delay(60)
    playse(SE_PIN)
    applymovement(2, moves(emote_question_mark))
    msgbox(format(".....wait a second....\p.....maybe this little slob can help me to get some data....\p.....yes a very good idea Jari, very smart...."),MSGBOX_AUTOCLOSE)
    waitmessage
    delay(40)
    playse(SE_PIN)
    applymovement (2, moves(emote_exclamation_mark))
    msgbox(format(".....DID I SAY THAT OUT LOUD?\pARGH ANYWAYS, HOW ABOUT I REHIRE YOU AGAIN TO BECOME MY DATA HOARDER....\pI MEAN MY FELLOW RESEARCHER OFCOURSE! MY BELOVED PARTNER!\pTO BECOME A REAL POKEMON MASTER WE... I MEAN YOU... NEED TO CATCH EVERY POKEMON\pAND SCAN THEM WITH THIS LITTLE DEVICE...."))
    waitmessage
    setflag(FLAG_SYS_POKEDEX_GET)
    setflag(FLAG_SYS_NATIONAL_DEX)
    msgbox(format("You have received the Pokédex."))
    playfanfare(MUS_OBTAIN_ITEM)
    waitfanfare
    waitmessage
    msgbox(format("THIS DEVICE CAN COLLECT VITAL DATA ON POKEMON HABITATS, MIGRATION PATTERNS AND ...uh...\pUNIQUE GENOMIC SIGNATURES... FOR THE PIGS... you know...\pAND THIS WAY I WILL EXTRACT ALL NECESSARY INFORMATION FOR MY BELOVED SECRET TECHNOLO.... SENSORS FOR RESPONSIBLE PIG FARMING.\pNOW GO, AND DON'T COME BACK BEFORE YOU HAVE SCANNE... I MEAN CAUGHT SOME POKEMONS.\pWHAT DO YOU MEAN... HOW?\pJUST USE POKEBALLS....\p A POKEMON MASTER HAHAHA...\pYOU GOT TO BE JOKING"))
    waitmessage
    giveitem(ITEM_POKE_BALL, 5)
    waitmessage
    msgbox(format("THROW THESE MOTHERFUCKERS, AND THE WORLD WILL BE MINE... I MEAN OURS"))
    waitmessage
    playse(SE_PIN)
    applymovement(LOCALID_PLAYER, moves(emote_question_mark))
    applymovement(2, moves(emote_question_mark))
    applymovement(LOCALID_PLAYER, moves(face_right))
    applymovement(2, moves(face_right))
    waitmovement
    delay(40)
    applymovement(5, moves(walk_fast_left face_up))
    applymovement(2, moves(face_down))
    waitmovement
    msgbox(format("HE BREAKS INTO YOUR LAB AND GETS A POKEDEX, POKEBALLS AND A MISSION TO BECOME A POKEMON MASTER?\pWHAT DID I GET?\p A FUCKING MAGIKARP?\pTHE MOST USELESS POKEMON EVER IN EXISTENCE?\pI QUIT!!\p FUCK YOU!!"))
    waitmessage
    applymovement(5, moves(walk_fast_left face_up))
    applymovement(LOCALID_PLAYER, moves(face_down))
    waitmovement
    msgbox(format("...\pYOU??\pA POKEMON MASTER?\pDON'T LET ME LAUGH\pI WILL TAKE EVERY CHANCE TO PREVENT THAT FROM HAPPENING!"))
    waitmessage
    playse(SE_PIN)
    applymovement(LOCALID_PLAYER, moves(emote_question_mark face_left))
    applymovement(2, moves(face_left))
    applymovement(5, moves(walk_fast_left*8))
    waitmovement
    removeobject(5)
    setflag (FLAG_KICKED_OUT_LAB_CONVO)
    setvar(VAR_RECIEVED_STARTER_POKEMON, 2)
    clearflag(FLAG_HIDE_INTERN_BIRDS_LAB)
    msgbox(format("...I'd probably should search for another intern right now..."),MSGBOX_AUTOCLOSE)
    waitmessage
    delay(40)
    applymovement(LOCALID_PLAYER, moves(face_right))
    waitmovement
    msgbox(format("OH BY THE WAY... I HAVE AN OLD FRIEND IN THE NEXT TOWN WHO COULD HELP YOU CATCH A WONDERFULL SPECIE...\pHIS NAME IS JAKUB... HE USED TO LIVE IN THIS TOWN... BUT THE TRAITOR MOVED TO MAASJE...\pNOW WHAT ARE YOU WAITING FOR!?\pGET THAT DATA FOR ME... I MEAN US.\p AND STAY AWAY FROM MISPOES...\p HE DOESN'T LIKE ME...\p I MEAN YOU OFCOURSE!!"),MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(LOCALID_PLAYER, moves(jump_left face_left))
    waitmovement
    applymovement(2, moves(walk_right walk_up))
    waitmovement
    removeobject(2)
    applymovement(LOCALID_PLAYER, moves(face_right))
    waitmovement
    delay(60)
    applymovement(LOCALID_PLAYER, moves(face_down))
    waitmovement
    delay(60)
    applymovement(LOCALID_PLAYER, moves(face_left))
    waitmovement
    delay(60)
    specialvar(VAR_RESULT,ScriptGetPartyMonSpecies)
    special(BufferMonNickname)
    msgbox(format("...I think it is safe to come out now {STR_VAR_1}, lets get out of here!"),MSGBOX_AUTOCLOSE)
    releaseall
}

script ErpCity_ProfessorBirds_After_Speech {
    lockall
    msgbox(format("WELL, WHAT ARE YOU WAITING FOR?\p GET THAT DATA FOR ME... I MEAN US."))
    waitmessage
    releaseall
}

script ErpCity_Mispoes_Miauw {
    lockall
    msgbox(format("Mispoes: Miaaaauw... KSSSSJSJJGGGG"))
    waitmessage
    releaseall
}

script ErpCity_Lab_Sign {
    lockall
    msgbox(format("Professor Birds's Lab"))
    waitmessage
    releaseall
}

script ErpCity_Hiker_Cave {
    lockall
    applymovement(5, moves(face_player)    
    )
    msgbox(format("The cave is not accessible at this time.\p Recent tremors from a unknown source have caused massive rock slides.\p The path is to dangerous."))
    waitmessage
    releaseall
}

script ErpCity_Cave_Sign {
    lockall
    msgbox(format("A large map with a labyrint of routes going through the cave.\p Most of them are crossed out."))
    waitmessage
    releaseall
}

script ErpCity_Trigger_Stopplayer {
    lockall
    msgbox(format("Wandering without any pokemon might be dangerous...."))
    applymovement(LOCALID_PLAYER, ErpCity_Move_Stopplayer)
    waitmovement(0)
    releaseall
}

movement ErpCity_Move_Stopplayer {
    walk_right
}

script ErpCity_Trigger_Stopplayer2 {
    lockall
    msgbox(format("Mom said the lab was up north I think..."))
    applymovement(LOCALID_PLAYER, moves(walk_left))
    waitmovement(0)
    releaseall
}

script ErpCity_Receive_Running_Shoes {
    lockall
    if(flag(FLAG_RECEIVED_RUNNING_SHOES)==FALSE){
    applymovement(LOCALID_PLAYER, moves(emote_exclamation_mark face_up))
    waitmovement
    clearflag(FLAG_HIDE_MOM_SHOES)
    addobject(4)
    applymovement(4, moves(walk_down face_player))
    waitmovement
    msgbox(format("Honey, I almost forgot!\pIf you want to make an impression on the professor you should wear some different shoes.\pAs a surprise I've bought a new pair for you!"))
    waitmessage
    setflag(FLAG_RECEIVED_RUNNING_SHOES)
    msgbox(format("You have received running shoes from Mom."))
    playfanfare(MUS_OBTAIN_ITEM)
    waitfanfare
    waitmessage
    msgbox(format("Look at you, all nice and shiny.\p Say hello to the professor for me.\p Have fun!"),MSGBOX_AUTOCLOSE)
    waitmessage
    delay(60)
    msgbox(format("Well, go on!\nDon't be shy!"), MSGBOX_AUTOCLOSE)
    waitmessage
    delay(40)
    applymovement(LOCALID_PLAYER, moves(walk_down))
    waitmovement
    msgbox(format("There you go!\nI'll see you at dinner!"))
    waitmessage
    applymovement(4, moves(walk_up))
    waitmovement
    setflag(FLAG_HIDE_MOM_SHOES)
    setflag(FLAG_SYS_B_DASH)
    setflag(FLAG_HIDE_INTERN_BIRDS_LAB)
    removeobject(4)
    releaseall
    end
    }
    else{
        msgbox(format("Better get to the lab, Mom probably won't let me in if I don't try."))
        waitmessage
        applymovement(LOCALID_PLAYER, moves(walk_down))
        waitmovement
        releaseall
        end
    }
}