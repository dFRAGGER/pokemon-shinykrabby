mapscripts LionsarchCity_Indoor_PeterBasementParty_MapScripts {}

// The secret disco basement club

script DiscoBasement_DJ_Peter {
    lock
    faceplayer
    setspeaker("DJ Peter")
    // Check if player has delivered the package
    if (flag(FLAG_DELIVERED_ALIS_PACKAGE_TO_PETER)) {
        // Already delivered, check if got Dancing Boots
        if (flag(FLAG_RECEIVED_CLIMBING_ROPE)) {
            setspeaker("DJ Peter")
            if (flag(FLAG_STEEL_FACTORY_COMPLETE)) {
                if (flag(FLAG_PETER_GAVE_FACTORY_REWARD)) {
                    msgbox(format("Seriously, you did it.\pThe Faculty's gone, the factory's quiet, and I can finally breathe again.\pParty's louder than ever down here.\pThat's all thanks to you."))
                } else {
                    msgbox(format("You actually did it.\pI didn't think... I mean, I KNEW you could do it.\pBut still.\pThe Faculty. Gone. From my city."))
                    waitmessage
                    setspeaker("DJ Peter")
                    msgbox(format("Do you know what this means for me?\pI can go back to running this place full time.\pParties every night.\pNo more looking over my shoulder.\pFree to... you know.\pSmuggle.\p...\pI mean PARTY.\pFull time partying.\pThat's what I said."))
                    waitmessage
                    setspeaker("DJ Peter")
                    msgbox(format("Look, I owe you.\pI had this stashed away for a while.\pGot it the hard way, if you know what I mean.\pThere was a period in my life where I ran a little... HOT.\pToo hot.\pLike, everything-on-fire-including-myself hot.\pNot my proudest chapter."))
                    waitmessage
                    setspeaker("DJ Peter")
                    msgbox(format("Point is, I learned a thing or two about Overheat.\pNot the kind you want to experience personally, trust me.\pBut the kind your Pokemon can actually USE?\pThat's a different story.\pHere. Take the TM.\pYou'll do more good with it than I ever did."))
                    waitmessage
                    giveitem(ITEM_TM38)
                    setflag(FLAG_PETER_GAVE_FACTORY_REWARD)
                    setspeaker("DJ Peter")
                    msgbox(format("Now get back out there.\pAnd hey... stay funky."))
                }
            } elif (flag(FLAG_STEEL_FACTORY_TUNNEL_OPEN)) {
                msgbox(format("Welcome back to the GROOVE ZONE!\pYou making progress in there?\pThat factory's been giving me the creeps for years.\pGood to know someone's finally poking around."))
            } elif (flag(FLAG_PETER_GAVE_TUNNEL_PERMISSION)) {
                msgbox(format("Tunnel's still open on our end.\pPaolo will let you through.\pGet in there and find out what they're really building."))
            } elif (flag(FLAG_HIDE_FACULTY_AT_WESTLION_MINE)) {
                msgbox(format("Hey... you're back.\pYou've got that look.\pLike you've just been somewhere you weren't supposed to be.\p...What happened?"))
                waitmessage
                setspeaker("DJ Peter")
                msgbox(format("...\pThey pushed you into a CREVASSE?!\pI always knew the Faculty played dirty.\pBut throwing someone into a pit..."))
                waitmessage
                setspeaker("DJ Peter")
                msgbox(format("And they've already moved everything to the factory.\pThis is escalating faster than I thought."))
                waitmessage
                setspeaker("DJ Peter")
                msgbox(format("I've been watching those people dig into those mountains for months.\pEvery week the shipments get bigger.\pEvery week the tremors get worse."))
                waitmessage
                setspeaker("DJ Peter")
                msgbox(format("I can't sit on this anymore.\pYou need to get into that factory.\pLuckely I know a way in that the Faculty doesn't."))
                waitmessage
                setspeaker("DJ Peter")
                msgbox(format("There's a tunnel running from this basement straight to the factory's lower level.\pOld smuggling route.\pThe Faculty thinks they sealed their end years ago.\pThey didn't seal ours."))
                waitmessage
                setspeaker("DJ Peter")
                msgbox(format("Paolo guards the entrance down here.\pI'll tell him you have my blessing to go through.\pGet in there.\pFind out what they're really building.\pAnd be careful."))
                waitmessage
                setflag(FLAG_PETER_GAVE_TUNNEL_PERMISSION)
                setflag(FLAG_HIDE_RECTOR_ELECTABUZZ_AFTER_BATTLE)
            } else {
                msgbox(format("Hey, you're still kicking around Lionsarch!\pGood to see you.\pSomething's been feeling off up in those mountains lately.\pStay funky out there."))
            }
        } else {
            // This shouldn't happen, but handle it
            setspeaker("DJ Peter")
            msgbox(format("Hey, thanks again for the delivery!\pDon't forget you've still got those boots of mine!"))
        }
    } elif (checkitem(ITEM_SOOT_SACK, 1)) {
        // Player has the package from Ali
        setspeaker("DJ Peter")
        msgbox(format("Wait... that smell...\pIs that what I think it is?"))
        waitmessage
        setspeaker("DJ Peter")
        msgbox(format("You brought the goods from Ali!\pMy man! This is exactly what I needed!\pThe party can really get started now!"))
        waitmessage
        removeitem(ITEM_SOOT_SACK, 1)
        setflag(FLAG_DELIVERED_ALIS_PACKAGE_TO_PETER)
        setspeaker("DJ Peter")
        msgbox(format("Let me return the favor - first round of dancing is on the house!"))
        waitmessage
        setspeaker("DJ Peter")
        msgbox(format("...\pNo?\pYou don't want to dance?\pYou've got that look.\pSomeone with places to be.\pTough crowd!"))
        waitmessage
        setspeaker("DJ Peter")
        msgbox(format("Alright, let me return the favor another way.\pWhen I first rolled into Lionsarch, I had nothing.\pNo gig, no place, no plan.\pJust a pair of boots and a whole lot of nerve."))
        waitmessage
        setspeaker("DJ Peter")
        msgbox(format("Nights I'd dance in 'em right here on this floor.\pDays I'd climb the Lion Mountains in the same pair.\pUp those rocky ridges before the sun got too high.\pSame boots. Same rhythm. Different terrain."))
        waitmessage
        setspeaker("DJ Peter")
        msgbox(format("I got new ones eventually.\pBut these old ones deserve someone who'll actually use 'em.\pHere. Take 'em.\pThey'll get you places."))
        waitmessage
        giveitem(ITEM_CLIMBING_ROPE)
        setflag(FLAG_RECEIVED_CLIMBING_ROPE)
        setspeaker("DJ Peter")
        msgbox(format("Come back sometime, yeah?\pThere's more down here than just good music.\pYou talk to the right people... you'd be surprised what doors open."))
        waitmessage
        setspeaker("DJ Peter")
        msgbox(format("Now get out there.\pAnd remember... stay funky!"))
    } else {
        // Normal dialogue
        setspeaker("DJ Peter")
        msgbox(format("Welcome to the GROOVE ZONE!\pThis is where the real party happens!\pOld school disco, baby!\pNone of that modern stuff - just pure, unadulterated FUNK!"))
    }
    waitmessage
    release
}

// Guard near the DJ stage - grants access after hearing about Ali's stash
script DiscoBasement_Guard_DJStage {
    lock
    getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
    faceplayer
    setspeaker("Bouncer Carlo")
    if (flag(FLAG_BASEMENT_DJ_STAGE_ACCESS)) {
        msgbox(format("Alright, you're cool.\pOur VIPs can go where ever they want.\pEnjoy the party!"))
        applymovement(10, moves(walk_right face_left))
        if(var(VAR_TEMP_0) == 21 && var(VAR_TEMP_1) == 5){
            applymovement(LOCALID_PLAYER, moves(walk_right walk_up))
            waitmovement
            applymovement(10, moves(walk_left face_down))
        }
        elif(var(VAR_TEMP_0) == 22 && var(VAR_TEMP_1) == 6){
            applymovement(LOCALID_PLAYER, moves(walk_up*2))
            waitmovement
            applymovement(10, moves(walk_left face_down))
        }
        elif(var(VAR_TEMP_0) == 22 && var(VAR_TEMP_1) == 4){
            applymovement(LOCALID_PLAYER, moves(walk_down*2))
            waitmovement
            applymovement(10, moves(walk_left face_down))
        }
        waitmovement
    } elif (checkitem(ITEM_SOOT_SACK, 1)) {
        setspeaker("Bouncer Carlo")
        msgbox(format("Hey, hold up.\pNobody gets past me without clearance.\p..."))
        waitmessage
        setspeaker("Bouncer Carlo")
        msgbox(format("Wait... is that Ali's stash you're carrying?\pI can smell it from here!\pDamn, that's the good stuff!"))
        waitmessage
        setspeaker("Bouncer Carlo")
        msgbox(format("Alright, you're clearly here on business.\pPeter's gonna want to see you.\pGo on through, VIP access granted!"))
        waitmessage
        setflag(FLAG_BASEMENT_DJ_STAGE_ACCESS)
        setspeaker("Bouncer Carlo")
        msgbox(format("Tell Peter I said what's up!"))
        applymovement(10, moves(walk_right face_left))
        if(var(VAR_TEMP_0) == 21 && var(VAR_TEMP_1) == 5){
            applymovement(LOCALID_PLAYER, moves(walk_right walk_up))
            waitmovement
            applymovement(10, moves(walk_left face_down))
        }
        elif(var(VAR_TEMP_0) == 22 && var(VAR_TEMP_1) == 6){
            applymovement(LOCALID_PLAYER, moves(walk_up*2))
            waitmovement
            applymovement(10, moves(walk_left face_down))
        }
        elif(var(VAR_TEMP_0) == 22 && var(VAR_TEMP_1) == 4){
            applymovement(LOCALID_PLAYER, moves(walk_down*2))
            waitmovement
            applymovement(10, moves(walk_left face_down))
        }
        waitmovement
    } else {
        setspeaker("Bouncer Carlo")
        msgbox(format("Hey, VIP area only past this point.\pNo entry without clearance from the boss.\pYou want in? Talk to someone who knows someone."))
    }
    waitmessage
    release
}

// Guard near entrance - talks about the smuggling tunnel
script DiscoBasement_Guard_Tunnel {
    lockall
    faceplayer
    setspeaker("Bouncer Paolo")
    if (flag(FLAG_STEEL_FACTORY_TUNNEL_OPEN)) {
        msgbox(format("Peter said to let you through.\pWatch yourself in there.\pThe Faculty doesn't take kindly to uninvited guests."), MSGBOX_AUTOCLOSE)
        waitmessage
        releaseall
        end
    }
    if (flag(FLAG_PETER_GAVE_TUNNEL_PERMISSION)) {
        msgbox(format("Just got the clearance over the radio from Peter.\pSaid you did him a solid.\pHe asked me to let you through the tunnel, the keys are in the door.\p Be careful in there, alright?"), MSGBOX_AUTOCLOSE)
        waitmessage
        setflag(FLAG_STEEL_FACTORY_TUNNEL_OPEN)     
        releaseall
        end
    }
    msgbox(format("You see that old tunnel over there?\pIt used to run all the way to the Iron Factory.\pBack in the day, it was a smuggling route.\pDirect link from the harbor, if you know what I mean."))
    waitmessage
    setspeaker("Bouncer Paolo")
    msgbox(format("Used to move all kinds of... 'merchandise' through there.\pNo customs, no questions asked.\pThe good old days, you know?"))
    waitmessage
    setspeaker("Bouncer Paolo")
    msgbox(format("But then the Faculty took over the factory.\pThey sealed the whole thing up.\pNow only Peter and the Faculty have the keys.\pRest of us are locked out for good.\pPeter told me to not let anyone near it, so... here I am, doing my part to keep the secrets safe."), MSGBOX_AUTOCLOSE)
    waitmessage
    releaseall
}

