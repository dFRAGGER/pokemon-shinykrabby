// Another guard staring at the dancers together with machoke
script DiscoBasement_Guard_Staring {
    lockall
    faceplayer
    setspeaker("Bouncer Marco")
    msgbox(format("Man, look at those dancers go!\pPeter really knows how to throw a party!\pI could watch them dance all night!"))
    waitmessage
    releaseall
}
// Giel watching the girls and getting rejected
script DiscoBasement_Giel {
    lock
    getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
    faceplayer
    setspeaker("Giel")
    if (flag(FLAG_GIEL_LEFT_BASEMENT)) {
        // This shouldn't trigger as Giel should be gone
        releaseall
        end
    }
    setspeaker("Giel")
    msgbox(format("Oh hey, it's you!\pSmall world, right?\pI got here way faster than you.\pI know people, you see. Connections."))
    waitmessage
    setspeaker("Giel")
    msgbox(format("When you mentioned Lionsarch City back in Siltroot Town, I got inspired.\pThought I'd check out the scene here.\pMaybe meet some intellectuals who appreciate fine conversation."))
    waitmessage
    // Look at the girls
    applymovement(7, moves(face_left))
    waitmovement
    if(var(VAR_TEMP_0) == 16 && var(VAR_TEMP_1) == 8){
        applymovement(LOCALID_PLAYER, moves(walk_down walk_right face_left))
    }
    
    delay(30)
    setspeaker("Giel")
    msgbox(format("See those lovely ladies over there?\pI've been trying to impress them with my knowledge.\pWatch this!"), MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(7, moves(walk_left))
    waitmovement
    
    setspeaker("Giel")
    msgbox(format("Hey Ladies!!\pDid you know about the historical conflicts in the Kanto region?\pFascinating stuff, really.\pThe war between Celadon and Saffron...\pThe trade disputes of Vermilion Harbor...\pClassic historical drama!"), MSGBOX_AUTOCLOSE)
    waitmessage
    // Girl 1 pushes back
    playse(SE_PIN)
    applymovement(4, moves(emote_exclamation_mark face_right))
    waitmovement
    setspeaker(NULL)
    msgbox(format("Ugh, this guy again?\pNobody wants to hear about ancient wars!\pWe're trying to DANCE here!"))
    waitmessage
    playse(SE_PIN)
    applymovement(5, moves(emote_exclamation_mark face_right))    
    waitmovement
    msgbox(format("Seriously, take the hint!\pYou've been hovering around us all night!\pSo creepy!"))
    waitmessage
    playse(SE_PIN)
    applymovement(6, moves(emote_exclamation_mark face_right))
    waitmovement
    msgbox(format("Security! Can someone get this weirdo away from us?!"), MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(7, moves(walk_right face_player))
    waitmovement    
    getplayerxy(VAR_TEMP_0, VAR_TEMP_1)    
    setspeaker("Giel")
    msgbox(format("FINE!\pI see how it is!\pYou just can't appreciate intellectual discourse!\pThis is what's wrong with society today!"))
    waitmessage
    setspeaker("Giel")
    msgbox(format("Women just don't appreciate a man who understands history!\pI try to share my knowledge and THIS is the thanks I get?!"))
    waitmessage
    setspeaker("Giel")
    msgbox(format("I'm done with this city!\pThe disco scene here is TERRIBLE anyway!\pI'm going back to Hezik City where people actually have CULTURE!"),MSGBOX_AUTOCLOSE)
    waitmessage
    // Giel storms out
    if(var(VAR_TEMP_0) == 17 && var(VAR_TEMP_1) == 9){
        applymovement(LOCALID_PLAYER, moves(jump_right face_down))
    }
    applymovement(LOCALID_PLAYER, moves(face_down))
    applymovement(7, moves(walk_down*6))
    waitmovement
    setflag(FLAG_GIEL_LEFT_BASEMENT)
    removeobject(7)
    // Girls go back to dancing
    applymovement(4, moves(face_up))
    applymovement(5, moves(face_up))
    applymovement(6, moves(face_up))
    waitmovement    
    release
}

