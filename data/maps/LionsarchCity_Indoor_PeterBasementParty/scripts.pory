script DiscoBasement_TunnelEntrance_Check {
    if (flag(FLAG_STEEL_FACTORY_TUNNEL_OPEN)) {
        end
    }
    lockall
    playse(SE_PIN)
    applymovement(13, moves(emote_exclamation_mark))
    waitmovement
    setspeaker("Bouncer Paolo")
    msgbox(format("Hey! You can't just walk in there.\pThat tunnel is off-limits.\pIf you want access, talk to me first."), MSGBOX_AUTOCLOSE)
    applymovement(LOCALID_PLAYER, moves(walk_up))
    waitmovement
    releaseall
    end
}

script DiscoBasement_SecretEntrance {
    lockall
    msgbox(format("A discrete entrance hidden behind a bookshelf upstairs.\pVery clever!"))
    releaseall
}
