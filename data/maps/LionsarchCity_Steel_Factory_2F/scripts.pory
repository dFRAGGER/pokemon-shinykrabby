}

text SteelFactory_2F_Scientist1_Defeat {
    format("Impossible.\pMy calculations were... flawless.")
}

text SteelFactory_2F_Scientist1_PostBattle {
    format("Keep moving.\pYou've already disrupted weeks of research.")
}

text SteelFactory_2F_Grunt_Intro {
    format("Nobody gets past this floor without FACULTY clearance.\pThat means you.")
}

text SteelFactory_2F_Grunt_Defeat {
    format("How...?\pYou're just a kid!")
}

text SteelFactory_2F_Grunt_PostBattle {
    format("THE RECTOR's going to hear about every single one of you.")
}

text SteelFactory_2F_Scientist2_Intro {
    format("Turn around.\pThis floor is restricted.\pI won't ask twice.")
}

text SteelFactory_2F_Scientist2_Defeat {
    format("My containment protocol...\pIt failed.")
}

text SteelFactory_2F_Scientist2_PostBattle {
    format("You'll regret reaching THE RECTOR.")
}

// ─── 2F LORE NPCS ───

script SteelFactory_2F_Scientist_Lore1 {
    lockall
    faceplayer
    msgbox(SteelFactory_2F_Scientist_Lore1_Text)
    releaseall
}

text SteelFactory_2F_Scientist_Lore1_Text {
    format("This floor handles Faculty coordination.\pTHE RECTOR reviews all field reports personally.\pWe don't get many... visitors.")
}

// ─── RECTOR FALLBACK (direct NPC touch) ───

script SteelFactory_2F_Rector_Fallback {
    lockall
    getplayerxy(VAR_TEMP_2, VAR_TEMP_3)
    if (var(VAR_TEMP_2) == 8 && var(VAR_TEMP_3) == 21) {
        applymovement(LOCALID_PLAYER, moves(walk_right walk_down face_left))
        waitmovement
    }
    if (var(VAR_TEMP_2) == 9 && var(VAR_TEMP_3) == 22) {
        applymovement(LOCALID_PLAYER, moves(face_left))
        waitmovement
    }
    if (var(VAR_TEMP_2) == 8 && var(VAR_TEMP_3) == 23) {
        applymovement(LOCALID_PLAYER, moves(walk_right walk_up face_left))
        waitmovement
    }
    faceplayer
    if (flag(FLAG_STEEL_FACTORY_RECTOR_DEFEATED) == TRUE) {
        setspeaker("The Rector")
        msgbox(SteelFactory_2F_Rector_After)
        waitmessage
        setspeaker(NULL)
        releaseall
        end
    }
    if (flag(FLAG_STEEL_FACTORY_RECTOR_CUTSCENE_TRIGGERED) == TRUE) {
        setspeaker("The Rector")
        msgbox(SteelFactory_2F_Rector_WaitingLine)
        waitmessage
        setspeaker(NULL)
        trainerbattle_no_intro(TRAINER_FACULTY_RECTOR, SteelFactory_2F_Rector_BattleDefeat)
        call(SteelFactory_2F_Rector_Defeated)
        releaseall
        end
    }
    releaseall
    end
}

// ─── OVERHEARD CONVERSATION CUTSCENE ───

script SteelFactory_2F_OverhearCutscene {
    if (flag(FLAG_STEEL_FACTORY_RECTOR_DEFEATED) == TRUE) { end }
    if (flag(FLAG_STEEL_FACTORY_RECTOR_CUTSCENE_TRIGGERED) == TRUE) { end }
    setflag(FLAG_STEEL_FACTORY_RECTOR_CUTSCENE_TRIGGERED)
    setvar(VAR_TEMP_0, 1)
    lockall
    getplayerxy(VAR_TEMP_1, VAR_TEMP_2)
    if (var(VAR_TEMP_1) == 13 && var(VAR_TEMP_2) == 16) {
        applymovement(LOCALID_PLAYER, moves(walk_right face_down))
        waitmovement    
    }
    special(SpawnCameraObject)
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_down*6 walk_left*5))
    waitmovement

    // ── Rector opens the meeting ──
    setspeaker("THE RECTOR")
    msgbox(SteelFactory_2F_Rector_OpensMeeting)
    waitmessage

    // ── ConRector: iron ore / Lairon report ──
    applymovement(8, moves(walk_up))
    if (flag(FLAG_STEEL_FACTORY_FREED_POKEMON) == TRUE) {
        setspeaker("THE CONRECTOR")
        msgbox(SteelFactory_2F_Conrector_LaironsFreed,MSGBOX_AUTOCLOSE)
        waitmessage
    } else {
        setspeaker("THE CONRECTOR")
        msgbox(SteelFactory_2F_Conrector_LaironsGood,MSGBOX_AUTOCLOSE)
        waitmessage
    }
    applymovement(8, moves(walk_down face_up))
    delay(60)

    // ── Rector suggests electric shocks for Magikarp ──
    applymovement(2, moves(walk_up))
    setspeaker("THE RECTOR")
    msgbox(SteelFactory_2F_Rector_ShockSuggestion,MSGBOX_AUTOCLOSE)
    waitmessage
    playse(SE_PIN)
    applymovement(2, moves(face_down emote_question_mark))
    delay(120)

    // ── Barry hesitates and declines with pathetic excuse ──
    applymovement(2, moves(face_up))
    setspeaker("BARRY")
    msgbox(SteelFactory_2F_Barry_ShockDecline,MSGBOX_AUTOCLOSE)
    waitmessage
    delay(60)

    // ── Barry: mining report ──
    setspeaker("BARRY")
    msgbox(SteelFactory_2F_Barry_MiningReport,MSGBOX_AUTOCLOSE)
    waitmessage

    // ── Pan back to player, player steps in ──
    setspeaker(NULL)
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_right*5 walk_up*6))
    waitmovement
    special(RemoveCameraObject)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(walk_down*5 walk_left*2))
    waitmovement
    playse(SE_PIN)
    applymovement(1, moves(face_right emote_question_mark))
    applymovement(2, moves(face_right emote_double_exclamation_mark))
    applymovement(8, moves(face_right emote_question_mark))


    // ── Rector confrontation ──
    setspeaker("THE RECTOR")
    msgbox(SteelFactory_2F_Rector_Recognises,MSGBOX_AUTOCLOSE)
    waitmessage
    playse(SE_FAILURE)
    applymovement(1, moves(face_down emote_x))
    applymovement(8, moves(face_up emote_exclamation_mark))
    setspeaker("THE RECTOR")
    msgbox(SteelFactory_2F_Rector_TurnsOnConrector,MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(2,moves(face_up))
    setspeaker("THE RECTOR")
    msgbox(SteelFactory_2F_Rector_AngryOrders,MSGBOX_AUTOCLOSE)
    waitmessage

    // ── Barry and Conrector flee ──
    applymovement(8, moves(walk_fast_right*3 walk_fast_down walk_fast_right*2 walk_fast_up*10))
    applymovement(LOCALID_PLAYER, moves(face_down lock_facing_direction jump_up unlock_facing_direction))
    applymovement(2, moves(walk_fast_right*6 walk_fast_up*10))
    applymovement(10, moves(jump_2_up jump_2_right*3 jump_right jump_2_up*2))    
    waitmovement
    applymovement(2, moves(walk_fast_down*5))
    waitmovement
    setspeaker("BARRY")
    msgbox(format("Come on you stupid fish, let's get out of here!"),MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(2, moves(walk_fast_up*4))
    applymovement(10, moves(jump_2_up*4))
    waitmovement(10)
    removeobject(2)
    removeobject(8)
    removeobject(10)
    applymovement(7, moves(walk_down*2 walk_right walk_down walk_right))
    applymovement(1, moves(walk_left*3 walk_down*3 walk_right*2))
    applymovement(LOCALID_PLAYER, moves(face_left))
    delay(60)
    applymovement(LOCALID_PLAYER, moves(walk_down*2 walk_left*3))
    waitmovement

    // ── Rector addresses player ──
    setspeaker("THE RECTOR")
    msgbox(SteelFactory_2F_Rector_BattleChallenge)
    waitmessage
    setspeaker(NULL)
    clearflag(FLAG_HIDE_RECTOR_ELECTABUZZ_AFTER_BATTLE)
    trainerbattle_no_intro(TRAINER_FACULTY_RECTOR, SteelFactory_2F_Rector_BattleDefeat)
    call(SteelFactory_2F_Rector_Defeated)
    end
}

// ─── POST-BATTLE ───

script SteelFactory_2F_Rector_Defeated {
    setspeaker("THE RECTOR")
    msgbox(SteelFactory_2F_Rector_DefeatedText1)
    waitmessage
    setspeaker("THE RECTOR")
    msgbox(SteelFactory_2F_Rector_DefeatedText2,MSGBOX_AUTOCLOSE)
    waitmessage
    setspeaker(NULL)
    applymovement(7, moves(enter_pokeball))
    applymovement(12, moves(enter_pokeball))
    waitmovement(7)
    waitmovement(12)
    setflag(FLAG_HIDE_RECTOR_ELECTABUZZ_AFTER_BATTLE)
    applymovement(11, moves(walk_down*2))
    applymovement(1, moves(walk_down*2))
    waitmovement(11)
    waitmovement(1)
    removeobject(11)
    removeobject(12)
    removeobject(7)
    removeobject(1)
    setflag(FLAG_STEEL_FACTORY_RECTOR_DEFEATED)
    setflag(FLAG_STEEL_FACTORY_COMPLETE)
    clearflag(FLAG_HIDE_LIONSARCH_RECTOR_SENDOFF)
    clearflag(FLAG_HIDE_LIONSARCH_BARRY_SENDOFF)
    clearflag(FLAG_HIDE_LIONSARCH_CONRECTOR_SENDOFF)
    delay(30)
    applymovement(LOCALID_PLAYER, moves(walk_down*2))
    waitmovement
    playse(SE_SLIDING_DOOR)
    setvar(VAR_LIONSARCH_CITY_STATE, 1)
    warpsilent(MAP_LIONSARCH_CITY,10)
    releaseall
    end
}

// ─── TEXT ───

text SteelFactory_2F_Rector_WaitingLine {
    format("So you came back? I was hoping you would.")
}

text SteelFactory_2F_Rector_After {
    format("The Faculty endures.\pThis was one facility.\pThere are others.")
}

text SteelFactory_2F_Rector_OpensMeeting {
    format("Looks like the iron processing is ahead of schedule.\pYou've both performed adequately this quarter, the yield figures are impressive.\p To make a long story short: Order wins, chaos loses.")
}

text SteelFactory_2F_Conrector_LaironsFreed {
    format("Indeed, the processing yield was exceptional, sir.\pThere was one small hiccup with the Lairon containment unit this morning, but I managed the issue, no problems at all sir.\pYou see, the specimens had become unreliable. Diminishing returns. Worn teeth. Stress fractures.\pI made the executive call to release them before the voyage.\pNot worth shipping livestock that can't perform. Absolutely nothing to worry about, sir.")
}

text SteelFactory_2F_Conrector_LaironsGood {
    format("Processing is complete, sir. Excellent yield.\pThe Lairon unit consumed all impurity-heavy ore as intended.\pOnly the highest-grade iron remains.\pOne little Aron escaped this morning, but we managed to contain it.\pI've arranged for the specimens to be loaded onto the transport vessels in any moment.")
}

text SteelFactory_2F_Rector_ShockSuggestion {
    format("How about you Barr.. Wouter?\pI notice your Magikarp is still not giving you any value?\pWhen my pokemon don't contribute, I let my Electabuzz handle them.\pA good shock now and then makes expectations very clear.\pMaybe Electabuzz could help you out with that?")
}

text SteelFactory_2F_Barry_ShockDecline {
    format("I... appreciate the suggestion, sir.\pBut Magikarp are quite sensitive to electricity. Apparently it discolors their scales.\pI wouldn't want to damage the...  specimen quality.\p...That would be irresponsible.")
}

text SteelFactory_2F_Barry_MiningReport {
    format("The mining operation hit every target,  sir.\pWe did have a brief evacuation. A civilian wandered into the tunnels.\pI handled it personally. Pushed them into a deep dark crevice.\pHazard of the mine, really. Nothing special.")
}

text SteelFactory_2F_Rector_Recognises {
    format("...You?\pWhat are you doing here?\p...\pWait... you're the one who tried to stop us in the Cloud Forest as well?\p You just don't know when to quit, do you?\p")
}

text SteelFactory_2F_Rector_TurnsOnConrector {
    format("And the Lairon.\p'Stress fractures'\p'Diminishing returns.'\pHow convenient.")
}

text SteelFactory_2F_Rector_AngryOrders {
    format("Load the boats.\pBoth of you. NOW.  I want neither of you on this floor when I am finished.")
}

text SteelFactory_2F_Rector_BattleChallenge {
    format("You've become quite the nuisance.\pFirst the Cloud Forest, now our factory?\pYou would be a great student of mine.")
}

text SteelFactory_2F_Rector_BattleIntro {
    format("Show me what you are capable of. I will not hold back.")
}

text SteelFactory_2F_Rector_BattleDefeat {
    format("...")
}

text SteelFactory_2F_Rector_DefeatedText1 {
    format("...\p...How.")
}

text SteelFactory_2F_Rector_DefeatedText2 {
    format("This changes nothing.\pThe Faculty's reach goes further than this building.\pFar further.\pFollow me.")
}

text SteelFactory_2F_Barry_After {
    format("The Rector is behind that door.\pHe's not going to run.  He never does.")
}

