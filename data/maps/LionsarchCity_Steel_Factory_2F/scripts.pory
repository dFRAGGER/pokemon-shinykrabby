    msgbox(SteelFactory_2F_Blueprint_Assembly_Text)
    release
}

text SteelFactory_2F_PC_Research_Text {
    format("FACULTY INTERNAL - CYCLE 14 SUMMARY\p- Output targets exceeded by 12%%.\pSpecimen endurance remains within acceptable range.\pNote: biological variance in batch 7 requires monitoring.\pRector review pending. -")
}

text SteelFactory_2F_PC_Logistics_Text {
    format("TRANSPORT MANIFEST - PENDING DISPATCH\p- Three shipments awaiting clearance.\pContents: processed material, grade A.\pDestination: redacted.\pEstimated transit: 4 days by sea.\pAll documentation has been filed under Rector authorization. -")
}

text SteelFactory_2F_PC_Locked_Text {
    format("FACULTY ACCESS ONLY\pThis terminal is locked.\pYou cannot interact with it.")
}

text SteelFactory_2F_Blueprint_Materials_Text {
    format("COMPONENT SPECIFICATION - DRAFT 9\p- Primary substrate: high-density ore, origin Lions Mountains.\pSecondary binding agent: unspecified biological compound, sourced on-site.\pAlloy stability under sustained resonance: 94%%.\pWarning: do not substitute substrate without Rector approval. -")
}

text SteelFactory_2F_Blueprint_Assembly_Text {
    format("ASSEMBLY PHASE - STRUCTURAL OVERVIEW\p- Layer configuration classified. See Rector annex.\pCore channel dimensions have been adjusted per Cycle 11 findings.\pNote from lead researcher: the material responds differently than anticipated.\pFurther testing required before full production begins. -")
}

script SteelFactory_2F_Blueprint_RockSmash {
    lock
    msgbox(SteelFactory_2F_Blueprint_RockSmash_Text)
    release
}

text SteelFactory_2F_Blueprint_RockSmash_Text {
    format("FIELD OBSERVATION - MINING DIVISION\p- During extraction operations in the lower ore deposits, repeated application of concentrated force against the rock face produced a consistent fracture response.\pPokemon involved in the drilling process began replicating the motion instinctively.\pThe technique has been documented and encoded.\pSee attached disc for move data: ROCK SMASH. -")
}
