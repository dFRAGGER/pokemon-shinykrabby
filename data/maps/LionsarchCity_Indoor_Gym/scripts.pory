mapscripts LionsarchCity_Indoor_Gym_MapScripts {
    MAP_SCRIPT_ON_LOAD:   LionsarchGym_OnLoad
    MAP_SCRIPT_ON_RESUME: LionsarchGym_OnResume
}

script LionsarchGym_OnLoad {
    special(Special_LionsarchGym_StartStorm)
    end
}

script LionsarchGym_OnResume {
    if (flag(FLAG_BADGE03_GET) == FALSE) {
        special(Special_LionsarchGym_StartStorm)
    }
    end
}

# ─── LEADER REVEAL ────────────────────────────────────────────────────────────
# Triggered by coord events at y=8.
# Plays the animated storm-clear (BLDY 16 -> 0) revealing the two leaders.
# No-ops once the badge has been earned (storm permanently cleared).

script LionsarchGym_LeaderReveal {
    if (flag(FLAG_BADGE03_GET) == TRUE) {
        end
    }
    special(Special_LionsarchGym_RevealLeaders)
    waitstate
    end
}

# ─── GYM LEADERS ─────────────────────────────────────────────────────────────
# Two leaders at y=7 representing West Lion Mountain (Leader1, x=5)
# and East Lion Mountain (Leader2, x=6).
# Names TBD - replace "???" with their actual names.

script LionsarchGym_Leader1 {
    lock
    if (flag(FLAG_BADGE03_GET) == TRUE) {
        faceplayer
        setspeaker("???")
        msgbox(format("Two peaks stand as one.\nYou have proven yourself."))
        waitmessage
        setspeaker(NULL)
        release
        end
    }
    if (flag(FLAG_DEFEATED_LIONSARCH_LEADER1) == FALSE) {
        faceplayer
        setspeaker("???")
        msgbox(format("You made it through the storm?\nThe west mountain does not yield so easily..."))
        waitmessage
        setspeaker(NULL)
        trainerbattle_single(TRAINER_LIONSARCH_LEADER1, LionsarchGym_Leader1_IntroText, LionsarchGym_Leader1_DefeatText, LionsarchGym_Leader1_Defeated)
    }
    else {
        faceplayer
        setspeaker("???")
        msgbox(format("Defeat my partner, then claim your prize."))
        waitmessage
        setspeaker(NULL)
    }
    release
    end
}

script LionsarchGym_Leader1_Defeated {
    lock
    setspeaker("???")
    msgbox(format("The west peak bows to your strength.\nMy partner still stands - face the east!"))
    waitmessage
    setspeaker(NULL)
    setflag(FLAG_DEFEATED_LIONSARCH_LEADER1)
    release
    end
}

text LionsarchGym_Leader1_IntroText {
    format("I am the voice of the west mountain!\nFeel the cold of the peak!")
}

text LionsarchGym_Leader1_DefeatText {
    format("The summit... recedes from me.")
}

script LionsarchGym_Leader2 {
    lock
    if (flag(FLAG_BADGE03_GET) == TRUE) {
        faceplayer
        setspeaker("???")
        msgbox(format("Two peaks stand as one.\nYou have earned our respect."))
        waitmessage
        setspeaker(NULL)
        release
        end
    }
    if (flag(FLAG_DEFEATED_LIONSARCH_LEADER1) == FALSE) {
        faceplayer
        setspeaker("???")
        msgbox(format("You must face the west mountain first.\nThe east will wait."))
        waitmessage
        setspeaker(NULL)
        release
        end
    }
    faceplayer
    setspeaker("???")
    msgbox(format("You overcame the west.\nNow face the fury of the east mountain!"))
    waitmessage
    setspeaker(NULL)
    trainerbattle_single(TRAINER_LIONSARCH_LEADER2, LionsarchGym_Leader2_IntroText, LionsarchGym_Leader2_DefeatText, LionsarchGym_Leader2_Defeated)
    release
    end
}

script LionsarchGym_Leader2_Defeated {
    lock
    setspeaker("???")
    msgbox(format("The east peak falls too...\pYou have conquered both Lion Mountains."))
    waitmessage
    call(Common_EventScript_PlayGymBadgeFanfare)
    setflag(FLAG_BADGE03_GET)
    setspeaker(NULL)
    msgbox(format("You received the PEAK BADGE!"))
    waitmessage
    setspeaker("???")
    msgbox(format("The PEAK BADGE lets all Pokémon up to level 40 obey without question.\pYou may now use STRENGTH outside of battle.\pMay your path lead you over many mountains."))
    waitmessage
    giveitem(ITEM_HM04)
    setflag(FLAG_DEFEATED_MAUVILLE_GYM)
    call(LionsarchGym_SetTrainerFlags)
    release
    end
}

text LionsarchGym_Leader2_IntroText {
    format("The east wind howls for you!\nThis peak has never been climbed!")
}

text LionsarchGym_Leader2_DefeatText {
    format("The east peak... is silent.")
}

# ─── TRAINERS ─────────────────────────────────────────────────────────────────

script LionsarchGym_Trainer_Hiker1 {
    trainerbattle_single(TRAINER_LIONSARCH_HIKER_1, LionsarchGym_Hiker1_Intro, LionsarchGym_Hiker1_Defeat)
    msgbox(LionsarchGym_Hiker1_PostBattle, MSGBOX_AUTOCLOSE)
    end
}

text LionsarchGym_Hiker1_Intro {
    format("You won't get past me in this blizzard!")
}

text LionsarchGym_Hiker1_Defeat {
    format("The cold got to me first...")
}

text LionsarchGym_Hiker1_PostBattle {
    format("Keep pushing north. The storm only gets worse.")
}

script LionsarchGym_Trainer_Hiker2 {
    trainerbattle_single(TRAINER_LIONSARCH_HIKER_2, LionsarchGym_Hiker2_Intro, LionsarchGym_Hiker2_Defeat)
    msgbox(LionsarchGym_Hiker2_PostBattle, MSGBOX_AUTOCLOSE)
    end
}

text LionsarchGym_Hiker2_Intro {
    format("The lion mountains guard their secrets fiercely!")
}

text LionsarchGym_Hiker2_Defeat {
    format("Even the mountain fell today...")
}

text LionsarchGym_Hiker2_PostBattle {
    format("I've barely seen the leaders myself - just shapes in the white.")
}

script LionsarchGym_Trainer_Hiker3 {
    trainerbattle_single(TRAINER_LIONSARCH_HIKER_3, LionsarchGym_Hiker3_Intro, LionsarchGym_Hiker3_Defeat)
    msgbox(LionsarchGym_Hiker3_PostBattle, MSGBOX_AUTOCLOSE)
    end
}

text LionsarchGym_Hiker3_Intro {
    format("The blizzard is my ally - I'll freeze you in your tracks!")
}

text LionsarchGym_Hiker3_Defeat {
    format("The storm can't save me now...")
}

text LionsarchGym_Hiker3_PostBattle {
    format("They say when the two leaders stand together, the storm obeys them.")
}

script LionsarchGym_Trainer_Hiker4 {
    trainerbattle_single(TRAINER_LIONSARCH_HIKER_4, LionsarchGym_Hiker4_Intro, LionsarchGym_Hiker4_Defeat)
    msgbox(LionsarchGym_Hiker4_PostBattle, MSGBOX_AUTOCLOSE)
    end
}

text LionsarchGym_Hiker4_Intro {
    format("Every step closer to the top is a step into oblivion!")
}

text LionsarchGym_Hiker4_Defeat {
    format("The peak is yours today...")
}

text LionsarchGym_Hiker4_PostBattle {
    format("When the whiteout hits, follow the cold wind north.")
}

script LionsarchGym_Trainer_Hiker5 {
    trainerbattle_single(TRAINER_LIONSARCH_HIKER_5, LionsarchGym_Hiker5_Intro, LionsarchGym_Hiker5_Defeat)
    msgbox(LionsarchGym_Hiker5_PostBattle, MSGBOX_AUTOCLOSE)
    end
}

text LionsarchGym_Hiker5_Intro {
    format("The lion mountains have two eyes - and both are watching you!")
}

text LionsarchGym_Hiker5_Defeat {
    format("I couldn't hold the pass...")
}

text LionsarchGym_Hiker5_PostBattle {
    format("I've never actually seen the leaders clearly. Just shapes in the white.")
}

script LionsarchGym_SetTrainerFlags {
    settrainerflag(TRAINER_LIONSARCH_HIKER_1)
    settrainerflag(TRAINER_LIONSARCH_HIKER_2)
    settrainerflag(TRAINER_LIONSARCH_HIKER_3)
    settrainerflag(TRAINER_LIONSARCH_HIKER_4)
    settrainerflag(TRAINER_LIONSARCH_HIKER_5)
    return
}
