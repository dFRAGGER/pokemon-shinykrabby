}

script Marshduke_Indoor_Chatedral_EventScript_Sign_EmptyShrine{
    lock
    faceplayer
    msgbox(format("FIVE MEMORIES OF WHAT WAS. ONE SPACE FOR WHAT COULD BE. THE DIFFERENCE BETWEEN THEM IS US."), MSGBOX_AUTOCLOSE)
    waitmessage
    release
}