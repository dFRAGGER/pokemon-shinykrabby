mapscripts EastLionMountain_Faculty_Mining_Cave_B1F_MapScripts {
    MAP_SCRIPT_ON_RESUME { call(MiningCaveB1F_StartTremors) }
}

script MiningCaveB1F_StartTremors {
    if(flag(FLAG_HIDE_FACULTY_AT_WESTLION_MINE)){
        end
    }
    callnative(StartCaveTremorScene)
    end
}

// =====================
// TRAINER SCRIPTS - MINING CAVE B1F
// 4 Faculty Members (male) + Barry (Administrator)
// =====================

script MiningCaveB1F_Trainer_Faculty_Addy {
    trainerbattle_single(TRAINER_MADS_MINING_SK, MiningCaveB1F_Text_MadsIntro, MiningCaveB1F_Text_MadsDefeated)
    msgbox(MiningCaveB1F_Text_MadsPostBattle, MSGBOX_AUTOCLOSE)
    end
}

text MiningCaveB1F_Text_MadsIntro {
    format("You don't belong down here.\pTurn back while you still can.")
}

text MiningCaveB1F_Text_MadsDefeated {
    format("The tremors... they're getting worse the deeper we dig...")
}

text MiningCaveB1F_Text_MadsPostBattle {
    format("Just... stay out of our way.\pThe Administrator has everything under control.")
}

script MiningCaveB1F_Trainer_Faculty_Ad {
    trainerbattle_single(TRAINER_AD_MINING_SK, MiningCaveB1F_Text_AdIntro, MiningCaveB1F_Text_AdDefeated)
    msgbox(MiningCaveB1F_Text_AdPostBattle, MSGBOX_AUTOCLOSE)
    end
}

text MiningCaveB1F_Text_AdIntro {
    format("This is a restricted excavation!\pI have orders to remove any intruders!")
}

text MiningCaveB1F_Text_AdDefeated {
    format("How did you get past the others?")
}

text MiningCaveB1F_Text_AdPostBattle {
    format("You shouldn't have come down here.\pSome things are better left undisturbed.")
}

script MiningCave_Trainer_Faculty_Owen {
    trainerbattle_single(TRAINER_OWEN_MINING_SK, MiningCave_Text_OwenIntro, MiningCave_Text_OwenDefeated)
    msgbox(MiningCave_Text_OwenPostBattle, MSGBOX_AUTOCLOSE)
    end
}

text MiningCave_Text_OwenIntro {
    format("You've come far enough!\pThese grounds are closed to outsiders!")
}

text MiningCave_Text_OwenDefeated {
    format("...The mountain stirs when strangers pass through.")
}

text MiningCave_Text_OwenPostBattle {
    format("Old places like this one don't appreciate being disturbed.\pNeither do I.")
}

script MiningCave_Trainer_Faculty_Warren {
    trainerbattle_single(TRAINER_WARREN_MINING_SK, MiningCave_Text_WarrenIntro, MiningCave_Text_WarrenDefeated)
    msgbox(MiningCave_Text_WarrenPostBattle, MSGBOX_AUTOCLOSE)
    end
}

text MiningCave_Text_WarrenIntro {
    format("Intruder! You're not authorized to be here!")
}

text MiningCave_Text_WarrenDefeated {
    format("Tch... Underestimated you.")
}

text MiningCave_Text_WarrenPostBattle {
    format("Ore samples? That's what the public paperwork calls them.\pThe sealed transport needed its own power supply.\pI've never guarded a rock that needed batteries before.")
}


// =====================
// BARRY - ADMINISTRATOR BATTLE
// =====================

script MiningCaveB1F_Barry_Battle {
    lock
    faceplayer
    playse(SE_PIN)
    applymovement(1, moves(emote_exclamation_mark))
    waitmovement(0)
    setspeaker("BARRY")
    msgbox(format("YOU again?!\pDon't you ever know when to quit?\p...\pIt doesn't matter. I just got promoted from intern to ADMINISTRATOR.\pAnd you are still a little intern right?\pHAHAHAHA!"), MSGBOX_AUTOCLOSE)
    waitmessage
    trainerbattle_no_intro(TRAINER_BARRY_MINING_SK, MiningCaveB1F_Text_BarryDefeated)
    goto(MiningCaveB1F_Barry_PostBattle)
}

text MiningCaveB1F_Text_BarryDefeated {
    format("How could a little intern defeat me?!")
}

script MiningCaveB1F_Barry_PostBattle {
    lock
    setflag(FLAG_HIDE_FACULTY_AT_WESTLION_MINE)
    playse(SE_M_EARTHQUAKE)
    delay(60)
    playse(SE_PIN)
    applymovement(1, moves(emote_exclamation_mark))
    waitmovement(0)
    setspeaker("BARRY")
    msgbox(format("Gah! The drilling cracked the ice supports!\pThis entire section is destabilizing!"), MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(LOCALID_PLAYER, moves(face_right lock_facing_direction walk_left unlock_facing_direction walk_right face_up))
    applymovement(1, moves(walk_fast_up*3))
    waitmovement
    applymovement(2, moves(face_down))
    delay(30)
    setspeaker("BARRY")
    msgbox(format("We gotta go!\pREGICE is already at the factory. Get the remaining equipment and transfer records out!\pGather the others. Nobody stays down here!"), MSGBOX_AUTOCLOSE)
    waitmessage    
    applymovement(2, moves(walk_fast_left walk_fast_up*5))
    waitmovement
    removeobject(2)
    setflag(FLAG_HIDE_MINING_CAVE_B1F_SCIENTIST)
    callnative(StopCaveTremorScene)
    applymovement(1, moves(face_down))
    delay(60)
    applymovement(1, moves(walk_fast_down))
    waitmovement
    applymovement(1, moves(walk_fast_down*2))
    applymovement(LOCALID_PLAYER, moves(face_up lock_facing_direction walk_fast_down*2 unlock_facing_direction))
    waitmovement
    setspeaker("BARRY")
    msgbox(format("You honestely think I would let you leave and try to ruin our plans for the 3rd time?\pTake this, stupid intern!"), MSGBOX_AUTOCLOSE)
    waitmessage
    playse(SE_BALL_THROW)
    applymovement(LOCALID_PLAYER, moves(face_up lock_facing_direction jump_2_down unlock_facing_direction))
    delay(15)
    fadescreen(FADE_TO_BLACK)
    setvar(VAR_MINING_CAVE_STATE, 1)
    delay(120)
    warpsilent(MAP_EAST_LION_MOUNTAIN_FACULTY_MINING_CAVE, 9, 10)
    waitstate
    release
    end
}

// =====================
// NPC CONVERSATIONS - MINING CAVE B1F
// 3 Scientists
// =====================

script MiningCaveB1F_Worker1_Convo {
    lock
    faceplayer
    msgbox(format("That chamber was sealed in ancient ice.\pOur permit was for ore, but the orders were very clear: preserve the specimen, remove everything around it.\pThe support ice didn't survive the drilling nearly as well."), MSGBOX_AUTOCLOSE)
    release
    end
}

script MiningCaveB1F_Worker2_Convo {
    lock
    faceplayer
    msgbox(format("REGICE was intact when we uncovered it.\pThe containment crew took it to the Lionsarch steelworks before this shift started.\pMy job is to record what remains of the chamber.\pThe instruments keep picking up the drills. Or the ice cracking. It's getting hard to tell."), MSGBOX_AUTOCLOSE)
    release
    end
}

script MiningCaveB1F_Worker3_Convo {
    lock
    faceplayer
    msgbox(format("The hollow in the ice is where the specimen rested.\pThose newer scars are from the transport frame.\pWe widened the passage to get it out. The Administrator refused to wait for a stability survey."), MSGBOX_AUTOCLOSE)
    release
    end
}

script MiningCaveB1F_Sign_DeepMine {
    lock
    msgbox(format("FACULTY EXTRACTION RECORD\pSpecimen: REGICE. Recovered intact from the sealed ice chamber.\pTransfer completed: LIONSARCH STEEL FACTORY, containment bay.\pPortable controller must remain powered throughout transport.\pPublic freight declaration: mineral samples.\pRemaining crew: recover equipment and records. Excavation supports are unstable."), MSGBOX_AUTOCLOSE)
    release
}

script MiningCave_Sign_Danger {
    lock
    msgbox(format("CAUTION: ICE EXCAVATION\pDrilling has weakened the chamber supports.\pReport new cracks or tremors immediately. Keep the freight passage clear."), MSGBOX_AUTOCLOSE)
    release
}
