script Maasje_PokemonCenter_1F_Bryan_Following {
    lock
    playse(SE_PIN)
    applymovement(2, moves(emote_question_mark face_player))
    delay(40)
    setspeaker("Bryan")
    msgbox(format("Are you talking to me?\p I'm not even here, don't worry!\p I'll send you the footage on DVD!"))
    waitmessage
    release
}

script Maasje_PokemonCenter_1F_Man {
    lock
    faceplayer
    setspeaker("Steph Boilers")
    msgbox(format("Back in the day the gym leader, Pete Longfellow, was my geography teacher.\p He quit his old job because one of students started to imitate his quirks.\p I forgot the real name of the student, but everybody called him J.T.B.."))
    waitmessage
    release
}