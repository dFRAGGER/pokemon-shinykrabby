mapscripts LabJariIndoorStorage_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if(var(VAR_RECIEVED_STARTER_POKEMON) == 2) {
            clearflag(FLAG_HIDE_INTERN_BIRDS_LAB)}
        else {
        setflag(FLAG_HIDE_INTERN_BIRDS_LAB)
        }
    }
}

script LabJariIndoorStorage_Eventscript_Intern_Cave {
    lockall
    if(var(VAR_TEMP_0) == 0) {
    playse(SE_PIN)
    applymovement(1, moves(reveal_trainer emote_exclamation_mark jump_in_place_down))
    waitmovement
    msgbox (format("{COLOR RED}Young intern: {COLOR DARK_GRAY}Uhm... I'm just an intern... just putting up this big poster of this beautifull rock formation.... A hole in the wall??? Not sure what you are talking about? Nothing to see here..."))
    waitmessage
    setvar(VAR_TEMP_0, 1)}
    else {
        msgbox(format("{COLOR RED}Young intern: {COLOR DARK_GRAY}Like I said, nothing to see here..... just a regular rock wall... with a few dents here and there..."))
    }
    releaseall
}

script LabJariIndoorStorage_Eventscript_BoxesAssignment {
    lock
    msgbox(format("Hmm.... those boxes should be here somewhere...\pBetter not return empty handed..."))
    waitmessage
    applymovement(LOCALID_PLAYER, moves(walk_up))
    waitmovement
    release
}

script LabJariIndoorStorage_Sign_1 {
    lock
    msgbox(format("These appear to be notes detailing a major construction project for an underground facility beneath a mountain."))
    waitmessage
    release
}

script LabJariIndoorStorage_Sign_2 {
    lock
    msgbox(format("A server whose cooling fans are spinning rapidly."))
    waitmessage
    release
}

script LabJariIndoorStorage_Sign_3 {
    lock
    msgbox(format("This coffee is so old it appears to have polymerized into a solid mass."))
    waitmessage
    release
}

script LabJariIndoorStorage_Sign_4 {
    lock
    msgbox(format("--FACILITY SERVER: DEBUG LOG--\pPROJECT OMEGA: CURRENT STATUS: PHASE 3 CONSTRUCTION.\nLOCATION: SUBTERRANEAN, MOUNT BASE COMPLEX.\pGEOLOGIC REPORT: DRILLING OPERATIONS proceeding close to SAFE TOLERANCES. We have excavated the full footprint for the Rare Starter Pokemon Facility and the Advanced Research Wing.\pCORE DIRECTIVE: Maintain absolute SIGNAL SILENCE. The government must not be aware of the scope of this project.\pSYSTEM ALERT: POWER CONSUMPTION for SUB-LEVEL 5 COOLING is CRITICAL. Authorized CPU MINING seems to drain the power in AUXILIARY LABS.\p--PRESS A TO VIEW SCHEMATICS--"))
    waitmessage
    release
}

script LabJariIndoorStorage_Sign_5 {
    lock
    msgbox(format("Shelves with books about underground construction."))
    waitmessage
    release
}

