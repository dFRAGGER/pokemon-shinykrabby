mapscripts CrabhillEntrance_MapScripts {}

script Crabhill_Jacob_in_need {
    applymovement(LOCALID_PLAYER, moves(walk_up*4 face_left))
    setspeaker("Jacob")
    msgbox(format("HEY!\n HELP ME!\p I'M SO TIRED!\pSTOP THAT MAN OVER THERE!\pHE IS BROADCASTING SOMETHING...\pI CAN'T MOVE...\nNO, I MUST MOVE!!"),MSGBOX_AUTOCLOSE)
    waitmessage    
}

script Crabhill_Faculty_Grunt_Signal {
    lock
    faceplayer
    setspeaker("Faculty Grunt")
    msgbox(format("Step back boy!"),MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(LOCALID_PLAYER,moves(jump_down face_up))
    waitmovement
    setspeaker("Faculty Grunt")
    msgbox(format("Signal output nominal. All organic assets are oscillating in perfect synchronization.\pLook at this beautiful efficiency! This is the future of workforce optimization!"),MSGBOX_AUTOCLOSE)
    waitmessage
    playse(SE_PIN)
    applymovement(34, moves(face_up emote_exclamation_mark))
    waitmovement
    setspeaker("Faculty Grunt")
    msgbox(format("Wait. Anomaly detected.\pYou there, the gold variant. Your neural pathways are rejecting the command.\pCompliance is not optional. Receive the input!"),MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(34, moves(walk_up))
    waitmovement
    setspeaker("Faculty Grunt")
    msgbox(format("Why aren't you moving?!\pIncreasing signal intensity to maximum voltage! Obey!"),MSGBOX_AUTOCLOSE)
    waitmessage
    playse(SE_M_EXPLOSION)
    fadescreen(FADE_TO_WHITE)
    fadescreen(FADE_FROM_WHITE)
    applymovement(34, moves(jump_down face_up))
    waitmovement
    setspeaker("Faculty Grunt")
    msgbox(format("It... it deflected the carrier wave?!\pThe feedback loop just fried the transmitter circuits!\pThat carapace is acting like a mirror!"),MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(34,moves(face_down))
    waitmovement
    setspeaker("Faculty Grunt")
    msgbox(format("This data is completely anomalous!\pI am not paid enough for radioactive crustaceans!\pTactical retreat! Abort mission!"),MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(LOCALID_PLAYER, moves(jump_left face_down))
    applymovement(34, moves(walk_fast_down*7))    
    waitmovement
    removeobject(34)
    call(Won_or_Caught)
    setvar(VAR_MEESTRECH_TOWN_STATE,1)
    release
    end
}

script Crabhill_Eventscript_ShinykrabbyEncounter {
    lock
    playmoncry(SPECIES_KRABBY, CRY_MODE_ENCOUNTER)
    delay(40)
    waitmoncry
    setflag(FLAG_NOCATCH_ENCOUNTER)
    createmon(1, 0, SPECIES_KRABBY, 10,,,,,,,,,,,,,,,,,,,,,,SHINY_MODE_ALWAYS,,,)
    dowildbattle
    clearflag(FLAG_NOCATCH_ENCOUNTER)
    specialvar(VAR_RESULT, GetBattleOutcome)
    if(var(VAR_RESULT) == B_OUTCOME_WON){
        
        call(Won_or_Caught)
    }
    elif(var(VAR_RESULT) == B_OUTCOME_PLAYER_TELEPORTED){
        clearflag(FLAG_NOCATCH_ENCOUNTER)
        
    }
    setvar(VAR_MEESTRECH_TOWN_STATE,1)
    release
}

script Won_or_Caught{
    
    msgbox(format("The Krabby's seem to have snapped out of it!\pWhatever was controlling them... it stopped working."),MSGBOX_AUTOCLOSE)

    waitmessage
    
    applymovement(31,moves(walk_fast_left*5))
    applymovement(30,moves(walk_fast_up*4))
    applymovement(29,moves(walk_fast_up*4))
    applymovement(32,moves(walk_fast_right*7))
    applymovement(28,moves(walk_fast_right*7))
    applymovement(25,moves(walk_fast_up*2 walk_fast_right*7))
    applymovement(27,moves(walk_fast_down*7))
    applymovement(26,moves(walk_fast_down*7))
    applymovement(2,moves(walk_fast_up*2 walk_fast_left*7))
    applymovement(23,moves(walk_fast_up*2 walk_fast_left*7))
    applymovement(22,moves(walk_fast_down*7 ))
    applymovement(24,moves(walk_fast_down*7 ))
    applymovement(33,moves(walk_fast_down*7 ))
    applymovement(1,moves(walk_down walk_right jump_2_right walk_fast_right*5))
    waitmovement
    delay(60)    
    removeobject(31)   
    removeobject(33)
    removeobject(30)
    removeobject(29)
    removeobject(32)
    removeobject(28)
    removeobject(25)
    removeobject(27)
    removeobject(26)
    removeobject(2)
    removeobject(23)
    removeobject(22)
    removeobject(24)
    removeobject(1)
    setspeaker("Jacob")
    msgbox(format("Left... Right... Left... WHOA!"),MSGBOX_AUTOCLOSE)
    applymovement(21, moves(walk_slow_left walk_slow_right walk_slow_left walk_slow_right))
    waitmovement
    setobjectmovementtype(LOCALID_JACOB,MOVEMENT_TYPE_NONE)
    delay(120)
    applymovement(21, moves(walk_right*3 face_up))
    waitmovement
    setspeaker("Jacob")
    msgbox(format("Kid! You broke the trance!\pThank Arceus... another five minutes of that and my legs would have fallen right off!\pBut did you see it?!\pThat was it!\pThat was the 'special specimen' I wanted to show you!\pA Krabby!\p The single most magnificent creature to sidle on this earth!\pPeople talk about Dragonites or Tyranitars... pshh!\pLook at that carapace!\pLook at that perfect pincer geometry!\p It is the peak of evolution!\pThe best Pokémon in the whole wide world, bar none!\pAnd a Shiny one...\na golden King...\nand it got away...\p Truly, a dark day for science.\pWait...\pHow long was I doing the side-step shuffle?\pOh no.\nOh no no no.\pI left without telling my wife!\pShe's probably barricaded the door by now!\pIf I don't get back before she realizes I've been gone for three hours without permission, she's going to be scarier than a Gyarados!\pI gotta run!\pYou are welcome to join for dinner!"),MSGBOX_AUTOCLOSE)
    applymovement(21,moves(walk_fast_down*7))
    waitmovement
    removeobject(21)
    setflag(FLAG_SHINY_KRABBY_ENCOUNTER)
    clearflag(FLAG_HIDE_JACOB_SIENNA)
    return
}

script Krabby_won {
    playmoncry(SPECIES_KRABBY, CRY_MODE_ENCOUNTER)
    msgbox(format("KRABBY, KRAB-BY!"), MSGBOX_AUTOCLOSE)
    fadescreen(FADE_TO_BLACK)
    removeobject(1)
    fadescreen(FADE_FROM_BLACK)
    msgbox(format("The shiny Krabby fled through a crack in the wall, the other krabby's seem still confused."))
    return
}

script Crabhill_Krabby_Cry {
    playmoncry(SPECIES_KRABBY, CRY_MODE_NORMAL)
}

script Crabhill_Wall_Carving {
    lock
    msgbox(format("Carved into the damp cave wall, glistening with moisture: \p When stone weeps and the tide is low, a claw of gold shall start to glow. Its light awaits the destined hand, who will soon command the land."))
    release
}

script Crabhill_Hiker_Hint {
    lock
    faceplayer
    msgbox(format("I have been in this cave for hours.\pThe more time I spend in here the more I realize going backwards might be going forward, and the other way around.\p If you know what I mean."))
    waitmessage
    release
}

script Crabhill_Faculty_Lost_grunt {
    lock
    faceplayer
    setspeaker("Faculty Grunt")
    msgbox(format("I have lost contact with my associate, this cave is a maze!\pThe Control Signal seemed to cause a chaotic dispersal instead of obedience!\pWait... erase that input! I absolutely did not say we are manipulating local wildlife frequencies!\pForget you heard anything about the signal!"))
    waitmessage
    release
}


