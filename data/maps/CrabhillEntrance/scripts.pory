mapscripts CrabhillEntrance_MapScripts {}

script Crabhill_Jacob_in_need {
    setvar(VAR_MEESTRECH_TOWN_STATE,1)
    applymovement(LOCALID_PLAYER, moves(walk_up*4 face_left))
    setspeaker("Jacob")
    msgbox(format("HEY! HELP ME! I'M SO TIRED!\nATTACK THAT GOLDEN KRABBY OVER THERE!\pI CAN'T MOVE...\nNO, I MUST MOVE!!"),MSGBOX_AUTOCLOSE)
    waitmessage    
}

script Crabhill_Eventscript_ShinykrabbyEncounter {
    lock
    playmoncry(SPECIES_KRABBY, CRY_MODE_ENCOUNTER)
    delay(40)
    waitmoncry
    createmon(1, 0, SPECIES_KRABBY, 10,,,,,,,,,,,,,,,,,,,,,,TRUE,,,)
    setflag(B_FLAG_NO_RUNNING)
    setflag(B_FLAG_NO_CATCHING)
    dowildbattle
    specialvar(VAR_RESULT, GetBattleOutcome)
    if(var(VAR_RESULT) == B_OUTCOME_WON){
        call(Won_or_Caught)
    }
    elif(var(VAR_RESULT) == B_OUTCOME_PLAYER_TELEPORTED){
        call(Krabby_won)
    }
    waitmessage
    clearflag(B_FLAG_NO_RUNNING)
    clearflag(B_FLAG_NO_CATCHING)
    release
}

script Won_or_Caught{
    applymovement(LOCALID_PLAYER,moves(jump_left face_down))
    waitmovement
    applymovement(1, moves(walk_fast_down*7))
    waitmovement
    delay(60)
    msgbox(format("The Krabby's seem to have snapped out of their confusion."),MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(31,moves(walk_fast_left*4))
    applymovement(30,moves(walk_fast_up*4))
    applymovement(29,moves(walk_fast_up*4))
    applymovement(32,moves(walk_fast_right*4))
    applymovement(28,moves(walk_fast_right*4))
    applymovement(25,moves(walk_fast_right*5))
    applymovement(27,moves(walk_fast_down*4))
    applymovement(26,moves(walk_fast_down*4))
    applymovement(2,moves(walk_fast_up*2 walk_fast_left*7))
    applymovement(23,moves(walk_fast_up*2 walk_fast_left*7))
    applymovement(22,moves(walk_fast_down*5 ))
    applymovement(24,moves(walk_fast_down*5 ))
    waitmovement
    setflag(FLAG_SHINY_KRABBY_ENCOUNTER)
    removeobject(31)
    removeobject(30)
    removeobject(29)
    removeobject(32)
    removeobject(28)
    removeobject(25)
    removeobject(27)
    removeobject(26)
    removeobject(2)
    removeobject(23)
    removeobject(22)
    removeobject(24)
    removeobject(1)
    setspeaker("Jacob")
    msgbox(format("Left... Right... Left... WHOA!"),MSGBOX_AUTOCLOSE)
    applymovement(21, moves(walk_slow_left walk_slow_right walk_slow_left walk_slow_right))
    waitmovement
    delay(120)
    applymovement(21, moves(face_up))
    setspeaker("Jacob")
    msgbox(format("Kid! You broke the trance!\pThank Arceus... another five minutes of that and my legs would have fallen right off!"),MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(LOCALID_PLAYER,moves(walk_right walk_down*3 face_left))
    waitmovement
    setspeaker("Jacob")
    msgbox(format("But did you see it?!\pThat was it!\pThat was the 'special specimen' I wanted to show you!\pA Krabby!\p The single most magnificent creature to walk—or sidle—on this earth!\pPeople talk about Dragonites or Tyranitars... pshh!\pLook at that carapace!\pLook at that perfect pincer geometry!\p It is the peak of evolution!\pThe best Pokémon in the whole wide world, bar none!\pAnd a Shiny one...\na golden King...\nand it got away.\p Truly, a dark day for science.\p It would have been the perfect specie to start your internship with, Prof. Birds would have been soo proud..."),MSGBOX_AUTOCLOSE)
    waitmessage
    return
}

script Krabby_won {
    playmoncry(SPECIES_KRABBY, CRY_MODE_ENCOUNTER)
    msgbox(format("KRABBY, KRAB-BY!"), MSGBOX_AUTOCLOSE)
    fadescreen(FADE_TO_BLACK)
    removeobject(1)
    fadescreen(FADE_FROM_BLACK)
    msgbox(format("The shiny Krabby fled through a crack in the wall, the other krabby's seem still confused."))
    return
}

script Crabhill_Krabby_Cry {
    playmoncry(SPECIES_KRABBY, CRY_MODE_NORMAL)
}

script Crabhill_Wall_Carving {
    lock
    msgbox(format("Carved into the damp cave wall, glistening with moisture: \p When stone weeps and the tide is low, a claw of gold shall start to glow. Its light awaits the destined hand, who will soon command the land."))
    release
}

script Crabhill_Hiker_Hint {
    lock
    faceplayer
    msgbox(format("I have been in this cave for hours.\pThe more time I spend in here the more I realize going backwards might be going forward, and the other way around.\p If you know what I mean."))
    waitmessage
    release
}