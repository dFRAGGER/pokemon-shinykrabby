script Route01_Factulty_Grunts_Position4 {
    lockall
    playse(SE_PIN)
    applymovement(2, moves(emote_exclamation_mark))
    applymovement(3, moves(emote_exclamation_mark))
    delay(40)
    playse(MUS_AQUA_MAGMA_HIDEOUT)
    applymovement(2, moves(walk_right * 7 walk_up * 2 ))
    applymovement(3, moves(walk_right walk_up walk_right * 5))
    call(Route01_Battle_Factulty_Grunts)
    setspeaker("Ad Dice")
    msgbox(format("Argh, nevermind.\p That Pokemon isn't worth registrating anyway.\p He barely listens to his owner and he has a weak personality.\p The Faculty would discard him right away!\p Come on Ton, let's go. The boss is waiting for us."), MSGBOX_AUTOCLOSE)
    setflag(FLAG_FACULTY_GRUNTS_ROUT01)
    applymovement(2, moves(walk_down * 2 walk_left * 10))
    applymovement(3, moves(walk_down walk_left * 10))
    waitmovement
    removeobject(2)
    removeobject(3)
    setvar(VAR_RECIEVED_STARTER_POKEMON, 3)
    releaseall
}



script Route01_Battle_Factulty_Grunts {
    setspeaker("Ton Cross")
    msgbox(format("Do you have registration for that Pokémon?\p No registration?\p All unregistered Pokémon have to be confiscated by The Faculty!\p Let me take on this loser, Ad."))
    waitmessage
    trainerbattle_no_intro(TRAINER_GRUNT_FACULTY_1, Route01_Loss_Ton_Cross)
    playse(MUS_AQUA_MAGMA_HIDEOUT)
    applymovement(LOCALID_PLAYER, moves(face_up))
    setspeaker("Ad Dice")
    msgbox(format("Ton, you are an absolute loser, let me handle this prick."))
    waitmessage
    trainerbattle_no_intro(TRAINER_GRUNT_FACULTY_2, Route01_Loss_Ad_Dice)
    waitse
}

text Route01_Loss_Ton_Cross {
    format("Even losing does not feel as bad as teaching geography to unmotivated children.")
}

text Route01_Loss_Ad_Dice {
    format("Being a janitor or losing a battle?\p I'd rather lose a battle than spend another minute with my old colleagues.")
}