mapscripts Route01_MapScripts {
    
}

script Route01_Convo_Bugcatcher {
    lock
    applymovement(4, moves(face_player))
    msgbox(format("This place is the perfect place to catch some pidgeys.\p Although lately they seem to be a little on edge.\p Yesterday I saw a curly tail sticking out of the grass, but I'm pretty sure it wasn't a Rattata or Sentret.\p Maybe my eyes decieved me..."))
    waitmessage
    release
}

script Route01_Convo_Fatman {
    lock
    msgbox(format("A clearing is visible through the trees, but the path is overgrown.\p Someone will have to clear the bushes to get to that place."))
    waitmessage
    release
}

script Route01_Convo_ExIntern {
    lock
    applymovement(6, moves(face_player))
    msgbox(format("I used to be an intern for Professor Birds.\p The day he told me to carve a hole in a stone wall, I quit."))
    release
}

script Route01_Factulty_Grunts_Position1 {
    lockall
    playse(SE_PIN)
    applymovement(2, moves(emote_exclamation_mark))
    applymovement(3, moves(emote_exclamation_mark))
    delay(40)
    playse(MUS_AQUA_MAGMA_HIDEOUT)
    applymovement(2, moves(walk_right * 6 ))
    applymovement(3, moves(walk_right * 7 walk_down))
    call(Route01_Battle_Factulty_Grunts)
    setspeaker("Ad Dice")
    msgbox(format("Argh, nevermind.\p That Pokemon isn't worth registrating anyway.\p He barely listens to his owner and so he has no potential.\p The Faculty would discard him right away!\p Come on Ton, let's go. The boss is waiting for us."), MSGBOX_AUTOCLOSE)
    setflag(FLAG_FACULTY_GRUNTS_ROUT01)
    applymovement(2, moves(walk_left * 10))
    applymovement(3, moves(walk_left * 10))
    waitmovement
    removeobject(2)
    removeobject(3)
    setvar(VAR_RECIEVED_STARTER_POKEMON, 3)
    releaseall
}

