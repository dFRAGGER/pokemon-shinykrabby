mapscripts Marshduke_Indoor_Vision_LatiosLatias_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_MARSHDUKE_CATHEDRAL_VISION_STATE, 1: Marshduke_Indoor_Vision_LatiosLatias_EventScript_Vision
    ]
}

script Marshduke_Indoor_Vision_LatiosLatias_EventScript_Vision {
    setvar(VAR_MARSHDUKE_CATHEDRAL_VISION_STATE, 3)
    lock
    applymovement(LOCALID_PLAYER, moves(face_up))
    waitmovement
    special(SpawnCameraObject)
    applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_faster_right*129))
    applymovement(1, moves(walk_faster_right*144))
    applymovement(2, moves(walk_faster_right*144))
    waitmovement
    fadescreen(FADE_TO_BLACK)
    special(RemoveCameraObject)
    setvar(VAR_MARSHDUKE_CATHEDRAL_VISION_STATE, 2)
    warpsilent(MAP_MARSHDUKE_INDOOR_CHATEDRAL, 32, 32)
    waitstate
    release
}
