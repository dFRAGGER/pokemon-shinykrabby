mapscripts Indoor_Maasje_Jakub_Home_MapScripts {}

script Indoor_Maasje_Jakub_Home_JakubConvo {
    lock
    applymovement(3, moves(face_player))
    if (var(VAR_TEMP_1) == 0) {
    msgbox(format("Hi there, my name is Jakub. Welcome to our home!\p...Professor Birds sent you?\p To catch rare species of Pokémon?\p And I can help you with that???\p That old fool...\p I don't have the time to help you with that, I'm afraid.\p I'm the one who needs help right now...\p You see this whole mess? The entire town is overrun.\p And these aren't normal Krabby. They're agitated, aggressive... lost.\p This all started when that new gym leader, Pete Longfellow, showed up.\p Rumor has it that he is part of a secret group called The Faculty.\p Apparently, this group is obsessed with... 'structure'. They talk about 'potential' and 'discipline', but something about them feels wrong.\p They look at Pokémon not as partners, but as things to be optimized, like numbers in an equation.\p The thing is... Krabby is my favorite Pokémon!\p I've spent my whole life here watching them, and I've never seen anything like this.\p It feels so... wrong.\p It's like the soul of the town is sick.\p I've heard strange humming sounds coming from Krabby Hill, just north of here.\p Rumor has it there's a unique, gold-colored Krabby deep in the caves there, the alpha of the whole colony.\p If The Faculty is involved, I'm sure they're targeting the leader to cause all this chaos.\p I don't know what their grand plan is, but this feels like the first step.\p Please, can you go to Krabby Hill and investigate? Find that alpha Krabby and see what's happening to it.\p Whatever they're doing, you need to be the one to stop it.\p Freeing their leader is the only way to calm the colony. You'd be helping me a lot... and you'd be helping them."))
    waitmessage
    setvar(VAR_TEMP_1, 1)
    release
    }
    else{
        msgbox(format("Please help me and my family, little George can't play outside right now. He has been gaming on his GameBoy all day."))
        release
    }
}

script Indoor_Maasje_Jakub_Home_SiennaConvo {
    lock
    applymovement(2, moves(face_player))
    msgbox(format("Please help my husband, he has not been the same since these weird Krabby's have been showing up. He hates to see his favorite pokemon being seen as a nuisance."))
    release
}

script Indoor_Maasje_Jakub_Home_GeorgeConvo {
    lock
    applymovement(1, moves(face_player))
    msgbox(format("Dad says that I can't be on my GameBoy the entire time. I'm sure he did the same thing back in the day. "))
    release
}