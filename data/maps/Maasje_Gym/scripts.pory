script Maasje_Gym_Eventscript_Bram {
    trainerbattle(TRAINER_BATTLE_CONTINUE_SCRIPT, LOCALID_BRAM, TRAINER_BRAM, Maasje_Gym_Introtext_Trainer_Bram, Maasje_Gym_Losetext_Trainer_Bram, NULL, OBJ_ID_NONE, TRAINER_NONE, NULL, NULL, NULL, NULL, NULL, FALSE, TRUE, FALSE, FALSE )
    msgbox(format("Give it a few years and I'll be reading the tides better than anyone else in MOSA."), MSGBOX_AUTOCLOSE)
    end
}

text Maasje_Gym_Introtext_Trainer_Bram {
    format("I'm still the rookie lookout here. But my WINGULL and I never miss the tide coming in!!")
}

text Maasje_Gym_Losetext_Trainer_Bram {
    format("Guess I still have a lot to learn about riding the waves.")
}

script Maasje_Gym_Eventscript_Rob {
    trainerbattle(TRAINER_BATTLE_CONTINUE_SCRIPT, LOCALID_ROB, TRAINER_ROB, Maasje_Gym_Introtext_Trainer_Rob, Maasje_Gym_Losetext_Trainer_Rob, NULL, OBJ_ID_NONE, TRAINER_NONE, NULL, NULL, NULL, NULL, NULL, FALSE, TRUE, FALSE, FALSE )
    msgbox(format("You never know what the low tide will uncover. That's what keeps this gym interesting."), MSGBOX_AUTOCLOSE)
    end
}

text Maasje_Gym_Introtext_Trainer_Rob {
    format("When the water pulls back, all sorts of things wash up. My SHELDER are the best divers around!!")
}

text Maasje_Gym_Losetext_Trainer_Rob {
    format("Looks like the tide swept my shells right out from under me.")
}

script Maasje_Gym_Basement_Eventscript_Addy {
    trainerbattle(TRAINER_BATTLE_CONTINUE_SCRIPT, LOCALID_ADDY, TRAINER_ADDY, Maasje_Gym_Introtext_Trainer_Addy, Maasje_Gym_Losetext_Trainer_Addy, NULL, OBJ_ID_NONE, TRAINER_NONE, NULL, NULL, NULL, NULL, NULL, FALSE, TRUE, FALSE, FALSE )
    msgbox(format("Doesn't matter if the water's high or low, the tide pools always bounce back. So do I."), MSGBOX_AUTOCLOSE)
    end
}

text Maasje_Gym_Introtext_Trainer_Addy {
    format("I tend the tide pools down here. My CORSOLA thrives no matter which way the tide turns!!")
}

text Maasje_Gym_Losetext_Trainer_Addy {
    format("Guess the reef couldn't shield me from that one.")
}

script Maasje_Gym_Basement_Eventscript_Mart {
    trainerbattle(TRAINER_BATTLE_CONTINUE_SCRIPT, LOCALID_MART, TRAINER_MART, Maasje_Gym_Introtext_Trainer_Mart, Maasje_Gym_Losetext_Trainer_Mart, NULL, OBJ_ID_NONE, TRAINER_NONE, NULL, NULL, NULL, NULL, NULL, FALSE, TRUE, FALSE, FALSE )
    msgbox(format("The tide comes in, the tide goes out. Rushing in never wins that fight."), MSGBOX_AUTOCLOSE)
    end
}

text Maasje_Gym_Introtext_Trainer_Mart {
    format("My SHUCKLE just clings to the rocks and waits out even the highest tide!!")
}

text Maasje_Gym_Losetext_Trainer_Mart {
    format("Guess patience alone doesn't win every battle.")
}