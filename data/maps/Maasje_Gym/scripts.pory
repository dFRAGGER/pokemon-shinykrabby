mapscripts Maasje_Gym_MapScripts {
    MAP_SCRIPT_ON_LOAD{
        call(Maasje_Gym_Reset_Tide_State)
    }
}

script Maasje_Gym_Introduction {
    lock
    faceplayer
    if(flag(FLAG_ITEM_FRESH_WATER_GYM1) == FALSE&&flag(FLAG_BADGE01_GET)==FALSE){
            setflag(FLAG_ITEM_FRESH_WATER_GYM1)
            msgbox(format("Hi, welcome to the MOSA Pokemon Gym.\pThe gym leader and trainers use pokemon seen during tide shifts, whatever that means...\pGrass pokemon seem to have an edge, while electric pokemon are not recommended.\pThe gym leader is called Pete Longfellow, he used to be a geography teacher.\pHe has been training pokemon for a long time but he can be stubborn and emotional.\p Stay cool and calm and you should be good.\pAlso have this:"))
            waitmessage
            giveitem(ITEM_FRESH_WATER)
            waitmessage
            msgbox(format("Good luck!!"))
            waitmessage
            release
            end
    }
    if(flag(FLAG_ITEM_FRESH_WATER_GYM1) == TRUE&&flag(FLAG_BADGE01_GET)==FALSE){
        msgbox(format("Hi, welcome to the MOSA Pokemon Gym.\pThe gym leader and trainers use pokemon seen during tide shifts, whatever that means...\pGrass pokemon seem to have an edge, while electric pokemon are not recommended.\pThe gym leader is called Pete Longfellow, he used to be a geography teacher.\pHe has been training pokemon for a long time but he can be stubborn and emotional.\pStay cool and calm and you should be good."))
        waitmessage
        release
        end
    }
    if(flag(FLAG_ITEM_FRESH_WATER_GYM1) == TRUE&&flag(FLAG_BADGE01_GET)==TRUE){
        msgbox(format("Congrats on getting your badge!\pPete looked a little sour about it, but he's still down there waiting for the next challenger."))
        waitmessage
        release
        end
    }
}
script Maasje_Gym_Leader_Pete_Longfellow {
    trainerbattle_single(TRAINER_PETELONGFELLOW, Maasje_Gym_PeteLongfellow_Introtext, Maasje_Gym_PeteLongfellow_Defeattext, Maasje_Gym_PeteLongfellow_Defeated, NO_MUSIC)
    release
    end
}

script Maasje_Gym_PeteLongfellow_Defeated {
    setspeaker("PETE")
    msgbox(format("In geography we call this longshore drift, the tide always reshapes the shore in the end.\pTiming the tides takes patience, nothing else beats it.\pHere, take this:"))
    waitmessage
    call(Maasje_Gym_Set_Gym_Trainers)
    call(Common_EventScript_PlayGymBadgeFanfare)
    setflag(FLAG_BADGE01_GET)
    setflag(FLAG_DEFEATED_RUSTBORO_GYM)
    setflag(FLAG_FACULTY_SYMPATHIZERS_1)
    setspeaker(NULL)
    msgbox(format("You received the TIDE BADGE!"))
    waitmessage
    setspeaker("PETE")
    msgbox(format("That badge lets any pokemon up to level 30 obey you, no matter whose it was originally.\pAlso, you'll be able to use the move Cut outside of battle now.\pFor future battles, this might help:"))
    waitmessage
    giveitem(ITEM_TM_WATER_PULSE)
    waitmessage
    setspeaker("PETE")
    msgbox(format("That's TM Water Pulse.\pIt sends out an ultrasonic wave that may leave the foe confused.\pCome back at full moon sometime, it will make my Pokemon even stronger."), MSGBOX_AUTOCLOSE)
    playse(SE_CLICK)
    fadescreen(FADE_TO_BLACK)
    setvar(VAR_MAASJE_GYM_TIDE_STATE, 5)
    call(Maasje_Gym_Set_Tide_Metatiles)
    special(DrawWholeMapView)
    delay(60)
    playse(SE_M_SURF)
    delay(60)
    fadescreen(FADE_FROM_BLACK)
    release
    end
}

text Maasje_Gym_PeteLongfellow_Introtext {
    format("Well, well.\pYou challenged the tides and timed well.\pLet me learn you something about tidal forces and the glorious power of erosion!!")
}

text Maasje_Gym_PeteLongfellow_Defeattext {
    format("I might be getting to old for this.\pMaybe my skills have finally lost the battle against the high water.")
}

script Maasje_Gym_Set_Gym_Trainers {
    settrainerflag (TRAINER_BRAM)
    settrainerflag (TRAINER_ROB)
    settrainerflag (TRAINER_ADDY)
    settrainerflag (TRAINER_MART)
}

// ─── TIDE PILLARS ───
// 6 room states: 0 = default (on entering), 1-4 = pillar-selected tide, 5 = final (after Pete defeated)

script Maasje_Gym_Reset_Tide_State {
    if (flag(FLAG_BADGE01_GET) == TRUE) {
        setvar(VAR_MAASJE_GYM_TIDE_STATE, 5)
    }
    else {
        setvar(VAR_MAASJE_GYM_TIDE_STATE, 0)
    }
    call(Maasje_Gym_Set_Tide_Metatiles)
}

