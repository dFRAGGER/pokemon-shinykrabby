script Maasje_Gym_Pillar_SetState_1 {
    lock
    if (flag(FLAG_BADGE01_GET) == TRUE) {
        msgbox(format("The tide has settled here.\pThere's nothing left to adjust."), MSGBOX_AUTOCLOSE)
        release
        end
    }
    if (var(VAR_MAASJE_GYM_TIDE_STATE) == 1) {
        msgbox(format("The tide is already at this level."), MSGBOX_AUTOCLOSE)
        release
        end
    }
    playse(SE_CLICK)
    fadescreen(FADE_TO_BLACK)
    setvar(VAR_MAASJE_GYM_TIDE_STATE, 1)
    call(Maasje_Gym_Set_Tide_Metatiles)
    special(DrawWholeMapView)
    delay(60)
    playse(SE_M_SURF)
    delay(60)
    fadescreen(FADE_FROM_BLACK)
    release
    end
}

