mapscripts ErpusCity_StartHouse_1F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION{
        call(ErpusCity_Heal_Location)
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_STARTHOUSE_ERP_CITY_1F, 0: ErpusCity_Starthouse_1F_IntroSpeechCheck
    ]
}

script ErpusCity_Heal_Location {
    setrespawn(HEAL_LOCATION_ERP_CITY)
    end
}

script ErpusCity_Starthouse_1F_IntroSpeechCheck {
    setvar(VAR_STARTHOUSE_ERP_CITY_1F, 1)
    if(flag(FLAG_INTRO_SPEECH_MOM_FINISHED) == FALSE) {
        call(Erpuscity_Starthouse_1F_Eventscripts_MOMIntrospeech)
    }
    end
}

script Erpuscity_Starthouse_1F_WoodStatue {
    lock
    msgbox(format("It's a beautifull wooden sculpture.\nOn the bottom it says:\p'Created by SILAS, Woodworker from MIST CITY'"),MSGBOX_AUTOCLOSE)
    release
}

script Erpuscity_Starthouse_1F_LittleSister {
    lock
    setspeaker("SISTER")
    msgbox(format("MOM got me a new stuffed Pokémon!\pIt's huge isn't it?"),MSGBOX_AUTOCLOSE)
    waitmessage
    release
}

script Erpuscity_Starthouse_1F_Eventscripts_MOMIntrospeech {
    lock
    setspeaker("MOM")
    msgbox(format("Well, look who's finally awake!"), MSGBOX_AUTOCLOSE)
    waitmessage
    delay(40)
    playse(SE_PIN)
    applymovement(1, moves(emote_exclamation_mark))
    waitmovement
    applymovement(LOCALID_PLAYER, moves(walk_down*3 walk_left*3))
    setspeaker("MOM")
    msgbox(format("Do you have any idea what time it is?!\pProfessor Birds just called and was fuming over the phone...\pHe started ranting about another rejected grant, and how 'unreliable' today's youth are.\pHe even threatened to give your internship to the next kid who walks into the lab!\pYou'd better get moving.\nHe's waiting for you!"), MSGBOX_AUTOCLOSE)
    waitmessage
    playse(SE_PIN)
    applymovement(LOCALID_PLAYER,moves(emote_question_mark))
    waitmovement
    delay(120)
    setspeaker("MOM")
    msgbox(format("Don't complain...\pThis is going to be a wonderful learning experience, but only if you actually show up!\pNow GO!\nDon't keep him waiting another second!\pYour dad would be proud!"))
    applymovement(LOCALID_PLAYER,moves(walk_right))
    waitmovement
    setflag(FLAG_INTRO_SPEECH_MOM_FINISHED)
    setflag(FLAG_HIDE_INTERN_BIRDS_LAB)
    setflag(FLAG_HIDE_ROUTE03_CLIFFSIDE_WATCHER)
    release
    end
}

script Erpuscity_Starthouse_1F_Eventscripts_MOMafterspeech {
    lock
    faceplayer
    if(flag(FLAG_SYS_NATIONAL_DEX)==FALSE){
    setspeaker("MOM")
    msgbox(format("{PLAYER} I won't say it again, come on, the lab will be fun for you!"))
    waitmessage
    }
    else {
        setspeaker("MOM")
        msgbox(format("So, you are going on an adventure?\pI knew you had it in you, dad would have been proud!\pLet me know if you ever need rest!"))
        waitmessage
        setspeaker("MOM")
        msgbox(format("Do you need rest right now?"),MSGBOX_YESNO)
        waitmessage
        if(var(VAR_RESULT)==YES){
            setspeaker("MOM")
            msgbox(format("Let me take care of you."),MSGBOX_AUTOCLOSE)
            waitmessage
            fadescreen(FADE_TO_BLACK)
            playse(MUS_HEAL)
            waitse
            special(HealPlayerParty)
            delay(40)
            fadescreen(FADE_FROM_BLACK)
            setspeaker("MOM")
            msgbox(format("There you go! Good luck on your adventure!"),MSGBOX_AUTOCLOSE)
            waitmessage
            release
            end
        }
        else{
            setspeaker("MOM")
            msgbox(format("You can come back any time you want!"))
            waitmessage
            release
            end
        }

    }
    release
}
