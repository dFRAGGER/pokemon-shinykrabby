mapscripts Mistcity_Indoor_FacultySympathizer_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_MISTCITY_STATE, 1: Mistcity_Indoor_FacultySympathizer_Escape
    ]

}

script Mistcity_Indoor_FacultySympathizer_Escape {
    lock
    setvar(VAR_MISTCITY_STATE, 2)
    setspeaker("MARCUS")
    msgbox(format("... I'M TELLING YOU NOTHING, YOU STUPID TREE HUGGER!!\pNOW GET OUT OF MY WAY!"),MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(LOCALID_PLAYER, moves(walk_right face_down))
    applymovement(4, moves(walk_fast_down walk_fast_left walk_fast_down*2))
    waitmovement
    applymovement(3, moves(face_down))
    setflag(FLAG_FACULTY_SYMPATHIZERS_1)
    removeobject(4)
    delay(60)
    applymovement(3, moves(face_up))
    delay(60)
    applymovement(5,moves(walk_down*2 face_right))
    waitmovement
    applymovement(3, moves(face_left))
    applymovement(LOCALID_PLAYER, moves(face_up))
    waitmovement
    setspeaker("ELEANOR")
    msgbox(format("Mph.\pI suppose you think you are some kind of hero?\pEnjoy your precious, muddy trees.\p Progress will find a way, with or without your approval."),MSGBOX_AUTOCLOSE)
    waitmessage
    applymovement(5,moves(walk_down))
    waitmovement
    removeobject(5)
    applymovement(LOCALID_PLAYER, moves(face_down))
    applymovement(3, moves(face_down))
    waitmovement
    delay(120)
    applymovement(LOCALID_PLAYER, moves(face_up))
    waitmovement
    setspeaker("DAAN")
    msgbox(format("I think they're gone.\pRan like Rattata the second I started asking real questions about the excavation.\pThey knew exactly what The Faculty was doing to the forest.\p...\p...\pWhat? There were problems in MASO TOWN as well?\p...\pThat device...\pit looks familiar...\pI can't remember where I've seen it before though...\pBut The Faculty... this feels too big for just them.\pI can't shake this feeling about PROF. BIRDS.\pYou remember what I said in the truck?\pAbout him scanning the forest years ago?\pIt's too much of a coincidence.\nI'm going to call JACOB.\pHe's got a way of making people talk... after a few drinks... if you know what I mean.\pWe're going to pay the PROF. BIRDS a visit at his lab.\pWe need to know what he was really looking for back then.\pIf he knows anything about Registeel, we're going to get it out of him.\pWhile we sort out PROF. BIRDS, I want you to start heading west, through BATCAVE.\p...\pWhat about the Shiny Krabby?\p...\pForget that internship for a moment, {PLAYER}, this is bigger then a weird colored Krabby right now.\p...\pWhat do you mean you are scared?\pThe best adventures are those that happen when you least expect them.\pWe are a team now, {PLAYER}.\nYou and me.\pDon't you worry, after my visit to PROF. BIRDS, I'll be right behind you."),MSGBOX_AUTOCLOSE)
    waitmessage
    setspeaker("DAAN")
    msgbox(format("Here. Take this.\pI've already added my number.\pI'll call you on the Poké Gear once we've dealt with PROF. BIRDS.\pThere's more I need to tell you but I'd rather not say it all out loud in here."),MSGBOX_AUTOCLOSE)
    waitmessage
    if(flag(FLAG_SYS_POKENAV_GET)==FALSE){
        playfanfare(MUS_OBTAIN_ITEM)
        message(format("DAAN handed you the Poké Gear!\nHis number has been registered!"))
        waitfanfare
        closemessage
        setflag(FLAG_SYS_POKENAV_GET)
        setflag(FLAG_RECEIVED_POKENAV)
    }
    else{
        playfanfare(MUS_OBTAIN_ITEM)
        message(format("DAAN's number has been\nregistered in your Poké Gear!"))
        waitfanfare
        closemessage
    }
    setflag(FLAG_FACULTY_SYMPATHIZERS_2)
    clearflag(FLAG_HIDE_ROUTE03_CLIFFSIDE_WATCHER)
    setflag(FLAG_ADDED_MATCH_CALL_TO_POKENAV)
    setvar(VAR_FORTREE_CITY_STATE, 1)
    if(flag(FLAG_BADGE02_GET)==TRUE){
        setspeaker("DAAN")
        msgbox(format("Oh, you already beat DAVID?\nImpressive.\pYou're ready for BATCAVE, then.\pGood luck, {PLAYER}."),MSGBOX_AUTOCLOSE)
        waitmessage
    }
    else{
        setspeaker("DAAN")
        msgbox(format("Oh, and don't skip the gym while you're in town.\pGood luck, {PLAYER}."),MSGBOX_AUTOCLOSE)
        waitmessage
    }
    applymovement(3, moves(walk_left walk_down))
    waitmovement
    removeobject(3)
    release
}

script Mistcity_Indoor_Faculty_Husband {
    lock
    faceplayer
    if(!flag(FLAG_HELPED_DAN_BEAT_FACULTY)) {
        setspeaker("MARCUS")
        msgbox(format("Welcome to the future site of progress.\p My name is {COLOR BLUE}MARCUS{COLOR DARK_GRAY}.\p The Faculty transferred me here to oversee regional development.\p This town and forest is a chaotic mess of untapped resources.\p We're here to implement structure, to turn this town into a model of efficiency."))
        waitmessage
        release
        end 
    }
    if(flag(FLAG_HELPED_DAN_BEAT_FACULTY)) {
        setspeaker("MARCUS")
        msgbox(format("You.\pSo you're the hooligan who interfered with our work.\p You've accomplished nothing but delaying the inevitable.\p This region needs order, not sentimental rabble-rousers."))
        waitmessage
        release
        end 
    }
}

script Mistcity_Indoor_Faculty_Wife {
    lock
    faceplayer
    if(!flag(FLAG_HELPED_DAN_BEAT_FACULTY)) {
        setspeaker("ELEANOR")
        msgbox(format("Oh, hello.\pA new face?\p I'm {COLOR BLUE}ELEANOR{COLOR DARK_GRAY}.\p Mist City has a certain... rustic charm, I suppose.\p But it's so dreadfully unproductive.\p Don't you worry, The Faculty will bring modern amenities and a real sense of purpose to this place.\p That Daan fellow chaining himself to a tree? Utterly backwards.\pYou can't stop the future."))
        waitmessage
        release
        end 
    }
    if(flag(FLAG_HELPED_DAN_BEAT_FACULTY)) {
        setspeaker("ELEANOR")
        msgbox(format("Mph.\pI suppose you think you're some kind of hero.\pEnjoy your precious, muddy trees.\p Progress will find a way, with or without your approval."))
        waitmessage
        release
        end 
    }
}