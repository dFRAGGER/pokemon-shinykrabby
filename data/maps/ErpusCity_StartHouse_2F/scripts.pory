mapscripts ErpusCity_StartHouse_2F_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_STARTHOUSE_ERP_CITY, 0: ErpCity_Starthouse1F_Mom_Calling
    ]
}

script ErpCity_Starthouse1F_Mom_Calling {
    lock
    setvar(VAR_STARTHOUSE_ERP_CITY,1)
    playse(SE_PIN)
    applymovement(LOCALID_PLAYER,moves(emote_exclamation_mark))
    waitmovement
    msgbox(format("{COLOR RED}Mom: {COLOR DARK_GRAY}HONEY!!\pWAKE UP!!\pI NEED YOU DOWNSTAIRS!!"))
    waitmessage
    release
    end
      
}

script ErpCity_Starthouse1F_Mom_Clock {
    if(!flag(FLAG_SET_WALL_CLOCK)){
        lock
        msgbox(format("{COLOR RED}Mom: {COLOR DARK_GRAY}OH, AND DON'T FORGET YOUR CLOCK!\pI JUST PUT NEW BATTERIES IN THEM!"))
        waitmessage
        applymovement(LOCALID_PLAYER, moves(walk_left))
        waitmovement
        release
        end
    }
    else{
        end
    }
}